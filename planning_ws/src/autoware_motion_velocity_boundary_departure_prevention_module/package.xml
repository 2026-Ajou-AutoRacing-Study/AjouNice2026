<?xml version='1.0' encoding='utf-8'?>
<package format="2">
  <name>autoware_motion_velocity_boundary_departure_prevention_module</name>
  <version>0.51.0</version>
  <description>boundary departure prevention feature in motion_velocity_planner</description>

