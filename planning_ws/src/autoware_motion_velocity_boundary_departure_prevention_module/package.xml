  <maintainer email="alqudah.mohammad@tier4.jp">Alqudah Mohammad</maintainer>
  <maintainer email="kyoichi.sugahara@tier4.jp">Kyoichi Sugahara</maintainer>
  <maintainer email="Kotakkucu@gmail.com">Takumi Odashima</maintainer>
  <maintainer email="maxime.clement@tier4.jp">Maxime Clement</maintainer>

  <license>Apache License 2.0</license>

  <buildtool_depend>catkin</buildtool_depend>
  
  <depend>autoware_motion_velocity_planner</depend>
  <build_depend>autoware_adapi_v1_msgs</build_depend>
  <build_depend>autoware_control_msgs</build_depend>
  <build_depend>autoware_deprecated_boundary_departure_checker</build_depend>
  <build_depend>autoware_motion_utils</build_depend>
  <build_depend>autoware_motion_velocity_planner_common</build_depend>
  <build_depend>autoware_object_recognition_utils</build_depend>
  <build_depend>autoware_route_handler</build_depend>
  <build_depend>autoware_planning_msgs</build_depend>
  <build_depend>autoware_trajectory</build_depend>
  <build_depend>autoware_velocity_smoother</build_depend>
  <build_depend>autoware_vehicle_msgs</build_depend>
  <build_depend>diagnostic_updater</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>pluginlib</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>tf2</build_depend>
  <build_depend>visualization_msgs</build_depend>
  <exec_depend>autoware_adapi_v1_msgs</exec_depend>
  <exec_depend>autoware_control_msgs</exec_depend>
  <exec_depend>autoware_deprecated_boundary_departure_checker</exec_depend>
  <exec_depend>autoware_motion_utils</exec_depend>
  <exec_depend>autoware_motion_velocity_planner_common</exec_depend>
