<launch>
  <arg name="config_root"/>
  <arg name="vehicle_param_path"/>
  <arg name="output_trajectory" default="/planning/scenario_planning/velocity_smoother/trajectory"/>
  <include file="$(find autoware_scenario_selector)/launch/scenario_selector_ros1.launch">
    <arg name="output_scenario" value="/planning/scenario_planning/scenario"/>
    <arg name="is_parking_completed" value="/planning/scenario_planning/parking/is_completed"/>
  </include>
  <node pkg="autoware_velocity_smoother" type="velocity_smoother_node" name="velocity_smoother" required="true" output="screen">
    <rosparam command="load" file="$(arg vehicle_param_path)"/>
    <rosparam command="load" file="$(arg config_root)/scenario_planning/common/common.param.yaml"/>
    <rosparam command="load" file="$(arg config_root)/scenario_planning/common/nearest_search.param.yaml"/>
    <rosparam command="load" file="$(arg config_root)/scenario_planning/common/autoware_velocity_smoother/velocity_smoother.param.yaml"/>
    <rosparam command="load" file="$(arg config_root)/scenario_planning/common/autoware_velocity_smoother/JerkFiltered.param.yaml"/>
    <param name="algorithm_type" value="JerkFiltered"/>
    <!-- Record each filter stage so speed reductions can be attributed from the bag. -->
    <param name="publish_debug_trajs" value="true"/>
    <remap from="~input/trajectory" to="/planning/scenario_planning/scenario_selector/trajectory"/>
    <remap from="~input/acceleration" to="/localization/acceleration"/>
    <remap from="~input/operation_mode_state" to="/system/operation_mode/state"/>
    <remap from="~input/external_velocity_limit_mps" to="/planning/scenario_planning/max_velocity"/>
    <remap from="~output/current_velocity_limit_mps" to="/planning/scenario_planning/current_max_velocity"/>
    <remap from="~output/trajectory" to="$(arg output_trajectory)"/>
  </node>
</launch>
