<launch>
  <!-- Common and vehicle parameters must be ROS1 YAML supplied by the vehicle stack. -->
  <arg name="common_param_path"/>
  <arg name="vehicle_info_param_path"/>
  <arg name="output_metrics" default="false"/>
  <arg name="odometry" default="/localization/kinematic_state"/>
  <arg name="acceleration" default="/localization/acceleration"/>
  <arg name="trajectory" default="/planning/trajectory"/>
  <arg name="reference_trajectory" default="/planning/scenario_planning/lane_driving/motion_planning/path_optimizer/trajectory"/>
  <arg name="objects" default="/perception/object_recognition/objects"/>
  <arg name="modified_goal" default="/planning/scenario_planning/modified_goal"/>
  <arg name="map" default="/map/vector_map"/>
  <arg name="route" default="/planning/mission_planning/route"/>
  <arg name="turn_indicators" default="/vehicle/status/turn_indicators_status"/>
  <arg name="steering" default="/vehicle/status/steering_status"/>
  <node name="planning_evaluator" type="planning_evaluator" pkg="autoware_planning_evaluator" output="screen">
    <rosparam command="load" file="$(arg common_param_path)"/>
    <rosparam command="load" file="$(arg vehicle_info_param_path)"/>
    <rosparam command="load" file="$(env AJOUNICE_ROOT)/planning_ws/src/autoware_planning_evaluator/config/planning_evaluator.ros1.yaml"/>
    <param name="output_metrics" value="$(arg output_metrics)"/>
    <remap from="~input/odometry" to="$(arg odometry)"/>
    <remap from="~input/acceleration" to="$(arg acceleration)"/>
    <remap from="~input/trajectory" to="$(arg trajectory)"/>
    <remap from="~input/reference_trajectory" to="$(arg reference_trajectory)"/>
    <remap from="~input/objects" to="$(arg objects)"/>
    <remap from="~input/modified_goal" to="$(arg modified_goal)"/>
    <remap from="~input/vector_map" to="$(arg map)"/>
    <remap from="~input/route" to="$(arg route)"/>
    <remap from="~input/turn_indicators_status" to="$(arg turn_indicators)"/>
    <remap from="~input/steering_status" to="$(arg steering)"/>
  </node>
</launch>
