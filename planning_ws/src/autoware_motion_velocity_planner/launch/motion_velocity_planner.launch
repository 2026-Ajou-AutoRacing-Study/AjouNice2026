<launch>
  <arg name="vehicle_param_file"/>
  <arg name="nearest_search_param_path"/>
  <arg name="common_param_path" default="$(env AJOUNICE_ROOT)/planning_ws/src/autoware_velocity_smoother/config/ros1/default_common.yaml"/>
  <arg name="velocity_smoother_param_path" default="$(env AJOUNICE_ROOT)/planning_ws/src/autoware_velocity_smoother/config/ros1/default_velocity_smoother.yaml"/>
  <arg name="analytical_param_path" default="$(env AJOUNICE_ROOT)/planning_ws/src/autoware_velocity_smoother/config/ros1/Analytical.yaml"/>
  <arg name="motion_velocity_planner_param_path" default="$(env AJOUNICE_ROOT)/planning_ws/src/autoware_motion_velocity_planner/config/ros1/motion_velocity_planner.yaml"/>
  <arg name="module_param_path" default="$(env AJOUNICE_ROOT)/planning_ws/src/autoware_motion_velocity_planner/config/ros1/obstacle_stop_default.yaml"/>
  <arg name="launch_modules" default="[autoware::motion_velocity_planner::ObstacleStopModule]"/>
  <arg name="input_trajectory" default="trajectory_in"/>
  <arg name="output_trajectory" default="trajectory_out"/>
  <arg name="input_vector_map" default="/map/vector_map"/>
  <arg name="input_odometry" default="/localization/kinematic_state"/>
  <arg name="input_acceleration" default="/localization/acceleration"/>
  <arg name="input_dynamic_objects" default="/perception/object_recognition/objects"/>
  <arg name="input_no_ground_pointcloud" default="/perception/obstacle_segmentation/pointcloud"/>
  <arg name="input_traffic_signals" default="/perception/traffic_light_recognition/traffic_signals"/>
  <arg name="input_occupancy_grid" default="/perception/occupancy_grid_map/map"/>
  <node pkg="autoware_motion_velocity_planner" type="motion_velocity_planner_node" name="motion_velocity_planner" output="screen" required="true">
    <rosparam command="load" file="$(arg common_param_path)"/>
    <rosparam command="load" file="$(arg vehicle_param_file)"/>
    <rosparam command="load" file="$(arg nearest_search_param_path)"/>
    <rosparam command="load" file="$(arg velocity_smoother_param_path)"/>
    <rosparam command="load" file="$(arg analytical_param_path)"/>
    <rosparam command="load" file="$(arg motion_velocity_planner_param_path)"/>
    <rosparam command="load" file="$(arg module_param_path)"/>
    <rosparam param="launch_modules" subst_value="true">$(arg launch_modules)</rosparam>
    <remap from="~input/trajectory" to="$(arg input_trajectory)"/>
    <remap from="~input/vector_map" to="$(arg input_vector_map)"/>
    <remap from="~input/vehicle_odometry" to="$(arg input_odometry)"/>
    <remap from="~input/accel" to="$(arg input_acceleration)"/>
    <remap from="~input/dynamic_objects" to="$(arg input_dynamic_objects)"/>
    <remap from="~input/no_ground_pointcloud" to="$(arg input_no_ground_pointcloud)"/>
    <remap from="~input/traffic_signals" to="$(arg input_traffic_signals)"/>
    <remap from="~input/occupancy_grid" to="$(arg input_occupancy_grid)"/>
    <remap from="~output/trajectory" to="$(arg output_trajectory)"/>
  </node>
</launch>
