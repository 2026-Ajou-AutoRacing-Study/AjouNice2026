<launch>
  <arg name="param_path" default="$(env AJOUNICE_ROOT)/planning_ws/src/autoware_costmap_generator/config/costmap_generator.ros1.yaml"/>
  <arg name="input_objects" default="/perception/object_recognition/objects"/>
  <arg name="input_points" default="/perception/obstacle_segmentation/pointcloud"/>
  <arg name="input_map" default="/map/vector_map"/>
  <arg name="input_scenario" default="/planning/scenario_planning/scenario"/>
  <arg name="output_grid" default="/planning/scenario_planning/parking/costmap_generator/occupancy_grid"/>
  <arg name="output_grid_map" default="/planning/scenario_planning/parking/costmap_generator/grid_map"/>
  <node pkg="autoware_costmap_generator" type="costmap_generator_node" name="costmap_generator" required="true" output="screen">
    <rosparam command="load" file="$(arg param_path)"/>
    <remap from="~input/objects" to="$(arg input_objects)"/>
    <remap from="~input/points_no_ground" to="$(arg input_points)"/>
    <remap from="~input/vector_map" to="$(arg input_map)"/>
    <remap from="~input/scenario" to="$(arg input_scenario)"/>
    <remap from="~output/occupancy_grid" to="$(arg output_grid)"/>
    <remap from="~output/grid_map" to="$(arg output_grid_map)"/>
  </node>
</launch>
