<launch>
  <!-- ROS1 rendering of the frozen ROS2 launch boundary. -->
  <arg name="param_path" default="$(find autoware_surround_obstacle_checker)/config/surround_obstacle_checker.yaml"/>
  <arg name="input_objects" default="/perception/object_recognition/objects"/>
  <arg name="input_odometry" default="/localization/kinematic_state"/>
  <arg name="input_pointcloud" default="/perception/obstacle_segmentation/pointcloud"/>
  <arg name="output_velocity_limit" default="/planning/scenario_planning/max_velocity_candidates"/>
  <arg name="output_velocity_limit_clear_command" default="/planning/scenario_planning/clear_velocity_limit"/>

  <node pkg="autoware_surround_obstacle_checker" type="aw149_surround_obstacle_checker_node" name="surround_obstacle_checker" output="screen">
    <rosparam command="load" file="$(arg param_path)"/>
    <remap from="~input/pointcloud" to="$(arg input_pointcloud)"/>
    <remap from="~input/objects" to="$(arg input_objects)"/>
    <remap from="~input/odometry" to="$(arg input_odometry)"/>
    <remap from="~output/max_velocity" to="$(arg output_velocity_limit)"/>
    <remap from="~output/velocity_limit_clear_command" to="$(arg output_velocity_limit_clear_command)"/>
  </node>
</launch>
