<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autoware_behavior_path_start_planner_module</name>
  <version>0.51.0</version>
  <description>The autoware_behavior_path_start_planner_module package</description>

  <maintainer email="kyoichi.sugahara@tier4.jp">Kyoichi Sugahara</maintainer>
  <maintainer email="mamoru.sobue@tier4.jp">Mamoru Sobue</maintainer>
  <maintainer email="zulfaqar.azmi@tier4.jp">Zulfaqar Azmi</maintainer>

  <license>Apache License 2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>autoware_behavior_path_planner_common</depend>
  <depend>autoware_freespace_planning_algorithms</depend>
  <depend>autoware_motion_utils</depend>
  <depend>autoware_rtc_interface</depend>
  <depend>autoware_utils</depend>
  <depend>pluginlib</depend>
  <depend>roscpp</depend>
  <depend>autoware_lanelet2_utils</depend>
  <depend>autoware_deprecated_boundary_departure_checker</depend>
  <depend>autoware_vehicle_info_utils</depend>
  <depend>autoware_behavior_path_lane_change_module</depend>
  <depend>visualization_msgs</depend>
  <test_depend>autoware_test_utils</test_depend>
  <test_depend>autoware_behavior_path_planner</test_depend>
  <!-- rospack/pluginlib discovers plugins through runtime reverse dependencies.
       Keep the host out of build_depend to avoid the library/host build cycle. -->
  <exec_depend>autoware_behavior_path_planner</exec_depend>

  <export>
    <build_type>catkin</build_type>
    <autoware_behavior_path_planner plugin="${prefix}/plugins.xml"/>
    <autoware_behavior_path_planner_common plugin="${prefix}/plugins.xml"/>
  </export>
  <build_depend>autoware_test_utils</build_depend>
  <depend>autoware_utils_rclcpp</depend>
</package>
