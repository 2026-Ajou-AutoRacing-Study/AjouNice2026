<launch>
  <arg name="input_trajectory" default="/planning/scenario_planning/scenario_selector/trajectory"/>
  <arg name="output_trajectory" default="/planning/trajectory"/>
  <arg name="nearest_search_param_path"/>
  <arg name="vehicle_info_param_path"/>
  <arg name="publish_debug_trajs" default="false"/>
  <arg name="algorithm_type" default="JerkFiltered"/>

  <node pkg="autoware_velocity_smoother" type="velocity_smoother_node"
        name="velocity_smoother" output="screen">
    <rosparam command="load" file="$(env AJOUNICE_ROOT)/planning_ws/src/autoware_velocity_smoother/config/ros1/default_common.yaml"/>
    <rosparam command="load" file="$(env AJOUNICE_ROOT)/planning_ws/src/autoware_velocity_smoother/config/ros1/default_velocity_smoother.yaml"/>
    <rosparam command="load" file="$(env AJOUNICE_ROOT)/planning_ws/src/autoware_velocity_smoother/config/ros1/$(arg algorithm_type).yaml"/>
    <rosparam command="load" file="$(arg nearest_search_param_path)"/>
    <rosparam command="load" file="$(arg vehicle_info_param_path)"/>
    <param name="publish_debug_trajs" value="$(arg publish_debug_trajs)"/>
    <param name="algorithm_type" value="$(arg algorithm_type)"/>
    <!-- The ROS1 compatibility layer creates these through a private NodeHandle.
         Keep the private marker so ROS remapping is applied after that resolution. -->
    <remap from="~input/trajectory" to="$(arg input_trajectory)"/>
    <remap from="~output/trajectory" to="$(arg output_trajectory)"/>
    <remap from="~input/external_velocity_limit_mps" to="/planning/scenario_planning/max_velocity"/>
    <remap from="~input/acceleration" to="/localization/acceleration"/>
    <remap from="~input/operation_mode_state" to="/system/operation_mode/state"/>
    <remap from="~output/current_velocity_limit_mps" to="/planning/scenario_planning/current_max_velocity"/>
  </node>
</launch>
