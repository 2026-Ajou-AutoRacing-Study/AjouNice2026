<launch>
  <!-- Full original node/manager. Supply actual vehicle/common constraints
       and an explicit module parameter + launch_modules configuration. -->
  <arg name="vehicle_param_file"/>
  <arg name="common_param_file"/>
  <arg name="module_config_file"/>
  <arg name="node_name" default="behavior_path_planner"/>
  <node pkg="autoware_behavior_path_planner" type="behavior_path_planner_full_node"
        name="$(arg node_name)" output="screen" required="true">
    <rosparam command="load" file="$(arg vehicle_param_file)"/>
    <rosparam command="load" file="$(arg common_param_file)"/>
    <rosparam command="load" file="$(find autoware_behavior_path_planner)/config/ros1/behavior_path_planner.yaml"/>
    <rosparam command="load" file="$(find autoware_behavior_path_planner)/config/ros1/drivable_area_expansion.yaml"/>
    <rosparam command="load" file="$(find autoware_behavior_path_planner)/config/ros1/scene_module_manager.yaml"/>
    <rosparam command="load" file="$(arg module_config_file)"/>
  </node>
</launch>
