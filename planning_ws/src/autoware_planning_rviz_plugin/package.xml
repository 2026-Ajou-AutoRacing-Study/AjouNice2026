<?xml version="1.0"?>
<package format="2">
  <name>autoware_planning_rviz_plugin</name>
  <version>0.5.0</version>
  <description>ROS1 RViz displays and checkpoint tool for Autoware planning messages.</description>
  <maintainer email="porting@example.invalid">AW149</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>autoware_internal_planning_msgs</depend><depend>autoware_planning_msgs</depend>
  <depend>autoware_utils_geometry</depend><depend>autoware_utils_math</depend>
  <depend>autoware_vehicle_info_utils</depend><depend>geometry_msgs</depend>
  <depend>pluginlib</depend><depend>roscpp</depend><depend>rviz</depend>
  <depend>rviz_2d_overlay_plugins</depend><depend>tf2_geometry_msgs</depend><depend>tf2_ros</depend>
  <build_depend>qtbase5-dev</build_depend><exec_depend>qtbase5-dev</exec_depend>
  <export><rviz plugin="${prefix}/plugins/plugin_description.xml"/></export>
</package>
