<launch>
  <arg name="node_name" default="lanelet2_map_loader"/>
  <arg name="lanelet2_map_path"/>
  <arg name="allow_unsupported_version" default="false"/>
  <arg name="center_line_resolution" default="5.0"/>
  <arg name="use_waypoints" default="true"/>
  <node pkg="autoware_map_loader" type="autoware_lanelet2_map_loader_full"
        name="$(arg node_name)" output="screen" required="true">
    <param name="lanelet2_map_path" value="$(arg lanelet2_map_path)"/>
    <param name="allow_unsupported_version" value="$(arg allow_unsupported_version)"/>
    <param name="center_line_resolution" value="$(arg center_line_resolution)" type="double"/>
    <param name="use_waypoints" value="$(arg use_waypoints)"/>
  </node>
</launch>
