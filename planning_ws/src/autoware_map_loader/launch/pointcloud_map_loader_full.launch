<launch>
  <arg name="node_name" default="pointcloud_map_loader"/>
  <arg name="param_file"/>
  <node pkg="autoware_map_loader" type="autoware_pointcloud_map_loader_full"
        name="$(arg node_name)" output="screen" required="true">
    <rosparam command="load" file="$(arg param_file)"/>
  </node>
</launch>
