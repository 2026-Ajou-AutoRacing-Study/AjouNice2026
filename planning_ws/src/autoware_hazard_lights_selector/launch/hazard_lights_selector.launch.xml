<launch>
  <arg name="hazard_lights_selector_param_path" default="$(find autoware_hazard_lights_selector)/config/hazard_lights_selector.param.yaml"/>
  <arg name="input_hazard_lights_cmd_from_path_planner" default="/planning/behavior_path_planner/hazard_lights_cmd"/>
  <arg name="input_hazard_lights_cmd_from_mrm_operator" default="/system/hazard_lights_cmd"/>
  <arg name="output_hazard_lights_cmd" default="/planning/hazard_lights_cmd"/>
  <node pkg="autoware_hazard_lights_selector" type="autoware_hazard_lights_selector_node" name="autoware_hazard_lights_selector" output="screen">
    <rosparam command="load" file="$(arg hazard_lights_selector_param_path)"/>
    <remap from="input/planning/hazard_lights_command" to="$(arg input_hazard_lights_cmd_from_path_planner)"/>
    <remap from="input/system/hazard_lights_command" to="$(arg input_hazard_lights_cmd_from_mrm_operator)"/>
    <remap from="output/hazard_lights_command" to="$(arg output_hazard_lights_cmd)"/>
  </node>
</launch>
