<launch>
  <arg name="node_name" default="planning_validator"/>
  <arg name="vehicle_param_file"/>
  <node pkg="autoware_planning_validator" type="planning_validator_full_node"
        name="$(arg node_name)" output="screen" required="true">
    <rosparam command="load" file="$(arg vehicle_param_file)"/>
    <rosparam command="load" file="$(find autoware_planning_validator)/config/ros1/planning_validator.yaml"/>
    <rosparam command="load" file="$(find autoware_planning_validator_latency_checker)/config/ros1/latency_checker.yaml"/>
    <rosparam command="load" file="$(find autoware_planning_validator_trajectory_checker)/config/ros1/trajectory_checker.yaml"/>
    <rosparam command="load" file="$(find autoware_planning_validator_intersection_collision_checker)/config/ros1/intersection_collision_checker.yaml"/>
    <rosparam command="load" file="$(find autoware_planning_validator_rear_collision_checker)/config/ros1/rear_collision_checker.yaml"/>
    <rosparam param="launch_modules">
      - autoware::planning_validator::full_source::TrajectoryChecker
      - autoware::planning_validator::full_source::LatencyChecker
      - autoware::planning_validator::full_source::IntersectionCollisionChecker
      - autoware::planning_validator::full_source::RearCollisionChecker
    </rosparam>
  </node>
</launch>
