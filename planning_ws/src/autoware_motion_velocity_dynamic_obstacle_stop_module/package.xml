<?xml version='1.0' encoding='utf-8'?>
<package format="3">
  <name>autoware_motion_velocity_dynamic_obstacle_stop_module</name>
  <version>0.51.0</version>
  <description>dynamic_obstacle_stop module to stop ego when in the immediate path of a dynamic object</description>

  <maintainer email="maxime.clement@tier4.jp">Maxime Clement</maintainer>
  <maintainer email="mamoru.sobue@tier4.jp">Mamoru Sobue</maintainer>

  <license>Apache License 2.0</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>autoware_motion_utils</depend>
  <depend>autoware_motion_velocity_planner</depend>
  <depend>autoware_motion_velocity_planner_common</depend>
  <depend>autoware_perception_msgs</depend>
  <depend>autoware_planning_msgs</depend>
  <depend>autoware_route_handler</depend>
  <depend>autoware_utils</depend>
  <depend>autoware_planning_factor_interface</depend>
  <depend>autoware_vehicle_info_utils</depend>
  <depend>geometry_msgs</depend>
  <depend>libboost-dev</depend>
  <depend>pluginlib</depend>
  <depend>roscpp</depend>
  <depend>tf2</depend>
  <depend>visualization_msgs</depend>

  <export>
    <build_type>catkin</build_type>
    <autoware_motion_velocity_planner plugin="${prefix}/plugins.xml" />
  <autoware_motion_velocity_planner_common plugin="${prefix}/plugins.xml" /></export>
  <depend>autoware_object_recognition_utils</depend>
  <depend>autoware_universe_utils</depend>
  <depend>autoware_utils_debug</depend>
  <depend>autoware_utils_rclcpp</depend>
  <depend>autoware_velocity_smoother</depend>
</package>