<launch>
  <!-- Complete the GNSS-corrected branch:
       morai_map -> camera_init -> body -> base_link, plus Planning state. -->
  <arg name="config"
       default="$(env HOME)/AjouNice2026/configs/localization/localization_manager.yaml"/>

  <rosparam command="load" file="$(arg config)" ns="localization_manager"/>

  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="tf_body_to_base_link"
        args="-1.528 0.0 -0.200 0.0 0.0 0.0 body base_link"
        output="screen"/>

  <node pkg="localization_manager"
        type="morai_gps_to_navsatfix.py"
        name="morai_gps_to_navsatfix"
        output="screen"/>

  <node pkg="localization_manager"
        type="morai_map_camera_init_broadcaster.py"
        name="morai_map_camera_init_broadcaster"
        output="screen">
    <param name="provider" value="fast_lio_gnss"/>
  </node>

  <node pkg="localization_manager"
        type="fast_lio_kinematic_state_publisher.py"
        name="fast_lio_kinematic_state_publisher"
        output="screen"/>
</launch>
