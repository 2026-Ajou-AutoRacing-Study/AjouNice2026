<launch>
  <!--
    Visualize planar GNSS+IMU localization together with the K-City Lanelet map.

    The localization bags keep base_link at z=0, while the Lanelet OSM contains
    absolute elevations around 28 m. Flatten the map and place it at the IONIQ5
    mesh ground plane. The runtime base_link remains at the rear axle center,
    so the map is shifted down by the wheel radius (0.3705 m) for visualization.
  -->

  <arg name="repo_root" default="$(env AJOUNICE_ROOT)"/>
  <arg name="fixed_frame" default="map"/>
  <arg name="lanelet_frame" default="lanelet_ground"/>
  <arg name="lanelet_z_offset" default="-0.3705"/>
  <arg name="lanelet_map_file"
       default="$(arg repo_root)/kcity_map/lanelet_map/lanelet2_map_v69.osm"/>
  <arg name="lanelet_projector_file"
       default="$(arg repo_root)/kcity_map/lanelet_map/map_projector_info_v1.yaml"/>
  <arg name="sensor_config"
       default="$(arg repo_root)/configs/sensors/Sensor.json"/>
  <arg name="start_mgeo" default="true"/>
  <!-- Keep the integrated RViz MGeo layer centerline-only by default. -->
  <arg name="show_mgeo_width_edges" default="false"/>
  <arg name="show_mgeo_details" default="false"/>
  <arg name="show_state_overlay" default="true"/>
  <arg name="show_minimap" default="true"/>
  <arg name="kinematic_state_topic" default="/localization/kinematic_state"/>
  <arg name="minimap_topic" default="/localization/minimap/image"/>
  <arg name="minimap_width" default="480"/>
  <arg name="minimap_height" default="480"/>
  <arg name="minimap_publish_rate" default="10.0"/>
  <arg name="start_rviz" default="true"/>
  <arg name="rviz_config"
       default="$(find localization_manager)/rviz/gnss_imu_evaluation.rviz"/>

  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="tf_map_to_lanelet_ground"
        args="0 0 $(arg lanelet_z_offset) 0 0 0 $(arg fixed_frame) $(arg lanelet_frame)"
        output="screen"/>

  <!-- The compact result bag carries IMU/GPS TFs, but not LiDAR/camera TFs. -->
  <include file="$(find tf_pub)/launch/sensor_tf.launch">
    <arg name="sensor_config" value="$(arg sensor_config)"/>
    <arg name="publish_lidar" value="true"/>
    <arg name="publish_imu" value="false"/>
    <arg name="publish_camera" value="true"/>
    <arg name="publish_gps" value="false"/>
  </include>

  <include file="$(find lanelet_map_visualizer)/launch/kcity_lanelet_map.launch">
    <arg name="map_file" value="$(arg lanelet_map_file)"/>
    <arg name="projector_file" value="$(arg lanelet_projector_file)"/>
    <arg name="frame_id" value="$(arg lanelet_frame)"/>
    <arg name="flatten_z" value="true"/>
    <arg name="publish_vector_map" value="false"/>
  </include>

  <!-- Numeric speed/twist text and a horizontal velocity vector for RViz. -->
  <node if="$(arg show_state_overlay)"
        pkg="localization_manager"
        type="localization_state_rviz_marker.py"
        name="localization_state_rviz_marker"
        output="screen">
    <param name="state_topic" value="$(arg kinematic_state_topic)"/>
    <param name="output_topic" value="/localization/debug/state_markers"/>
  </node>

  <!-- North-up Lanelet overview with localization path, pose and speed. -->
  <node if="$(arg show_minimap)"
        pkg="localization_manager"
        type="localization_minimap_publisher.py"
        name="localization_minimap_publisher"
        output="screen">
    <param name="map_topic" value="/map/lanelet_map"/>
    <param name="state_topic" value="$(arg kinematic_state_topic)"/>
    <param name="output_topic" value="$(arg minimap_topic)"/>
    <param name="width" value="$(arg minimap_width)"/>
    <param name="height" value="$(arg minimap_height)"/>
    <param name="publish_rate" value="$(arg minimap_publish_rate)"/>
  </node>

  <group if="$(arg start_mgeo)">
    <include file="$(find lanelet_map_visualizer)/launch/kcity_mgeo_map.launch">
      <arg name="flatten_z" value="true"/>
      <arg name="z_offset" value="$(arg lanelet_z_offset)"/>
      <arg name="show_width_edges" value="$(arg show_mgeo_width_edges)"/>
      <arg name="show_nodes" value="$(arg show_mgeo_details)"/>
      <arg name="show_stop_nodes" value="$(arg show_mgeo_details)"/>
      <arg name="show_signal_nodes" value="$(arg show_mgeo_details)"/>
      <arg name="show_lane_changes" value="$(arg show_mgeo_details)"/>
      <arg name="show_signal_dirs" value="$(arg show_mgeo_details)"/>
      <arg name="show_origin" value="$(arg show_mgeo_details)"/>
      <arg name="show_metadata_text" value="$(arg show_mgeo_details)"/>
    </include>
  </group>

  <include file="$(find ioniq5)/launch/display_ioniq5.launch">
    <arg name="start_rviz" value="$(arg start_rviz)"/>
    <arg name="rviz_config" value="$(arg rviz_config)"/>
  </include>
</launch>
