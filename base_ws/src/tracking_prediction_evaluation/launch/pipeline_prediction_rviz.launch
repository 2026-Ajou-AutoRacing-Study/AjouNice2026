<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="start_rviz" default="true"/>
  <arg name="publish_sensor_static_tf" default="true"/>
  <arg name="repo_root" default="$(env HOME)/AjouNice2026"/>
  <arg name="map_file"
       default="$(arg repo_root)/kcity_map/lanelet_map/lanelet2_map_v60.osm"/>
  <arg name="projector_file"
       default="$(arg repo_root)/kcity_map/lanelet_map/map_projector_info_v1.yaml"/>
  <arg name="detections"
       default="/perception/object_recognition/detection/objects"/>
  <arg name="tracks"
       default="/perception/object_recognition/tracking/objects"/>
  <arg name="predictions"
       default="/perception/object_recognition/objects"/>

  <param name="/use_sim_time" value="$(arg use_sim_time)"/>

  <!-- The raw evaluation bags do not contain the Sensor_6 static TF tree. -->
  <group if="$(arg publish_sensor_static_tf)">
    <node pkg="tf2_ros" type="static_transform_publisher"
          name="pipeline_tf_base_to_lidar1"
          args="0.855 0.0 1.388 0.0 0.0 0.0 base_link lidar1"/>
    <node pkg="tf2_ros" type="static_transform_publisher"
          name="pipeline_tf_base_to_camera_front"
          args="1.90 0.0 1.20 0.0 0.0349066 0.0 base_link camera_front"/>
    <node pkg="tf2_ros" type="static_transform_publisher"
          name="pipeline_tf_base_to_camera_front_left"
          args="1.15 0.65 1.20 1.2217305 0.1745329 0.0 base_link camera_front_left"/>
    <node pkg="tf2_ros" type="static_transform_publisher"
          name="pipeline_tf_base_to_camera_front_right"
          args="1.15 -0.65 1.20 -1.2217305 0.1745329 0.0 base_link camera_front_right"/>
    <node pkg="tf2_ros" type="static_transform_publisher"
          name="pipeline_tf_base_to_camera_back"
          args="-0.28 0.0 1.15 3.1415927 0.0 0.0 base_link camera_back"/>
  </group>

  <include file="$(find bringup)/launch/localization_morai_gt.launch">
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="start_lanelet_map" value="true"/>
    <arg name="map_file" value="$(arg map_file)"/>
    <arg name="projector_file" value="$(arg projector_file)"/>
  </include>

  <include file="$(find perception_object_pipeline)/launch/object_pipeline_visualization.launch">
    <arg name="detections" value="$(arg detections)"/>
    <arg name="tracks" value="$(arg tracks)"/>
    <arg name="predictions" value="$(arg predictions)"/>
    <arg name="start_rviz" value="$(arg start_rviz)"/>
  </include>
</launch>
