<?xml version="1.0"?>
<package format="2">
  <name>tracking_prediction_evaluation</name>
  <version>0.1.0</version>
  <description>Independent MORAI oracle evaluation for tracking prediction models.</description>

  <maintainer email="team@ajounice.local">AjouNice2026</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>rospy</build_depend>
  <build_depend>rosbag</build_depend>
  <build_depend>morai_msgs</build_depend>
  <build_depend>visualization_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>rosbag</exec_depend>
  <exec_depend>morai_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>perception_object_pipeline</exec_depend>
  <exec_depend>autoware_perception_msgs</exec_depend>
  <depend>builtin_interfaces</depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>bringup</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>
</package>
