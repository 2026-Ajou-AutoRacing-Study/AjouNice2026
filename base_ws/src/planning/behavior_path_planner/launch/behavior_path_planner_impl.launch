<launch>
  <arg name="frame_id" default="map" />
  <arg name="planning_hz" default="10.0" />
  <arg name="default_velocity_mps" default="5.0" />
  <arg name="require_lane_driving_scenario" default="false" />
  <arg name="forward_path_length" default="300.0" />
  <arg name="map_file" default="" />
  <arg name="projector_file" default="" />
  <arg name="map_projector_type" default="MGRS" />
  <arg name="lane_change_enable_rtc_left" default="false" />
  <arg name="lane_change_enable_rtc_right" default="false" />
  <arg name="static_avoidance_enable_rtc_left" default="false" />
  <arg name="static_avoidance_enable_rtc_right" default="false" />
  <arg name="enable_goal_planner" default="false" />
  <arg name="enable_side_shift" default="false" />

  <node pkg="behavior_path_planner" type="behavior_path_planner.py" name="behavior_path_planner" output="screen">
    <param name="frame_id" value="$(arg frame_id)" />
    <param name="planning_hz" value="$(arg planning_hz)" />
    <param name="path_interval" value="2.0" />
    <param name="backward_path_length" value="5.0" />
    <!-- IONIQ 5 geometry; base_link is the rear-axle centre. -->
    <param name="vehicle_rear_overhang" value="0.790" />
    <param name="backward_path_margin" value="1.0" />
    <param name="forward_path_length" value="$(arg forward_path_length)" />
    <param name="ego_nearest_dist_threshold" value="3.0" />
    <param name="ego_nearest_yaw_threshold" value="1.046" />
    <param name="goal_bound_extension" value="5.0" />
    <param name="fallback_path_length" value="60.0" />
    <param name="default_velocity_mps" value="$(arg default_velocity_mps)" />
    <param name="require_lane_driving_scenario" value="$(arg require_lane_driving_scenario)" />
    <param name="stop_at_goal" value="true" />
    <param name="use_ego_as_path_start" value="true" />
    <param name="use_map_centerline" value="true" />
    <param name="map_file" value="$(arg map_file)" />
    <param name="projector_file" value="$(arg projector_file)" />
    <param name="map_projector_type" value="$(arg map_projector_type)" />

    <param name="enable_lane_change" value="true" />
    <param name="enable_static_obstacle_avoidance" value="true" />
    <param name="enable_dynamic_obstacle_avoidance" value="true" />
    <param name="enable_start_planner" value="true" />
    <param name="enable_goal_planner" value="$(arg enable_goal_planner)" />
    <param name="enable_side_shift" value="$(arg enable_side_shift)" />

    <param name="lane_change/direction" value="none" />
    <param name="lane_change/target_lateral_offset" value="0.0" />
    <param name="lane_change/lane_width" value="3.5" />
    <param name="lane_change/prepare_distance" value="3.0" />
    <param name="lane_change/lane_change_distance" value="28.0" />
    <param name="lane_change/target_forward_length" value="300.0" />
    <param name="lane_change/transition_interval" value="1.0" />
    <param name="lane_change/target_interval" value="4.0" />
    <param name="lane_change/enable_safety_check" value="true" />
    <param name="lane_change/rtc/enable_left" value="$(arg lane_change_enable_rtc_left)" />
    <param name="lane_change/rtc/enable_right" value="$(arg lane_change_enable_rtc_right)" />

    <!-- Allow avoidance into adjacent lanes only when they have the same travel direction. -->
    <param name="static_obstacle_avoidance/use_lane_type" value="same_direction_lane" />
    <!-- One diagnostic per second for each UNKNOWN object evaluated by static avoidance. -->
    <param name="static_obstacle_avoidance/debug/log_unknown_objects" value="true" />
    <param name="static_obstacle_avoidance/use_intersection_areas" value="true" />
    <param name="static_obstacle_avoidance/vehicle/width" value="1.892" />
    <param name="static_obstacle_avoidance/vehicle/base_link_to_front" value="3.845" />
    <param name="static_obstacle_avoidance/vehicle/base_link_to_rear" value="0.790" />
    <param name="static_obstacle_avoidance/target_filtering/detection_area/static" value="true" />
    <param name="static_obstacle_avoidance/target_filtering/detection_area/min_forward_distance" value="50.0" />
    <param name="static_obstacle_avoidance/target_filtering/detection_area/max_forward_distance" value="150.0" />
    <param name="static_obstacle_avoidance/target_filtering/detection_area/backward_distance" value="10.0" />
    <param name="static_obstacle_avoidance/target_filtering/max_compensation_time" value="2.0" />
    <param name="static_obstacle_avoidance/target_filtering/parked_vehicle/th_offset_from_centerline" value="1.0" />
    <param name="static_obstacle_avoidance/target_filtering/parked_vehicle/th_shiftable_ratio" value="0.8" />
    <param name="static_obstacle_avoidance/target_filtering/parked_vehicle/min_road_shoulder_width" value="0.5" />
    <param name="static_obstacle_avoidance/target_filtering/avoidance_for_ambiguous_vehicle/policy" value="manual" />
    <param name="static_obstacle_avoidance/target_filtering/avoidance_for_ambiguous_vehicle/condition/th_stopped_time" value="3.0" />
    <param name="static_obstacle_avoidance/safety_check/enable" value="true" />
    <param name="static_obstacle_avoidance/safety_check/hysteresis_factor_safe_count" value="3" />
    <param name="static_obstacle_avoidance/avoidance/lateral/soft_drivable_bound_margin" value="0.3" />
    <param name="static_obstacle_avoidance/avoidance/lateral/hard_drivable_bound_margin" value="0.3" />
    <param name="static_obstacle_avoidance/avoidance/lateral/max_right_shift_length" value="5.0" />
    <param name="static_obstacle_avoidance/avoidance/lateral/max_left_shift_length" value="5.0" />
    <param name="static_obstacle_avoidance/avoidance/lateral/th_avoid_execution" value="0.09" />
    <param name="static_obstacle_avoidance/avoidance/lateral/ratio_for_return_shift_approval" value="0.5" />
    <param name="static_obstacle_avoidance/avoidance/longitudinal/min_prepare_time" value="1.0" />
    <param name="static_obstacle_avoidance/avoidance/longitudinal/max_prepare_time" value="2.0" />
    <param name="static_obstacle_avoidance/avoidance/longitudinal/min_prepare_distance" value="1.0" />
    <param name="static_obstacle_avoidance/avoidance/longitudinal/min_slow_down_speed" value="1.38" />
    <param name="static_obstacle_avoidance/avoidance/longitudinal/nominal_return_speed" value="4.17" />
    <param name="static_obstacle_avoidance/stop/max_distance" value="20.0" />
    <param name="static_obstacle_avoidance/stop/stop_buffer" value="1.0" />
    <param name="static_obstacle_avoidance/policy/make_approval_request" value="per_shift_line" />
    <param name="static_obstacle_avoidance/policy/lateral_margin" value="best_effort" />
    <param name="static_obstacle_avoidance/policy/candidate_path_turn_signal" value="none" />
    <param name="static_obstacle_avoidance/turn_signal/on_swerving" value="true" />
    <param name="static_obstacle_avoidance/turn_signal/shift_length_threshold" value="0.3" />
    <param name="static_obstacle_avoidance/turn_signal/remaining_distance_to_bound_threshold" value="1.3" />
    <param name="static_obstacle_avoidance/target_object/car/th_moving_speed" value="1.0" />
    <param name="static_obstacle_avoidance/target_object/car/th_moving_time" value="2.0" />
    <param name="static_obstacle_avoidance/target_object/car/lateral_margin/soft_margin" value="0.3" />
    <param name="static_obstacle_avoidance/target_object/car/lateral_margin/hard_margin" value="0.2" />
    <param name="static_obstacle_avoidance/target_object/car/lateral_margin/hard_margin_for_parked_vehicle" value="0.7" />
    <rosparam param="static_obstacle_avoidance/constraints/lateral/min_jerk_values/avoid">[0.2, 0.2, 0.2]</rosparam>
    <rosparam param="static_obstacle_avoidance/constraints/lateral/min_jerk_values/return">[0.6, 0.6, 0.6]</rosparam>
    <rosparam param="static_obstacle_avoidance/constraints/lateral/max_jerk_values">[1.0, 1.0, 1.0]</rosparam>
    <param name="static_obstacle_avoidance/rtc/enable_left" value="$(arg static_avoidance_enable_rtc_left)" />
    <param name="static_obstacle_avoidance/rtc/enable_right" value="$(arg static_avoidance_enable_rtc_right)" />

    <rosparam command="load" file="$(find behavior_path_planner)/config/dynamic_obstacle_avoidance.param.yaml" param="dynamic_obstacle_avoidance" />

    <rosparam command="load" file="$(find behavior_path_planner)/config/start_planner.param.yaml" param="start_planner" />
    <rosparam command="load" file="$(find behavior_path_planner)/config/goal_planner_non_parking.param.yaml" param="goal_planner" />
    <rosparam command="load" file="$(find behavior_path_planner)/config/side_shift.param.yaml" param="side_shift" />

    <remap from="~input/route" to="/planning/mission_planning/route" />
    <remap from="~input/vector_map" to="/map/vector_map" />
    <remap from="~input/odometry" to="/localization/kinematic_state" />
    <remap from="~input/scenario" to="/planning/scenario_planning/scenario" />
    <remap from="~input/objects" to="/perception/object_recognition/objects" />
    <remap from="~input/operation_mode" to="/system/operation_mode/state" />
    <remap from="~input/lane_change_lateral_offset" to="/planning/bpp/lane_change/lateral_offset" />
    <remap from="~input/side_shift_lateral_offset" to="/planning/scenario_planning/lane_driving/behavior_planning/behavior_path_planner/input/lateral_offset" />

    <remap from="~output/path" to="/planning/scenario_planning/lane_driving/behavior_planning/path_with_lane_id" />
    <remap from="~output/lane_change_candidate_path_left" to="/planning/path_candidate/lane_change_left" />
    <remap from="~output/lane_change_reference_path_left" to="/planning/path_reference/lane_change_left" />
    <remap from="~output/lane_change_candidate_path_right" to="/planning/path_candidate/lane_change_right" />
    <remap from="~output/lane_change_reference_path_right" to="/planning/path_reference/lane_change_right" />
    <remap from="~output/static_obstacle_avoidance_candidate_path" to="/planning/path_candidate/static_obstacle_avoidance" />
    <remap from="~output/static_obstacle_avoidance_reference_path" to="/planning/path_reference/static_obstacle_avoidance" />
    <remap from="~output/start_planner_candidate_path" to="/planning/path_candidate/start_planner" />
    <remap from="~output/start_planner_reference_path" to="/planning/path_reference/start_planner" />
    <remap from="~output/goal_planner_reference_path" to="/planning/path_reference/goal_planner" />
    <remap from="~output/side_shift_candidate_path" to="/planning/path_candidate/side_shift" />
    <remap from="~output/side_shift_reference_path" to="/planning/path_reference/side_shift" />
    <remap from="~output/turn_indicators_cmd" to="/planning/turn_indicators_cmd" />
    <remap from="~output/hazard_lights_cmd" to="/planning/hazard_lights_cmd" />
    <remap from="~output/modified_goal" to="/planning/scenario_planning/modified_goal" />
    <remap from="~output/is_reroute_available" to="/planning/scenario_planning/lane_driving/behavior_planning/behavior_path_planner/output/is_reroute_available" />

    <remap from="~debug/path" to="/planning/debug/bpp/path" />
    <remap from="~debug/module_status" to="/planning/debug/bpp/module_status" />
    <remap from="~debug/lane_following_path" to="/planning/debug/bpp/lane_following_path" />
    <remap from="~debug/lane_change_path" to="/planning/debug/bpp/lane_change_path" />
    <remap from="~debug/static_obstacle_avoidance_path" to="/planning/debug/bpp/static_obstacle_avoidance_path" />
    <remap from="~debug/dynamic_obstacle_avoidance_path" to="/planning/debug/bpp/dynamic_obstacle_avoidance_path" />
    <remap from="~debug/start_planner_path" to="/planning/debug/bpp/start_planner_path" />
    <remap from="~debug/goal_planner_path" to="/planning/debug/bpp/goal_planner_path" />
    <remap from="~debug/side_shift_path" to="/planning/debug/bpp/side_shift_path" />
    <remap from="~debug/static_obstacle_avoidance" to="/planning/debug/bpp/static_obstacle_avoidance" />
    <remap from="~debug/dynamic_obstacle_avoidance" to="/planning/debug/bpp/dynamic_obstacle_avoidance" />
    <remap from="~debug/start_planner_safety" to="/planning/debug/bpp/start_planner_safety" />
  </node>
</launch>
