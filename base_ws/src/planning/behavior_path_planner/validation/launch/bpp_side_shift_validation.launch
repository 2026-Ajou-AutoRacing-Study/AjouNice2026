<launch>
  <arg name="planning_hz" default="20.0" />

  <node pkg="behavior_path_planner" type="side_shift_bpp.py"
        name="side_shift_bpp" output="screen">
    <param name="frame_id" value="map" />
    <param name="planning_hz" value="$(arg planning_hz)" />
    <rosparam command="load" file="$(find behavior_path_planner)/config/side_shift.param.yaml" param="side_shift" />
    <remap from="~input/path" to="/validation/side_shift/input_path" />
    <remap from="~input/odometry" to="/validation/side_shift/odometry" />
    <remap from="~input/lateral_offset" to="/validation/side_shift/lateral_offset" />
    <remap from="~output/path" to="/validation/side_shift/output_path" />
    <remap from="~output/reference_path" to="/validation/side_shift/reference_path" />
    <remap from="~output/candidate_path" to="/validation/side_shift/candidate_path" />
    <remap from="~output/turn_indicators_cmd" to="/validation/side_shift/turn_indicators_cmd" />
    <remap from="~debug/status" to="/validation/side_shift/status" />
  </node>
</launch>
