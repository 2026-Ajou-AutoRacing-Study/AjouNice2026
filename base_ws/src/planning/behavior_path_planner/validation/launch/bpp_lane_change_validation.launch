<launch>
  <arg name="map_file" default="/home/vic/AJOUNICE2026/local_autoware_planning_sim/data/maps/kcity_map/lanelet2_map.osm" />
  <arg name="projector_file" default="" />
  <arg name="lane_change_enable_rtc_left" default="false" />
  <arg name="lane_change_enable_rtc_right" default="false" />
  <arg name="default_velocity_mps" default="4.1666665" />
  <arg name="lane_change_distance" default="28.0" />

  <node pkg="behavior_path_planner" type="lane_following_bpp.py" name="lane_following_bpp" output="screen">
    <param name="frame_id" value="map" />
    <param name="planning_hz" value="10.0" />
    <param name="path_interval" value="2.0" />
    <param name="backward_path_length" value="5.0" />
    <param name="vehicle_rear_overhang" value="1.1" />
    <param name="backward_path_margin" value="1.0" />
    <param name="forward_path_length" value="300.0" />
    <param name="default_velocity_mps" value="$(arg default_velocity_mps)" />
    <param name="stop_at_goal" value="true" />
    <param name="use_ego_as_path_start" value="true" />
    <param name="require_lane_driving_scenario" value="true" />
    <param name="use_map_centerline" value="true" />
    <param name="map_file" value="$(arg map_file)" />
    <param name="projector_file" value="$(arg projector_file)" />
    <param name="map_projector_type" value="MGRS" />
    <remap from="~input/route" to="/planning/mission_planning/route" />
    <remap from="~input/odometry" to="/localization/kinematic_state" />
    <remap from="~input/scenario" to="/planning/scenario_planning/scenario" />
    <remap from="~output/path" to="/planning/bpp/lane_following/path" />
    <remap from="~debug/path" to="/planning/debug/bpp/lane_following_path" />
  </node>

  <node pkg="behavior_path_planner" type="lane_change_bpp.py" name="lane_change_bpp" output="screen">
    <param name="frame_id" value="map" />
    <param name="planning_hz" value="10.0" />
    <param name="route_driven" value="true" />
    <param name="map_file" value="$(arg map_file)" />
    <param name="projector_file" value="$(arg projector_file)" />
    <param name="map_projector_type" value="MGRS" />
    <param name="prepare_distance" value="3.0" />
    <param name="lane_change_distance" value="$(arg lane_change_distance)" />
    <param name="target_forward_length" value="300.0" />
    <param name="transition_interval" value="1.0" />
    <param name="target_interval" value="4.0" />
    <param name="prepare_velocity_ratio" value="0.6666666667" />
    <param name="enable_safety_check" value="true" />
    <param name="rtc/enable_left" value="$(arg lane_change_enable_rtc_left)" />
    <param name="rtc/enable_right" value="$(arg lane_change_enable_rtc_right)" />
    <remap from="~input/path" to="/planning/bpp/lane_following/path" />
    <remap from="~input/route" to="/planning/mission_planning/route" />
    <remap from="~input/odometry" to="/localization/kinematic_state" />
    <remap from="~input/objects" to="/perception/object_recognition/objects" />
    <remap from="~output/path" to="/planning/bpp/lane_change/path" />
    <remap from="~output/candidate_path_left" to="/planning/path_candidate/lane_change_left" />
    <remap from="~output/reference_path_left" to="/planning/path_reference/lane_change_left" />
    <remap from="~output/candidate_path_right" to="/planning/path_candidate/lane_change_right" />
    <remap from="~output/reference_path_right" to="/planning/path_reference/lane_change_right" />
    <remap from="~output/turn_indicators_cmd" to="/planning/bpp/lane_change/turn_indicators_cmd" />
    <remap from="~debug/path" to="/planning/debug/bpp/lane_change_path" />
  </node>
</launch>
