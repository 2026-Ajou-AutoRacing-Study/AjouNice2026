Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: [/Global Options1, /Goal Handling Comparison1]
      Splitter Ratio: 0.5
    Tree Height: 620
  - Class: rviz/Selection
    Name: Selection
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.22
      Cell Size: 10
      Class: rviz/Grid
      Color: 105; 110; 120
      Enabled: true
      Line Style: {Line Width: 0.03, Value: Lines}
      Name: Grid
      Normal Cell Count: 0
      Offset: {X: 0, Y: 0, Z: 0}
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /planning/debug/bpp/goal_planner_validation_overlay
      Name: Goal Handling Comparison
      Queue Size: 10
      Value: true
  Enabled: true
  Global Options:
    Background Color: 20; 22; 26
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz/TopDownOrtho
      Name: K-City Fixed Goal
      Scale: 2.6
      Target Frame: <Fixed Frame>
      X: 2124
      Y: 24658
    Saved: ~
Window Geometry:
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1280
  X: 80
  Y: 60
