<launch>
  <arg name="module" />
  <arg name="reference_json" />
  <arg name="candidate_json" />
  <arg name="report_json" />
  <arg name="map_file" />
  <arg name="launch_rviz" default="true" />

  <include file="$(find lanelet_map_visualizer)/launch/kcity_lanelet_map.launch">
    <arg name="map_file" value="$(arg map_file)" />
    <arg name="projector_type" value="MGRS" />
    <arg name="frame_id" value="map" />
    <arg name="output_topic" value="/validation/bvp_advanced/lanelet_map" />
    <arg name="publish_lanelet_fill" value="false" />
  </include>

  <node pkg="behavior_velocity_planner"
        type="bvp_advanced_comparison_visualizer.py"
        name="bvp_$(arg module)_comparison_visualizer"
        output="screen">
    <param name="module" value="$(arg module)" />
    <param name="reference_json" value="$(arg reference_json)" />
    <param name="candidate_json" value="$(arg candidate_json)" />
    <param name="report_json" value="$(arg report_json)" />
    <param name="map_file" value="$(arg map_file)" />
    <param name="map_projector_type" value="MGRS" />
  </node>

  <node if="$(arg launch_rviz)" pkg="rviz" type="rviz"
        name="bvp_$(arg module)_comparison_rviz"
        args="-d $(find behavior_velocity_planner)/validation/rviz/bvp_advanced_comparison.rviz"
        output="screen" />
</launch>
