<launch>
  <arg name="reference_json" default="$(env HOME)/AJOUNICE2026/local_autoware_planning_sim/bags/bvp_walkway/kcity_201266_mandatory_stop.reference.json" />
  <arg name="candidate_json" default="$(env HOME)/AJOUNICE2026/local_autoware_planning_sim/results/bvp_walkway/kcity_201266_mandatory_stop.ros1.json" />
  <arg name="report_json" default="$(env HOME)/AJOUNICE2026/local_autoware_planning_sim/results/bvp_walkway/kcity_201266_mandatory_stop.report.json" />
  <arg name="map_file" default="$(env HOME)/AJOUNICE2026/local_autoware_planning_sim/data/maps/kcity_walkway_validation_map/lanelet2_map.osm" />
  <arg name="launch_rviz" default="true" />

  <include file="$(find lanelet_map_visualizer)/launch/kcity_lanelet_map.launch">
    <arg name="map_file" value="$(arg map_file)" />
    <arg name="projector_type" value="MGRS" />
    <arg name="frame_id" value="map" />
    <arg name="output_topic" value="/validation/bvp_pedestrian_crossing/lanelet_map" />
    <arg name="publish_lanelet_fill" value="false" />
  </include>

  <node pkg="behavior_velocity_planner"
        type="bvp_pedestrian_crossing_comparison_visualizer.py"
        name="bvp_walkway_comparison_visualizer"
        output="screen">
    <param name="reference_json" value="$(arg reference_json)" />
    <param name="candidate_json" value="$(arg candidate_json)" />
    <param name="report_json" value="$(arg report_json)" />
    <param name="map_file" value="$(arg map_file)" />
    <param name="map_projector_type" value="MGRS" />
    <param name="display_offset" value="1.2" />
  </node>

  <node if="$(arg launch_rviz)" pkg="rviz" type="rviz"
        name="bvp_walkway_comparison_rviz"
        args="-d $(find behavior_velocity_planner)/validation/rviz/bvp_pedestrian_crossing_comparison.rviz"
        output="screen" />
</launch>
