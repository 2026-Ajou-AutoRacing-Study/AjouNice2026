<launch>
  <arg name="reference_json" />
  <arg name="candidate_json" />
  <arg name="map_file" default="$(env HOME)/AJOUNICE2026/local_autoware_planning_sim/data/maps/kcity_blind_spot_left_validation_map/lanelet2_map.osm" />

  <node pkg="behavior_velocity_planner" type="behavior_velocity_planner.py" name="bvp_blind_spot_validation" output="screen">
    <param name="map_file" value="$(arg map_file)" />
    <param name="map_projector_type" value="MGRS" />
    <rosparam param="launch_modules">[blind_spot]</rosparam>
    <rosparam command="load" file="$(find behavior_velocity_planner)/config/blind_spot.param.yaml" param="blind_spot" />

    <remap from="~input/path_with_lane_id" to="/validation/bvp_blind_spot/input_path" />
    <remap from="~input/vehicle_odometry" to="/validation/bvp_blind_spot/odometry" />
    <remap from="~input/dynamic_objects" to="/validation/bvp_blind_spot/dynamic_objects" />
    <remap from="~output/path" to="/validation/bvp_blind_spot/ros1_path" />
    <remap from="~output/stop_reasons" to="/validation/bvp_blind_spot/stop_reasons" />
    <remap from="~output/planning_factors" to="/validation/bvp_blind_spot/planning_factors" />
    <remap from="~debug/markers" to="/validation/bvp_blind_spot/module_markers" />
    <remap from="~debug/status" to="/validation/bvp_blind_spot/status" />
  </node>

  <node pkg="behavior_velocity_planner"
        type="replay_capture_ros1_bvp_blind_spot.py"
        name="bvp_blind_spot_reference_replay"
        args="--reference $(arg reference_json) --output $(arg candidate_json)"
        output="screen"
        required="true" />
</launch>
