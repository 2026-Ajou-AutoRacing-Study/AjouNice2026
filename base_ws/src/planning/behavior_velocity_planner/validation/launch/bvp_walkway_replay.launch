<launch>
  <arg name="map_file" default="$(env HOME)/AJOUNICE2026/local_autoware_planning_sim/data/maps/kcity_walkway_validation_map/lanelet2_map.osm" />

  <node pkg="behavior_velocity_planner" type="behavior_velocity_planner.py" name="bvp_walkway_validation" output="screen">
    <param name="map_file" value="$(arg map_file)" />
    <param name="map_projector_type" value="MGRS" />
    <rosparam param="launch_modules">[walkway]</rosparam>
    <rosparam command="load" file="$(find behavior_velocity_planner)/config/walkway.param.yaml" param="walkway" />

    <remap from="~input/path_with_lane_id" to="/validation/bvp_walkway/input_path" />
    <remap from="~input/vehicle_odometry" to="/validation/bvp_walkway/odometry" />
    <remap from="~input/dynamic_objects" to="/validation/bvp_walkway/dynamic_objects" />
    <remap from="~output/path" to="/validation/bvp_walkway/ros1_path" />
    <remap from="~output/stop_reasons" to="/validation/bvp_walkway/stop_reasons" />
    <remap from="~output/planning_factors" to="/validation/bvp_walkway/planning_factors" />
    <remap from="~debug/markers" to="/validation/bvp_walkway/module_markers" />
    <remap from="~debug/status" to="/validation/bvp_walkway/status" />
  </node>
</launch>
