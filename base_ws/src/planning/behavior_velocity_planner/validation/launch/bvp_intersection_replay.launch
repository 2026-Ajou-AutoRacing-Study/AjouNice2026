<launch>
  <arg name="map_file" default="$(env HOME)/AJOUNICE2026/local_autoware_planning_sim/data/maps/kcity_intersection_validation_map/lanelet2_map.osm" />

  <node pkg="behavior_velocity_planner" type="behavior_velocity_planner.py" name="bvp_intersection_validation" output="screen">
    <param name="map_file" value="$(arg map_file)" />
    <param name="map_projector_type" value="MGRS" />
    <rosparam param="launch_modules">[intersection]</rosparam>
    <rosparam command="load" file="$(find behavior_velocity_planner)/config/intersection.param.yaml" param="intersection" />

    <remap from="~input/path_with_lane_id" to="/validation/bvp_intersection/input_path" />
    <remap from="~input/vehicle_odometry" to="/validation/bvp_intersection/odometry" />
    <remap from="~input/dynamic_objects" to="/validation/bvp_intersection/dynamic_objects" />
    <remap from="~input/occupancy_grid" to="/validation/bvp_intersection/occupancy_grid" />
    <remap from="~output/path" to="/validation/bvp_intersection/ros1_path" />
    <remap from="~output/stop_reasons" to="/validation/bvp_intersection/stop_reasons" />
    <remap from="~output/planning_factors" to="/validation/bvp_intersection/planning_factors" />
    <remap from="~debug/markers" to="/validation/bvp_intersection/module_markers" />
    <remap from="~debug/status" to="/validation/bvp_intersection/status" />
  </node>
</launch>
