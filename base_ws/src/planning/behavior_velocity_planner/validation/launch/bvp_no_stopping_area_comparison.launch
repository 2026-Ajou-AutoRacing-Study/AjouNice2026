<launch>
  <arg name="scenario" default="stuck_vehicle" />
  <arg name="reference_json" default="$(env HOME)/AJOUNICE2026/local_autoware_planning_sim/bags/bvp_no_stopping_area/kcity_$(arg scenario).reference.json" />
  <arg name="candidate_json" default="$(env HOME)/AJOUNICE2026/local_autoware_planning_sim/results/bvp_no_stopping_area/kcity_$(arg scenario).ros1.json" />
  <arg name="report_json" default="$(env HOME)/AJOUNICE2026/local_autoware_planning_sim/results/bvp_no_stopping_area/kcity_ros1_semantic.report.json" />
  <arg name="map_file" default="$(env HOME)/AJOUNICE2026/local_autoware_planning_sim/data/maps/kcity_no_stopping_area_validation_map/lanelet2_map.osm" />
  <arg name="launch_rviz" default="true" />

  <include file="$(find lanelet_map_visualizer)/launch/kcity_lanelet_map.launch">
    <arg name="map_file" value="$(arg map_file)" />
    <arg name="projector_type" value="MGRS" />
    <arg name="frame_id" value="map" />
    <arg name="output_topic" value="/validation/bvp_restricted_area/lanelet_map" />
    <arg name="publish_lanelet_fill" value="false" />
  </include>

  <node pkg="behavior_velocity_planner"
        type="bvp_restricted_area_comparison_visualizer.py"
        name="bvp_no_stopping_area_comparison_visualizer"
        output="screen">
    <param name="module" value="no_stopping_area" />
    <param name="reference_available" value="false" />
    <param name="reference_json" value="$(arg reference_json)" />
    <param name="candidate_json" value="$(arg candidate_json)" />
    <param name="report_json" value="$(arg report_json)" />
    <param name="map_file" value="$(arg map_file)" />
    <param name="map_projector_type" value="MGRS" />
  </node>

  <node if="$(arg launch_rviz)" pkg="rviz" type="rviz"
        name="bvp_no_stopping_area_comparison_rviz"
        args="-d $(find behavior_velocity_planner)/validation/rviz/bvp_no_stopping_area_comparison.rviz"
        output="screen" />
</launch>
