<launch>
  <arg name="module" />
  <arg name="map_file" />

  <node pkg="behavior_velocity_planner" type="behavior_velocity_planner.py" name="behavior_velocity_planner" output="screen">
    <param name="map_file" value="$(arg map_file)" />
    <param name="map_projector_type" value="MGRS" />
    <rosparam subst_value="true" param="launch_modules">[$(arg module)]</rosparam>
    <rosparam command="load" file="$(find behavior_velocity_planner)/config/detection_area.param.yaml" param="detection_area" />
    <rosparam command="load" file="$(find behavior_velocity_planner)/config/merge_from_private.param.yaml" param="merge_from_private" />
    <rosparam command="load" file="$(find behavior_velocity_planner)/config/virtual_traffic_light.param.yaml" param="virtual_traffic_light" />
    <rosparam command="load" file="$(find behavior_velocity_planner)/config/occlusion_spot.param.yaml" param="occlusion_spot" />
    <rosparam command="load" file="$(find behavior_velocity_planner)/config/run_out.param.yaml" param="run_out" />

    <remap from="~input/path_with_lane_id" to="/validation/bvp_advanced/input_path" />
    <remap from="~input/vehicle_odometry" to="/validation/bvp_advanced/odometry" />
    <remap from="~input/dynamic_objects" to="/validation/bvp_advanced/dynamic_objects" />
    <remap from="~input/no_ground_pointcloud" to="/validation/bvp_advanced/pointcloud" />
    <remap from="~input/compare_map_filtered_pointcloud" to="/validation/bvp_advanced/pointcloud" />
    <remap from="~input/occupancy_grid" to="/validation/bvp_advanced/occupancy_grid" />
    <remap from="~input/virtual_traffic_light_states" to="/validation/bvp_advanced/vtl_states" />
    <remap from="~output/path" to="/validation/bvp_advanced/ros1_path" />
    <remap from="~output/planning_factors" to="/validation/bvp_advanced/planning_factors" />
    <remap from="~output/infrastructure_commands" to="/validation/bvp_advanced/infrastructure_commands" />
    <remap from="~debug/status" to="/validation/bvp_advanced/status" />
  </node>
</launch>
