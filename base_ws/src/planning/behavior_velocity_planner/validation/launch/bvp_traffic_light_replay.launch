<launch>
  <arg name="map_file" default="/home/vic/AJOUNICE2026/local_autoware_planning_sim/data/maps/kcity_map/lanelet2_map.osm" />
  <arg name="projector_file" default="" />
  <arg name="map_projector_type" default="MGRS" />
  <arg name="flatten_map_z" default="false" />
  <arg name="is_simulation" default="true" />

  <node pkg="behavior_velocity_planner" type="behavior_velocity_planner.py" name="bvp_traffic_light_validation" output="screen">
    <param name="map_file" value="$(arg map_file)" />
    <param name="projector_file" value="$(arg projector_file)" />
    <param name="map_projector_type" value="$(arg map_projector_type)" />
    <param name="flatten_map_z" value="$(arg flatten_map_z)" />
    <rosparam param="launch_modules">[traffic_light]</rosparam>
    <rosparam command="load" file="$(find behavior_velocity_planner)/config/traffic_light.param.yaml" param="traffic_light" />
    <param name="traffic_light/is_simulation" value="$(arg is_simulation)" />

    <remap from="~input/path_with_lane_id" to="/validation/bvp_traffic_light/input_path" />
    <remap from="~input/vector_map" to="/validation/bvp_traffic_light/vector_map" />
    <remap from="~input/vehicle_odometry" to="/validation/bvp_traffic_light/odometry" />
    <remap from="~input/acceleration" to="/validation/bvp_traffic_light/acceleration" />
    <remap from="~input/dynamic_objects" to="/validation/bvp_traffic_light/dynamic_objects" />
    <remap from="~input/no_ground_pointcloud" to="/validation/bvp_traffic_light/no_ground_pointcloud" />
    <remap from="~input/compare_map_filtered_pointcloud" to="/validation/bvp_traffic_light/map_filtered_pointcloud" />
    <remap from="~input/traffic_signals" to="/validation/bvp_traffic_light/traffic_signals" />

    <remap from="~output/path" to="/validation/bvp_traffic_light/ros1_path" />
    <remap from="~output/stop_reasons" to="/validation/bvp_traffic_light/stop_reasons" />
    <remap from="~output/planning_factors" to="/validation/bvp_traffic_light/planning_factors" />
    <remap from="~output/traffic_signal" to="/validation/bvp_traffic_light/selected_signal" />
    <remap from="~debug/markers" to="/validation/bvp_traffic_light/module_markers" />
    <remap from="~debug/status" to="/validation/bvp_traffic_light/status" />
  </node>
</launch>
