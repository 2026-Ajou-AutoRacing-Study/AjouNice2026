<launch>
  <arg name="map_file" default="/home/vic/AJOUNICE2026/local_autoware_planning_sim/data/maps/kcity_speed_bump_validation_map/lanelet2_map.osm" />
  <arg name="projector_file" default="" />
  <arg name="map_projector_type" default="MGRS" />
  <arg name="flatten_map_z" default="false" />

  <node pkg="behavior_velocity_planner" type="behavior_velocity_planner.py" name="bvp_speed_bump_validation" output="screen">
    <param name="map_file" value="$(arg map_file)" />
    <param name="projector_file" value="$(arg projector_file)" />
    <param name="map_projector_type" value="$(arg map_projector_type)" />
    <param name="flatten_map_z" value="$(arg flatten_map_z)" />
    <rosparam param="launch_modules">[speed_bump]</rosparam>
    <rosparam command="load" file="$(find behavior_velocity_planner)/config/speed_bump.param.yaml" param="speed_bump" />

    <remap from="~input/path_with_lane_id" to="/validation/bvp_speed_bump/input_path" />
    <remap from="~input/vector_map" to="/validation/bvp_speed_bump/vector_map" />
    <remap from="~input/vehicle_odometry" to="/validation/bvp_speed_bump/odometry" />
    <remap from="~input/dynamic_objects" to="/validation/bvp_speed_bump/dynamic_objects" />
    <remap from="~input/no_ground_pointcloud" to="/validation/bvp_speed_bump/no_ground_pointcloud" />
    <remap from="~input/compare_map_filtered_pointcloud" to="/validation/bvp_speed_bump/map_filtered_pointcloud" />
    <remap from="~input/traffic_signals" to="/validation/bvp_speed_bump/traffic_signals" />

    <remap from="~output/path" to="/validation/bvp_speed_bump/ros1_path" />
    <remap from="~output/stop_reasons" to="/validation/bvp_speed_bump/stop_reasons" />
    <remap from="~output/planning_factors" to="/validation/bvp_speed_bump/planning_factors" />
    <remap from="~debug/markers" to="/validation/bvp_speed_bump/module_markers" />
    <remap from="~debug/status" to="/validation/bvp_speed_bump/status" />
  </node>
</launch>
