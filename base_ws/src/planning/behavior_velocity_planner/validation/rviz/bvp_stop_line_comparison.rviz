Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /K-City Lanelet Map1
        - /Validation Context1
        - /ROS2 Speed Path1
        - /ROS1 Speed Path1
      Splitter Ratio: 0.5
    Tree Height: 620
  - Class: rviz/Selection
    Name: Selection
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.25
      Cell Size: 10
      Class: rviz/Grid
      Color: 120; 120; 120
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /validation/bvp_stop_line/lanelet_map
      Name: K-City Lanelet Map
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /validation/bvp_stop_line/context
      Name: Validation Context
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /validation/bvp_stop_line/ros2_speed_path
      Name: ROS2 Speed Path
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /validation/bvp_stop_line/ros1_speed_path
      Name: ROS1 Speed Path
      Queue Size: 10
      Value: true
  Enabled: true
  Global Options:
    Background Color: 22; 24; 28
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz/TopDownOrtho
      Name: K-City Stop Line 103498
      Scale: 7
      Target Frame: <Fixed Frame>
      X: 2510
      Y: 24665
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1280
  X: 80
  Y: 60
