Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Mission Route Overlay1
      Splitter Ratio: 0.5
    Tree Height: 620
  - Class: rviz/Selection
    Name: Selection
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 10
      Class: rviz/Grid
      Color: 120; 120; 120
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /planning/mission_planning/validation/route_overlay
      Name: Mission Route Overlay
      Namespaces:
        comparison_summary: true
        map_boundaries: true
        matching_route_lanelets: true
        ros1_candidate: true
        ros1_only_lanelets: true
        ros1_pose: true
        ros2_only_lanelets: true
        ros2_pose: true
        ros2_reference: true
        section_labels: true
      Queue Size: 10
      Value: true
  Enabled: true
  Global Options:
    Background Color: 22; 24; 28
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz/TopDownOrtho
      Name: K-City Route
      Scale: 5
      Target Frame: <Fixed Frame>
      X: 2592
      Y: 23905
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 000000ff00000000fd0000000100000000000001840000032cfc0200000001fb000000100044006900730070006c006100790073010000003d0000032c000000c900ffffff000004b00000032c00000004000000040000000800000008fc00000000
  Selection:
    collapsed: false
  Width: 1280
  X: 80
  Y: 60
