<launch>
  <arg name="map_file" />
  <arg name="reference_json" />
  <arg name="candidate_json" />
  <arg name="report_json" default="" />
  <arg name="projector_file" default="" />
  <arg name="map_projector_type" default="MGRS" />
  <arg name="frame_id" default="map" />
  <arg name="output_topic" default="/planning/mission_planning/validation/route_overlay" />
  <arg name="launch_rviz" default="true" />

  <node pkg="mission_planner"
        type="mission_route_comparison_visualizer.py"
        name="mission_route_comparison_visualizer"
        output="screen">
    <param name="map_file" value="$(arg map_file)" />
    <param name="reference_json" value="$(arg reference_json)" />
    <param name="candidate_json" value="$(arg candidate_json)" />
    <param name="report_json" value="$(arg report_json)" />
    <param name="projector_file" value="$(arg projector_file)" />
    <param name="map_projector_type" value="$(arg map_projector_type)" />
    <param name="frame_id" value="$(arg frame_id)" />
    <param name="output_topic" value="$(arg output_topic)" />
  </node>

  <node if="$(arg launch_rviz)"
        pkg="rviz"
        type="rviz"
        name="mission_route_comparison_rviz"
        args="-d $(find mission_planner)/rviz/mission_route_comparison.rviz"
        output="screen" />
</launch>
