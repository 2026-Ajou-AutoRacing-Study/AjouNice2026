<launch>
  <arg name="frame_id" default="map" />
  <arg name="publish_rate" default="5.0" />
  <arg name="route_lane_ids" default="[]" />
  <arg name="map_file" default="" />
  <arg name="projector_file" default="" />
  <arg name="map_projector_type" default="MGRS" />
  <arg name="goal_angle_threshold_deg" default="45.0" />
  <arg name="enable_correct_goal_pose" default="false" />
  <arg name="consider_no_drivable_lanes" default="false" />
  <arg name="check_footprint_inside_lanes" default="true" />
  <arg name="allow_reroute_in_autonomous_mode" default="true" />
  <arg name="reroute_time_threshold" default="10.0" />
  <arg name="minimum_reroute_length" default="30.0" />
  <arg name="arrival_check_angle_deg" default="45.0" />
  <arg name="arrival_check_distance" default="1.0" />
  <arg name="arrival_check_duration" default="1.0" />
  <arg name="auto_publish_initial_route" default="false" />
  <arg name="default_start_x" default="0.0" />
  <arg name="default_start_y" default="0.0" />
  <arg name="default_start_yaw" default="0.0" />
  <arg name="default_goal_x" default="60.0" />
  <arg name="default_goal_y" default="0.0" />
  <arg name="default_goal_yaw" default="0.0" />

  <node pkg="mission_planner" type="mission_planner.py" name="mission_planner" output="screen">
    <param name="map_frame" value="$(arg frame_id)" />
    <param name="publish_rate" value="$(arg publish_rate)" />
    <rosparam param="route_lane_ids" subst_value="true">$(arg route_lane_ids)</rosparam>
    <param name="map_file" value="$(arg map_file)" />
    <param name="projector_file" value="$(arg projector_file)" />
    <param name="map_projector_type" value="$(arg map_projector_type)" />
    <param name="goal_angle_threshold_deg" value="$(arg goal_angle_threshold_deg)" />
    <param name="enable_correct_goal_pose" value="$(arg enable_correct_goal_pose)" />
    <param name="consider_no_drivable_lanes" value="$(arg consider_no_drivable_lanes)" />
    <param name="check_footprint_inside_lanes" value="$(arg check_footprint_inside_lanes)" />
    <param name="allow_reroute_in_autonomous_mode" value="$(arg allow_reroute_in_autonomous_mode)" />
    <param name="reroute_time_threshold" value="$(arg reroute_time_threshold)" />
    <param name="minimum_reroute_length" value="$(arg minimum_reroute_length)" />
    <param name="arrival_check_angle_deg" value="$(arg arrival_check_angle_deg)" />
    <param name="arrival_check_distance" value="$(arg arrival_check_distance)" />
    <param name="arrival_check_duration" value="$(arg arrival_check_duration)" />
    <param name="auto_publish_initial_route" value="$(arg auto_publish_initial_route)" />
    <param name="default_start_x" value="$(arg default_start_x)" />
    <param name="default_start_y" value="$(arg default_start_y)" />
    <param name="default_start_yaw" value="$(arg default_start_yaw)" />
    <param name="default_goal_x" value="$(arg default_goal_x)" />
    <param name="default_goal_y" value="$(arg default_goal_y)" />
    <param name="default_goal_yaw" value="$(arg default_goal_yaw)" />

    <remap from="~input/odometry" to="/localization/kinematic_state" />
    <remap from="~input/operation_mode_state" to="/system/operation_mode/state" />
    <remap from="~input/vector_map" to="/map/vector_map" />
    <remap from="~input/modified_goal" to="/planning/scenario_planning/modified_goal" />
    <remap from="~route" to="/planning/mission_planning/route" />
    <remap from="~state" to="/planning/mission_planning/state" />
    <remap from="~clear_route" to="/planning/mission_planning/mission_planner/clear_route" />
    <remap from="~set_lanelet_route" to="/planning/mission_planning/mission_planner/set_lanelet_route" />
    <remap from="~set_waypoint_route" to="/planning/mission_planning/mission_planner/set_waypoint_route" />
    <remap from="~debug/route_marker" to="/planning/mission_planning/mission_planner/debug/route_marker" />
    <remap from="~debug/goal_pose" to="/planning/mission_planning/mission_planner/debug/goal_pose" />
    <remap from="~debug/processing_time_ms" to="/planning/mission_planning/mission_planner/debug/processing_time_ms" />
  </node>
</launch>
