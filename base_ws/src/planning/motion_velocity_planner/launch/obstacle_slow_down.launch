<launch>
  <node pkg="motion_velocity_planner" type="obstacle_slow_down.py" name="obstacle_slow_down" output="screen">
    <param name="slowdown_distance" value="15.0" />
    <param name="stop_distance" value="3.0" />
    <param name="min_velocity_mps" value="1.0" />
    <param name="cruise_velocity_mps" value="5.0" />
  </node>
</launch>
