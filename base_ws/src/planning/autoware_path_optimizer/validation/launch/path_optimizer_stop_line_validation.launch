<launch>
  <arg name="reference_json" default="$(env HOME)/AJOUNICE2026/local_autoware_planning_sim/bags/path_optimizer/kcity_stop_line_103624.reference.json" />
  <arg name="candidate_json" default="$(env HOME)/AJOUNICE2026/local_autoware_planning_sim/results/path_optimizer/kcity_stop_line_103624.ros1.json" />
  <arg name="report_json" default="$(env HOME)/AJOUNICE2026/local_autoware_planning_sim/results/path_optimizer/kcity_stop_line_103624.report.json" />
  <arg name="map_file" default="$(env HOME)/AJOUNICE2026/lanelet2_map_v44.osm" />
  <arg name="launch_rviz" default="true" />
  <arg name="launch_map" default="true" />
  <arg name="launch_visualizer" default="true" />
  <arg name="shutdown_on_result" default="false" />

  <include file="$(find autoware_path_optimizer)/validation/launch/path_optimizer_validation.launch">
    <arg name="reference_json" value="$(arg reference_json)" />
    <arg name="candidate_json" value="$(arg candidate_json)" />
    <arg name="report_json" value="$(arg report_json)" />
    <arg name="map_file" value="$(arg map_file)" />
    <arg name="rviz_config" value="$(find autoware_path_optimizer)/validation/rviz/path_optimizer_stop_line_comparison.rviz" />
    <arg name="launch_rviz" value="$(arg launch_rviz)" />
    <arg name="launch_map" value="$(arg launch_map)" />
    <arg name="launch_visualizer" value="$(arg launch_visualizer)" />
    <arg name="shutdown_on_result" value="$(arg shutdown_on_result)" />
  </include>
</launch>
