<?xml version="1.0"?>
<package format="2">
  <name>autoware_path_optimizer</name>
  <version>0.1.0</version>
  <description>ROS 1 MVP port of Autoware's model predictive path optimizer.</description>

  <maintainer email="heejoong-0922@users.noreply.github.com">AjouNice2026</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>autoware_internal_debug_msgs</depend>
  <depend>autoware_perception_msgs</depend>
  <depend>autoware_planning_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>lanelet_map_visualizer</exec_depend>
  <exec_depend>rviz</exec_depend>

  <test_depend>python3-nose</test_depend>
</package>
