<launch>
  <arg name="input_path_topic" default="/planning/scenario_planning/lane_driving/motion_planning/path_smoother/path" />
  <arg name="output_trajectory_topic" default="/planning/scenario_planning/lane_driving/motion_planning/path_optimizer/trajectory" />
  <arg name="odometry_topic" default="/localization/kinematic_state" />
  <arg name="objects_topic" default="/perception/object_recognition/objects" />
  <arg name="enable_debug_info" default="false" />
  <arg name="param_path" default="$(find autoware_path_optimizer)/config/path_optimizer.param.yaml" />

  <node pkg="autoware_path_optimizer"
        type="path_optimizer.py"
        name="path_optimizer"
        output="screen">
    <rosparam command="load" file="$(arg param_path)" />
    <param name="debug/enable_debug_info" value="$(arg enable_debug_info)" />
    <remap from="~input/path" to="$(arg input_path_topic)" />
    <remap from="~input/odometry" to="$(arg odometry_topic)" />
    <remap from="~input/objects" to="$(arg objects_topic)" />
    <remap from="~output/path" to="$(arg output_trajectory_topic)" />
  </node>
</launch>
