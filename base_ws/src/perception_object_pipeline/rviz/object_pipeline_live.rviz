Panels:
  - Class: rviz/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Standard Object Pipeline1
      Splitter Ratio: 0.5199999809265137
    Tree Height: 295
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.44999998807907104
      Cell Size: 1
      Class: rviz/Grid
      Color: 120; 120; 120
      Enabled: false
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: false
    - Alpha: 0.800000011920929
      Class: rviz/RobotModel
      Collision Enabled: true
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
        base_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
      Name: Ego Vehicle
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 255; 255; 255
      Color Transformer: Intensity
      Decay Time: 0.20000000298023224
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: LiDAR
      Position Transformer: XYZ
      Queue Size: 3
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.03999999910593033
      Style: Flat Squares
      Topic: /sensor/lidar1
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /map/lanelet_map
      Name: Lanelet Map
      Namespaces:
        features/lane_markings: true
        features/road_borders: true
        features/stop_lines: true
        features/traffic_lights: true
        lanelet/centerlines: true
        lanelet/left_boundaries: true
        lanelet/right_boundaries: true
      Queue Size: 5
      Value: true
    - Class: rviz/Group
      Displays:
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /perception/object_recognition/visualization/detections
          Name: Detections (green)
          Namespaces:
            detected_boxes: true
          Queue Size: 5
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /perception/object_recognition/visualization/tracks
          Name: Tracks (class color)
          Namespaces:
            tracked_boxes: true
            tracked_labels: true
          Queue Size: 5
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /perception/object_recognition/visualization/predictions
          Name: Predictions (0-3s)
          Namespaces:
            predicted_horizon_1_sec: true
            predicted_horizon_2_sec: true
            predicted_horizon_3_sec: true
            predicted_paths: true
          Queue Size: 5
          Value: true
      Enabled: true
      Name: Standard Object Pipeline
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /evaluation/visualization/gt_boxes
      Name: MORAI GT BBoxes (magenta)
      Namespaces:
        morai_gt_boxes: true
      Queue Size: 5
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /evaluation/visualization/gt_paths
      Name: Matched GT Future Paths (purple)
      Namespaces:
        matched_gt_future_paths: true
        matched_gt_horizons: true
      Queue Size: 5
      Value: true
    - Class: rviz/TF
      Enabled: true
      Filter (blacklist): ""
      Filter (whitelist): ""
      Frame Timeout: 15
      Frames:
        All Enabled: true
        base_link:
          Value: true
        camera_back:
          Value: true
        camera_front:
          Value: true
        camera_front_left:
          Value: true
        camera_front_right:
          Value: true
        gps:
          Value: true
        imu:
          Value: true
        lidar1:
          Value: true
        map:
          Value: true
        morai_map:
          Value: true
      Marker Alpha: 0.699999988079071
      Marker Scale: 0.699999988079071
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        map:
          morai_map:
            base_link:
              camera_back:
                {}
              camera_front:
                {}
              camera_front_left:
                {}
              camera_front_right:
                {}
              gps:
                {}
              imu:
                {}
              lidar1:
                {}
      Update Interval: 0
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /sensor/camera/front
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Front Camera
      Normalize Range: true
      Queue Size: 2
      Transport Hint: compressed
      Unreliable: false
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /sensor/camera/front_left
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Front Left Camera
      Normalize Range: true
      Queue Size: 2
      Transport Hint: compressed
      Unreliable: false
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /sensor/camera/front_right
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Front Right Camera
      Normalize Range: true
      Queue Size: 2
      Transport Hint: compressed
      Unreliable: false
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /sensor/camera/back
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Rear Camera
      Normalize Range: true
      Queue Size: 2
      Transport Hint: compressed
      Unreliable: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Theta std deviation: 0.26179900765419006
      Topic: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/ThirdPersonFollower
      Distance: 10.100000381469727
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.7853981852531433
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: false
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.5053983926773071
      Target Frame: base_link
      Yaw: 3.0453999042510986
    Saved:
      - Angle: 0
        Class: rviz/TopDownOrtho
        Enable Stereo Rendering:
          Stereo Eye Separation: 0.05999999865889549
          Stereo Focal Distance: 1
          Swap Stereo Eyes: false
          Value: false
        Invert Z Axis: false
        Name: Top Down
        Near Clip Distance: 0.009999999776482582
        Scale: 20
        Target Frame: base_link
        X: 0
        Y: 0
Window Geometry:
  Displays:
    collapsed: false
  Front Camera:
    collapsed: false
  Front Left Camera:
    collapsed: false
  Front Right Camera:
    collapsed: false
  Height: 752
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Rear Camera:
    collapsed: false
  Views:
    collapsed: false
  Width: 1021
  X: 274
  Y: 277
