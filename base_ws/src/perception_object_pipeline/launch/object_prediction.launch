<launch>
  <arg name="input_objects"
       default="/perception/object_recognition/tracking/objects"/>
  <arg name="output_objects"
       default="/perception/object_recognition/objects"/>
  <arg name="prediction_time_step" default="0.1"/>
  <!-- Empty overrides inherit config/map_based_prediction.yaml. -->
  <arg name="prediction_horizon" default=""/>
  <arg name="prediction_mixed_horizon_enabled" default="false"/>
  <arg name="prediction_highway_horizon" default=""/>
  <arg name="prediction_highway_mode" default=""/>
  <arg name="repo_root" default="$(env AJOUNICE_ROOT)"/>
  <arg name="map_version" default="97"/>
  <arg name="vehicle_only_corridor_enabled" default="false"/>
  <arg name="vehicle_only_corridor_route_file"
       default="$(arg repo_root)/base_ws/src/planning_addons/competition_route_requester/config/kcity_v$(arg map_version)_competition_route.yaml"/>
  <arg name="prediction_model" default="ctrv"/>
  <arg name="publish_processing_diagnostics" default="false"/>
  <arg name="diagnostics_auto_on_subscribe" default="true"/>
  <arg name="map_file"
       default="$(arg repo_root)/kcity_map/lanelet_map/lanelet2_map_v$(arg map_version).osm"/>
  <arg name="projector_file"
       default="$(arg repo_root)/kcity_map/lanelet_map/map_projector_info_v1.yaml"/>

  <group if="$(eval arg('prediction_model') == 'ctrv')">
    <node pkg="perception_object_pipeline"
          type="object_prediction_node.py"
          name="object_prediction"
          output="screen"
          respawn="false">
      <remap from="~input/objects" to="$(arg input_objects)"/>
      <remap from="~output/objects" to="$(arg output_objects)"/>
      <param name="prediction_time_step" value="$(arg prediction_time_step)"/>
      <rosparam command="load" file="$(env AJOUNICE_ROOT)/base_ws/src/perception_object_pipeline/config/map_based_prediction.yaml"/>
      <param if="$(eval arg('prediction_horizon') != '')" name="prediction_horizon" value="$(arg prediction_horizon)"/>
    </node>
  </group>

  <group if="$(eval arg('prediction_model') == 'map_based')">
    <node pkg="perception_object_pipeline"
          type="map_based_prediction_node.py"
          name="map_based_prediction"
          output="screen"
          respawn="false">
      <param name="publish_processing_diagnostics"
             value="$(arg publish_processing_diagnostics)"/>
      <param name="diagnostics_auto_on_subscribe"
             value="$(arg diagnostics_auto_on_subscribe)"/>
      <remap from="~input/objects" to="$(arg input_objects)"/>
      <remap from="~output/objects" to="$(arg output_objects)"/>
      <remap from="~input/ego_odometry" to="/localization/kinematic_state"/>
      <rosparam command="load"
                file="$(env AJOUNICE_ROOT)/base_ws/src/perception_object_pipeline/config/map_based_prediction.yaml"/>
      <param name="prediction_time_step" value="$(arg prediction_time_step)"/>
      <param if="$(eval arg('prediction_horizon') != '')" name="prediction_horizon" value="$(arg prediction_horizon)"/>
      <param name="map_file" value="$(arg map_file)"/>
      <param name="mixed_horizon_enabled" value="$(arg prediction_mixed_horizon_enabled)"/>
      <param if="$(eval arg('prediction_highway_horizon') != '')" name="highway_prediction_horizon" value="$(arg prediction_highway_horizon)"/>
      <param if="$(eval arg('prediction_highway_mode') != '')" name="highway_prediction_mode" value="$(arg prediction_highway_mode)"/>
      <param name="projector_file" value="$(arg projector_file)"/>
      <param name="vehicle_only_corridor_enabled" value="$(arg vehicle_only_corridor_enabled)"/>
      <param name="vehicle_only_corridor_route_file" value="$(arg vehicle_only_corridor_route_file)"/>
    </node>
  </group>
</launch>
