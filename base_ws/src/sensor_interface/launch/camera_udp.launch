<launch>
  <!-- Receive MORAI camera UDP JPEG packets and republish as CompressedImage. -->
  <arg name="camera_config" default="$(find sensor_interface)/config/camera_udp.yaml"/>
  <arg name="camera_name" default="front"/>

  <node pkg="sensor_interface"
        type="morai_camera_udp_receiver.py"
        name="morai_camera_udp_receiver"
        output="screen">
    <param name="camera_config" value="$(arg camera_config)"/>
    <param name="camera_name" value="$(arg camera_name)"/>
  </node>
</launch>
