<launch>
  <!-- Single VLP-16 deskew path for Sensor_3.json. -->
  <arg name="config" default="$(find sensor_interface)/config/lidar_preprocess.yaml"/>
  <arg name="enable_lidar_preprocess" default="true"/>

  <node if="$(arg enable_lidar_preprocess)" pkg="sensor_interface"
        type="lidar_distortion_corrector" name="lidar1_distortion_corrector"
        output="screen">
    <rosparam command="load" file="$(arg config)"/>
    <param name="cloud_topic" value="/sensor/lidar1"/>
    <param name="output_topic" value="/sensor/lidar1/deskewed"/>
  </node>
</launch>
