<launch>
  <!-- External MORAI UDP <-> internal ROS topic gateway. -->
  <arg name="repo_root" default="$(env AJOUNICE_ROOT)"/>
  <arg name="sensor_config"
       default="$(arg repo_root)/configs/sensors/Sensor.json"/>
  <arg name="network_config"
       default="$(arg repo_root)/configs/network/ego_network_1.json"/>
  <arg name="vehicle_config"
       default="$(arg repo_root)/configs/vehicle/ioniq5.yaml"/>
  <arg name="enable_sensors" default="true"/>
  <arg name="enable_lidar" default="true"/>
  <arg name="enable_ego_network" default="true"/>
  <arg name="enable_ego_vehicle_status" default="true"/>
  <arg name="enable_control" default="true"/>
  <arg name="lidar_port" default="2368"/>
  <arg name="lidar_frame" default="lidar1"/>
  <!-- LiDAR output: 900 RPM = 15 Hz. -->
  <arg name="lidar_rpm" default="900.0"/>
  <arg name="lidar_timestamp_first_packet" default="true"/>
  <arg name="lidar_calibration"
       default="$(find velodyne_pointcloud)/params/VLP16db.yaml"/>

  <node if="$(arg enable_sensors)" pkg="sensor_interface"
        type="morai_sensor_udp_receiver" name="morai_sensor_udp_receiver"
        output="screen" required="true">
    <param name="sensor_config" value="$(arg sensor_config)"/>
  </node>

  <group if="$(arg enable_lidar)">
    <include file="$(find sensor_interface)/launch/lidar.launch">
      <arg name="port" value="$(arg lidar_port)"/>
      <arg name="frame_id" value="$(arg lidar_frame)"/>
      <arg name="rpm" value="$(arg lidar_rpm)"/>
      <arg name="timestamp_first_packet" value="$(arg lidar_timestamp_first_packet)"/>
      <arg name="calibration" value="$(arg lidar_calibration)"/>
    </include>
  </group>

  <node if="$(arg enable_ego_network)" pkg="sensor_interface"
        type="morai_ego_udp_receiver" name="morai_ego_udp_receiver"
        output="screen" required="true">
    <param name="network_config" value="$(arg network_config)"/>
    <param name="enable_ego_vehicle_status" value="$(arg enable_ego_vehicle_status)"/>
    <!-- MORAI Ego packet position/yaw are local-map coordinates, not Lanelet map. -->
    <param name="frame_id" value="morai_map"/>
  </node>

  <node if="$(arg enable_control)" pkg="sensor_interface"
        type="morai_ctrl_cmd_udp_sender" name="morai_ctrl_cmd_udp_sender"
        output="screen" required="true">
    <param name="network_config" value="$(arg network_config)"/>
    <param name="ctrl_mode" value="2"/>
    <param name="gear" value="4"/>
    <!-- /ctrl_cmd steering is a physical wheel angle [rad]; MORAI UDP steer is normalized. -->
    <rosparam command="load" file="$(arg vehicle_config)"/>
  </node>
</launch>
