<launch>
  <!-- MORAI VLP-16 UDP. Competition default: 900 RPM = 15 Hz. -->
  <arg name="port" default="2368"/>
  <arg name="frame_id" default="lidar1"/>
  <arg name="rpm" default="900.0"/>
  <arg name="timestamp_first_packet" default="true"/>
  <arg name="calibration" default="$(find velodyne_pointcloud)/params/VLP16db.yaml"/>

  <group ns="lidar">
    <node pkg="nodelet" type="nodelet" name="lidar_nodelet_manager"
          args="manager" output="screen"/>

    <node pkg="nodelet" type="nodelet" name="lidar_driver"
          args="load velodyne_driver/DriverNodelet lidar_nodelet_manager">
      <param name="device_ip" value=""/>
      <param name="frame_id" value="$(arg frame_id)"/>
      <param name="model" value="VLP16"/>
      <param name="pcap" value=""/>
      <param name="port" value="$(arg port)"/>
      <param name="read_fast" value="false"/>
      <param name="read_once" value="false"/>
      <param name="repeat_delay" value="0.0"/>
      <param name="rpm" value="$(arg rpm)"/>
      <param name="gps_time" value="false"/>
      <param name="pcap_time" value="false"/>
      <param name="cut_angle" value="-0.01"/>
      <param name="timestamp_first_packet" value="$(arg timestamp_first_packet)"/>
      <remap from="velodyne_packets" to="/sensor/lidar1/packets"/>
    </node>

    <node pkg="nodelet" type="nodelet" name="lidar_transform"
          args="load velodyne_pointcloud/TransformNodelet lidar_nodelet_manager">
      <param name="model" value="VLP16"/>
      <param name="calibration" value="$(arg calibration)"/>
      <param name="fixed_frame" value=""/>
      <param name="target_frame" value=""/>
      <param name="max_range" value="130.0"/>
      <param name="min_range" value="0.4"/>
      <param name="organize_cloud" value="false"/>
      <remap from="velodyne_packets" to="/sensor/lidar1/packets"/>
      <remap from="velodyne_points" to="/sensor/lidar1"/>
    </node>
  </group>
</launch>
