<launch>
  <!--
    Legacy alias for ego_tf.launch.
    Prefer ego_tf.launch for new launch files.

    Publishes:
      /tf: morai_map -> base_link
  -->

  <arg name="ego_topic" default="/Ego_topic"/>
  <arg name="frame_id" default="morai_map"/>
  <arg name="child_frame_id" default="base_link"/>

  <include file="$(find tf_pub)/launch/ego_tf.launch">
    <arg name="ego_topic" value="$(arg ego_topic)"/>
    <arg name="parent_frame" value="$(arg frame_id)"/>
    <arg name="child_frame" value="$(arg child_frame_id)"/>
  </include>
</launch>
