<launch>
  <arg name="repo_root" default="$(env AJOUNICE_ROOT)"/>
  <arg name="map_file" default="$(arg repo_root)/kcity_map/lanelet_map/lanelet2_map_v101.osm"/>
  <arg name="map_sha256" default="574d0db7ba7aa2fbca55253e1ed467bdb4bfb2afeea78dd0b760227d47edeb29"/>
  <!-- The projector validates the actual selected file checksum, not its filename. -->
  <node pkg="ajounice_planning_integration" type="map_projector_publisher" name="map_projector_publisher" required="true" output="screen">
    <param name="repo_root" value="$(arg repo_root)"/>
    <param name="map_file" value="$(arg map_file)"/>
    <param name="map_sha256" value="$(arg map_sha256)"/>
  </node>
  <node pkg="autoware_map_loader" type="autoware_lanelet2_map_loader_full" name="lanelet2_map_loader" required="true" output="screen">
    <param name="lanelet2_map_path" value="$(arg map_file)"/>
    <param name="center_line_resolution" value="5.0" type="double"/>
    <param name="use_waypoints" value="true"/>
    <param name="allow_unsupported_version" value="true"/>
    <remap from="~output/lanelet2_map" to="/map/vector_map"/>
  </node>
</launch>
