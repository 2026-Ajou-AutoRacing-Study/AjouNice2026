<launch>
  <arg name="repo_root" default="$(env AJOUNICE_ROOT)"/>
  <!-- Explicit development map candidates; omitted arguments keep the released map. -->
  <arg name="map_file" default="$(arg repo_root)/kcity_map/lanelet_map/lanelet2_map_v88.osm"/>
  <arg name="map_sha256" default="dcddeee7defb0ba169d1ec14882f0d8cd98d520839c788c745f22a9d6156be37"/>
  <rosparam command="load" ns="/planning/longitudinal_acceleration_limits"
            file="$(arg repo_root)/configs/planning/longitudinal_acceleration_limits.yaml"/>
  <!-- Flat rear-axle-frame values, cross-checked against the vehicle mesh record. -->
  <arg name="vehicle_param_path"
       default="$(arg repo_root)/configs/planning/vehicle_info.yaml"/>
  <arg name="mission_planner_param_path"
       default="$(env AJOUNICE_ROOT)/base_ws/src/planning_addons/ajounice_planning_integration/config/mission_planner_kcity_v88.yaml"/>
  <!-- Passive until the RViz Route A button calls the gateway service. -->
  <arg name="start_requester" default="true"/>
  <arg name="is_simulation" default="false"/>
  <arg name="behavior_path_forward_length" default="400.0"/>
  <arg name="intersection_attention_area_length" default="100.0"/>
  <!-- Keep the competition behavior by default. Local localization/control
       load tests may explicitly bypass traffic lights without launching a
       fake signal publisher. -->
  <arg name="enable_traffic_light_planner" default="true"/>
  <!-- Production compliance policy; false is an explicit legacy-policy rollback. -->
  <arg name="enable_signal_compliance_guard" default="true"/>
  <!-- Opt-in moving green->yellow dilemma exception, not a yellow departure grant. -->
  <arg name="enable_yellow_passthrough" default="false"/>
  <!-- Timed candidate requires both this flag and the yellow master switch.
       2.0s is an explicit minimum-duration assumption, not an official guarantee. -->
  <arg name="signal_compliance_enable_timed_yellow" default="false"/>
  <arg name="signal_compliance_min_yellow_sec" default="2.0"/>
  <arg name="signal_compliance_yellow_time_margin_sec" default="0.2"/>
  <arg name="signal_compliance_required_green_observations" default="3"/>
  <!-- configs/planning/vehicle_info.yaml: base_link is the rear axle center. -->
  <arg name="signal_compliance_front_axle_offset_m" default="3.0"/>
  <!-- Data freshness, not an estimate of remaining yellow time. -->
  <arg name="traffic_light_state_timeout_sec" default="1.0"/>
  <!-- Keep normal LC logging; explicit development trials may select a scoped trace config. -->
  <arg name="planning_rosconsole_config"
       default="$(env AJOUNICE_ROOT)/base_ws/src/planning_addons/ajounice_planning_integration/config/lane_change_diagnostics.rosconsole"/>
  <arg name="behavior_velocity_launch_modules_with_traffic_light"
       default="[autoware::behavior_velocity_planner::experimental::CrosswalkModulePlugin, autoware::behavior_velocity_planner::experimental::WalkwayModulePlugin, autoware::behavior_velocity_planner::experimental::TrafficLightModulePlugin, autoware::behavior_velocity_planner::experimental::RoundaboutModulePlugin, autoware::behavior_velocity_planner::experimental::MergeFromPrivateModulePlugin, autoware::behavior_velocity_planner::experimental::BlindSpotModulePlugin, autoware::behavior_velocity_planner::experimental::VirtualTrafficLightModulePlugin, autoware::behavior_velocity_planner::experimental::NoStoppingAreaModulePlugin, autoware::behavior_velocity_planner::experimental::StopLineModulePlugin, autoware::behavior_velocity_planner::experimental::SpeedBumpModulePlugin, autoware::behavior_velocity_planner::experimental::NoDrivableLaneModulePlugin]"/>
  <arg name="behavior_velocity_launch_modules_without_traffic_light"
       default="[autoware::behavior_velocity_planner::experimental::CrosswalkModulePlugin, autoware::behavior_velocity_planner::experimental::WalkwayModulePlugin, autoware::behavior_velocity_planner::experimental::RoundaboutModulePlugin, autoware::behavior_velocity_planner::experimental::MergeFromPrivateModulePlugin, autoware::behavior_velocity_planner::experimental::BlindSpotModulePlugin, autoware::behavior_velocity_planner::experimental::VirtualTrafficLightModulePlugin, autoware::behavior_velocity_planner::experimental::NoStoppingAreaModulePlugin, autoware::behavior_velocity_planner::experimental::StopLineModulePlugin, autoware::behavior_velocity_planner::experimental::SpeedBumpModulePlugin, autoware::behavior_velocity_planner::experimental::NoDrivableLaneModulePlugin]"/>
  <arg name="behavior_velocity_launch_modules"
       default="$(eval arg('behavior_velocity_launch_modules_with_traffic_light') if arg('enable_traffic_light_planner') else arg('behavior_velocity_launch_modules_without_traffic_light'))"/>
  <!-- The competition perception stack intentionally publishes unresolved
       detections as UNKNOWN. Do not suppress a newly observed UNKNOWN object
       for the upstream two-second classification-stability grace period. -->
  <arg name="static_avoidance_unknown_stability_time" default="0.0"/>
  <arg name="publish_fixed_autonomous_mode" default="true"/>
  <arg name="relay_operation_mode_to_api" default="true"/>
  <arg name="use_ground_pointcloud" default="false"/>
  <arg name="use_occupancy_grid" default="false"/>
  <include if="$(arg relay_operation_mode_to_api)"
           file="$(find ajounice_planning_integration)/launch/operation_mode_relay.launch"/>
  <include if="$(arg publish_fixed_autonomous_mode)"
           file="$(find ajounice_planning_integration)/launch/fixed_autonomous_operation_mode.launch"/>
  <include file="$(find ajounice_planning_integration)/launch/map.launch">
    <arg name="repo_root" value="$(arg repo_root)"/>
    <arg name="map_file" value="$(arg map_file)"/>
    <arg name="map_sha256" value="$(arg map_sha256)"/>
  </include>
  <include file="$(find tier4_planning_launch)/launch/planning.launch">
    <!-- LC runtime log level; detailed candidate traces are opt-in. -->
    <env name="ROSCONSOLE_CONFIG_FILE"
         value="$(arg planning_rosconsole_config)"/>
    <arg name="vehicle_param_path" value="$(arg vehicle_param_path)"/>
    <arg name="mission_planner_param_path" value="$(arg mission_planner_param_path)"/>
    <arg name="is_simulation" value="$(arg is_simulation)"/>
    <arg name="use_ground_pointcloud" value="$(arg use_ground_pointcloud)"/>
    <arg name="use_occupancy_grid" value="$(arg use_occupancy_grid)"/>
    <arg name="start_parking" value="false"/>
    <!-- External-request lane changes require an explicit request/approval.
         Exclude them from this autonomous profile so reaching the preferred
         lane cannot start an unsolicited lane change away from it. -->
    <arg name="behavior_path_launch_modules"
         value="[autoware::behavior_path_planner::StaticObstacleAvoidanceModuleManager, autoware::behavior_path_planner::DynamicObstacleAvoidanceModuleManager, autoware::behavior_path_planner::SideShiftModuleManager, autoware::behavior_path_planner::BidirectionalTrafficModuleManager, autoware::behavior_path_planner::SamplingPlannerModuleManager, autoware::behavior_path_planner::LaneChangeRightModuleManager, autoware::behavior_path_planner::LaneChangeLeftModuleManager, autoware::behavior_path_planner::AvoidanceByLaneChangeModuleManager]"/>
    <arg name="behavior_velocity_launch_modules"
         value="$(arg behavior_velocity_launch_modules)"/>
    <arg name="motion_velocity_launch_modules"
         value="[autoware::motion_velocity_planner::ObstacleCruiseModule, autoware::motion_velocity_planner::OutOfLaneModule, autoware::motion_velocity_planner::DynamicObstacleStopModule, autoware::motion_velocity_planner::RunOutModule, autoware::motion_velocity_planner::experimental::BoundaryDeparturePreventionModule, autoware::motion_velocity_planner::RoadUserStopModule]"/>
    <arg name="validator_launch_modules"
         value="[autoware::planning_validator::full_source::TrajectoryChecker, autoware::planning_validator::full_source::LatencyChecker]"/>
  </include>
  <!-- Base-owned runtime override; keep the ported Autoware source/config unchanged. -->
  <rosparam param="/planning/scenario_planning/lane_driving/behavior_planning/behavior_path_planner/slot2">
    [side_shift, avoidance_by_lane_change, static_obstacle_avoidance, lane_change_left, lane_change_right, bidirectional_traffic]
  </rosparam>
  <param name="/planning/scenario_planning/lane_driving/behavior_planning/behavior_path_planner/forward_path_length"
         value="$(arg behavior_path_forward_length)"/>
  <param name="/planning/scenario_planning/lane_driving/behavior_planning/behavior_velocity_planner/intersection/common/attention_area_length"
         value="$(arg intersection_attention_area_length)"/>
  <param name="/planning/scenario_planning/lane_driving/behavior_planning/behavior_path_planner/avoidance/target_filtering/unstable_classification_time"
         value="$(arg static_avoidance_unknown_stability_time)"/>
  <param name="/planning/scenario_planning/lane_driving/behavior_planning/behavior_velocity_planner/traffic_light/enable_signal_compliance_guard"
         value="$(arg enable_signal_compliance_guard)"/>
  <param name="/planning/scenario_planning/lane_driving/behavior_planning/behavior_velocity_planner/traffic_light/enable_yellow_passthrough"
         value="$(arg enable_yellow_passthrough)"/>
  <param name="/planning/scenario_planning/lane_driving/behavior_planning/behavior_velocity_planner/traffic_light/signal_compliance_enable_timed_yellow"
         value="$(arg signal_compliance_enable_timed_yellow)"/>
  <param name="/planning/scenario_planning/lane_driving/behavior_planning/behavior_velocity_planner/traffic_light/signal_compliance_min_yellow_sec"
         value="$(arg signal_compliance_min_yellow_sec)"/>
  <param name="/planning/scenario_planning/lane_driving/behavior_planning/behavior_velocity_planner/traffic_light/signal_compliance_yellow_time_margin_sec"
         value="$(arg signal_compliance_yellow_time_margin_sec)"/>
  <param name="/planning/scenario_planning/lane_driving/behavior_planning/behavior_velocity_planner/traffic_light/signal_compliance_required_green_observations"
         value="$(arg signal_compliance_required_green_observations)"/>
  <param name="/planning/scenario_planning/lane_driving/behavior_planning/behavior_velocity_planner/traffic_light/signal_compliance_front_axle_offset_m"
         value="$(arg signal_compliance_front_axle_offset_m)"/>
  <param name="/planning/scenario_planning/lane_driving/behavior_planning/behavior_velocity_planner/traffic_light/tl_state_timeout"
         value="$(arg traffic_light_state_timeout_sec)"/>
  <include if="$(arg start_requester)" file="$(find competition_route_requester)/launch/competition_route_requester.launch">
    <arg name="repo_root" value="$(arg repo_root)"/>
  </include>
  <!-- No follower, empty objects/grid/cloud, TF, or localization publisher. -->
</launch>
