<launch>
  <!-- Production remains true. Set false only for local localization/control
       load tests that intentionally ignore every traffic signal. -->
  <arg name="enable_traffic_light_planner" default="true"/>
  <arg name="repo_root" default="$(env AJOUNICE_ROOT)"/>
  <!--
    No-argument AjouNice competition planning entrypoint.

    Localization/map TF, sensing, detection, tracking/prediction, traffic-light
    detection, RViz, and control are launched separately.  This launch owns
    the v87 binary map, operation mode, route requester, and the complete
    Mission -> BPP -> BVP -> path optimization -> MVP -> velocity smoother ->
    Planning Validator graph.
  -->
  <include file="$(find ajounice_planning_integration)/launch/planning.launch">
    <arg name="repo_root" value="$(env AJOUNICE_ROOT)"/>
    <arg name="mission_planner_param_path" value="$(arg repo_root)/base_ws/src/planning_addons/ajounice_planning_integration/config/mission_planner_kcity_v87.yaml"/>
    <arg name="start_requester" value="true"/>
    <arg name="is_simulation" value="false"/>
    <arg name="behavior_path_forward_length" value="400.0"/>
    <arg name="intersection_attention_area_length" value="100.0"/>
    <arg name="enable_traffic_light_planner"
         value="$(arg enable_traffic_light_planner)"/>
    <arg name="publish_fixed_autonomous_mode" value="true"/>
    <arg name="use_ground_pointcloud" value="false"/>
    <arg name="use_occupancy_grid" value="false"/>
  </include>
  <param name="/lanelet2_map_loader/lanelet2_map_path" value="$(arg repo_root)/kcity_map/lanelet_map/lanelet2_map_v87.osm"/>
  <param name="/route_requester/config_file" value="$(arg repo_root)/base_ws/src/planning_addons/competition_route_requester/config/competition_route_requester_v87.param.yaml"/>
  <param name="/route_supervisor/config_file" value="$(arg repo_root)/base_ws/src/planning_addons/competition_route_requester/config/competition_route_requester_v87.param.yaml"/>
  <param name="/finish_guard/config_file" value="$(arg repo_root)/base_ws/src/planning_addons/competition_route_requester/config/competition_route_requester_v87.param.yaml"/>
</launch>
