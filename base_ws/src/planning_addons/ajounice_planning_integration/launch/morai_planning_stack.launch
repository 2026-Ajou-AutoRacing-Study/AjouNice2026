<launch>
  <!--
    AjouNice MORAI integration entrypoint.  Controller output is disabled by
    default so the first gate can inspect /planning/trajectory safely.
  -->
  <arg name="repo_root" default="$(env AJOUNICE_ROOT)"/>
  <arg name="vehicle_param_path"
       default="$(arg repo_root)/configs/planning/vehicle_info.yaml"/>
  <arg name="vehicle_config"
       default="$(arg repo_root)/configs/vehicle/ioniq5.yaml"/>
  <arg name="sensor_config"
       default="$(arg repo_root)/configs/sensors/Sensor.json"/>
  <arg name="use_sim_time" default="false"/>

  <arg name="start_localization" default="true"/>
  <arg name="start_sensor_tf" default="true"/>
  <arg name="start_object_pipeline" default="true"/>
  <!-- Model checkpoints are not stored in Git; enable only after provisioning. -->
  <arg name="start_detector" default="false"/>
  <arg name="detector" default="fastbev"/>
  <arg name="fastbev_checkpoint"
       default="$(arg repo_root)/artifacts/detection3d/fastbev/releases/fastbev_i3_production.pth"/>
  <arg name="openpcdet_root" default=""/>
  <arg name="pointpainting_cfg"
       default="$(arg repo_root)/artifacts/detection3d/pointpainting/releases/260825_base2_s1_singleframe9_geom_aug_e38/pointpillar_morai_pointpainting_base2_singleframe9_geom_aug.yaml"/>
  <arg name="pointpainting_checkpoint"
       default="$(arg repo_root)/artifacts/detection3d/pointpainting/releases/260825_base2_s1_singleframe9_geom_aug_e38/pointpainting_base2_s1_best_epoch38.pth"/>
  <arg name="pointpainting_segmentation_checkpoint"
       default="$(arg repo_root)/artifacts/detection3d/pointpainting/releases/260817_sunny13_1500_9feat_80e/lraspp_4class_best_miou.pth"/>
  <arg name="prediction_model" default="ctrv"/>
  <arg name="start_traffic_light" default="true"/>
  <arg name="start_requester" default="false"/>
  <arg name="start_controller" default="false"/>

  <group if="$(arg start_localization)">
    <include file="$(find bringup)/launch/localization_morai_gt.launch">
      <arg name="repo_root" value="$(arg repo_root)"/>
      <arg name="use_sim_time" value="$(arg use_sim_time)"/>
      <!-- ajounice_planning_integration/map.launch is the sole binary-map owner. -->
      <arg name="start_lanelet_map" value="false"/>
    </include>
  </group>

  <group if="$(arg start_sensor_tf)">
    <include file="$(find bringup)/launch/sensing.launch">
      <arg name="sensor_config" value="$(arg sensor_config)"/>
      <arg name="enable_sensor_tf" value="true"/>
      <arg name="enable_ego_tf" value="false"/>
      <arg name="enable_vehicle_model" value="false"/>
      <arg name="start_rviz" value="false"/>
    </include>
  </group>

  <group if="$(arg start_object_pipeline)">
    <include file="$(find perception_object_pipeline)/launch/object_pipeline.launch">
      <arg name="repo_root" value="$(arg repo_root)"/>
      <arg name="use_sim_time" value="$(arg use_sim_time)"/>
      <arg name="start_detector" value="$(arg start_detector)"/>
      <arg name="detector" value="$(arg detector)"/>
      <arg name="fastbev_checkpoint" value="$(arg fastbev_checkpoint)"/>
      <arg name="openpcdet_root" value="$(arg openpcdet_root)"/>
      <arg name="pointpainting_cfg" value="$(arg pointpainting_cfg)"/>
      <arg name="pointpainting_checkpoint"
           value="$(arg pointpainting_checkpoint)"/>
      <arg name="pointpainting_segmentation_checkpoint"
           value="$(arg pointpainting_segmentation_checkpoint)"/>
      <arg name="prediction_model" value="$(arg prediction_model)"/>
      <arg name="map_file"
           value="$(arg repo_root)/kcity_map/lanelet_map/lanelet2_map_v61.osm"/>
      <arg name="projector_file"
           value="$(arg repo_root)/kcity_map/lanelet_map/map_projector_info_v1.yaml"/>
    </include>
  </group>

  <group if="$(arg start_traffic_light)">
    <include file="$(find traffic_light_detection)/launch/traffic_light_node.launch">
      <arg name="repo_root" value="$(arg repo_root)"/>
    </include>
  </group>

  <include file="$(find ajounice_planning_integration)/launch/planning.launch">
    <arg name="repo_root" value="$(arg repo_root)"/>
    <arg name="vehicle_param_path" value="$(arg vehicle_param_path)"/>
    <arg name="start_requester" value="$(arg start_requester)"/>
    <arg name="is_simulation" value="$(arg use_sim_time)"/>
  </include>

  <group if="$(arg start_controller)">
    <include file="$(find trajectory_follower)/launch/pp_pi_autoware.launch">
      <arg name="repo_root" value="$(arg repo_root)"/>
      <arg name="vehicle_config" value="$(arg vehicle_config)"/>
    </include>
  </group>
</launch>
