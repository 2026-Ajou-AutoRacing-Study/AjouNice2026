<launch>
  <include file="$(find ajounice_planning_integration)/launch/fixed_autonomous_operation_mode.launch">
    <arg name="output_topic" value="/test/system/operation_mode/state"/>
    <arg name="publish_rate" value="20.0"/>
  </include>
  <test test-name="fixed_autonomous_operation_mode"
        pkg="ajounice_planning_integration"
        type="test_fixed_autonomous_operation_mode.py"
        time-limit="15"/>
</launch>
