<launch>
  <!-- Compatibility entrypoint for the standardized production pipeline. -->
  <arg name="python_executable" default=""/>
  <arg name="repo_root" default="$(env HOME)/AjouNice2026"/>
  <arg name="checkpoint"
       default="$(arg repo_root)/artifacts/detection3d/fastbev/runs/full1500_stride1_fp16_wandb_v1/best_center_mAP_epoch_11.pth"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="planning_output_topic"
       default="/perception/object_recognition/objects"/>
  <arg name="horizons" default="[0.3, 0.6, 0.9, 1.2, 1.5]"/>

  <include file="$(find perception_object_pipeline)/launch/object_pipeline.launch">
    <arg name="detector" value="fastbev"/>
    <arg name="python_executable" value="$(arg python_executable)"/>
    <arg name="repo_root" value="$(arg repo_root)"/>
    <arg name="fastbev_checkpoint" value="$(arg checkpoint)"/>
    <arg name="predicted_objects" value="$(arg planning_output_topic)"/>
    <arg name="horizons" value="$(arg horizons)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
  </include>
</launch>
