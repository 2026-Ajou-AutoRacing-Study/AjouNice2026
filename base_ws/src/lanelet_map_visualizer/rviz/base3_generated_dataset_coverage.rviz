        ego_roundabout_circulation: true
        ego_roundabout_sample_spawn: true
        ego_sparse_background: true
        ego_standing_pedestrian: true
        ego_static_highway_obstacle: true
        ego_static_obstacle: true
        ego_stopped_vehicle: true
      Queue Size: 10
      Value: true
  Enabled: true
  Global Options:
    Background Color: 32; 32; 32
    Default Light: true
    Fixed Frame: morai_map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
