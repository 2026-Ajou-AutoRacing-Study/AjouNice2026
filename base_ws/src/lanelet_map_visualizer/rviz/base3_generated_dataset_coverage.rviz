    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Base3 Generated Coverage1
        - /Base3 Generated Coverage1/Namespaces1
      Splitter Ratio: 0.5
    Tree Height: 795
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /map/lanelet_map
      Name: Lanelet Map
      Namespaces:
        {}
      Queue Size: 10
      Value: false
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /dataset/base3/generated_coverage
