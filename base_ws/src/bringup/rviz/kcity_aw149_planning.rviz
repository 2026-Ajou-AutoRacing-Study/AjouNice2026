Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /K-City v961
        - /Mission Route1
        - /Competition Checkpoints1
        - /Final Trajectory1
        - /Perception Pipeline1
      Splitter Ratio: 0.5
    Tree Height: 191
  - Class: bringup/RosbagRecorder
    Name: Rosbag Recorder
  - Class: bringup/RouteControl
    Name: Route Status
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Align Bottom: false
      Background Alpha: 0.800000011920929
      Background Color: 0; 0; 0
      Class: rviz_2d_overlay_plugins/TextOverlay
      Enabled: true
      Foreground Alpha: 0.800000011920929
      Foreground Color: 25; 255; 240
      Invert Shadow: false
      Name: Vehicle Speed and Brake
      Overtake BG Color Properties: false
      Overtake FG Color Properties: false
      Overtake Position Properties: false
      Topic: /planning/debug/vehicle_overlay
      Value: true
      font: DejaVu Sans Mono
      height: 128
      hor_alignment: left
      hor_dist: 0
      line width: 2
      text size: 12
      ver_alignment: top
      ver_dist: 0
      width: 128
    - Alpha: 0.20000000298023224
      Cell Size: 20
      Class: rviz/Grid
      Color: 84; 88; 96
      Enabled: false
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
      Value: false
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /map/lanelet_map
      Name: K-City v96
      Namespaces:
        features/lane_markings: true
        features/road_borders: true
        features/stop_lines: true
        features/traffic_lights: true
        lanelet/centerlines: true
        lanelet/left_boundaries: true
        lanelet/right_boundaries: true
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /planning/mission_planning/route_marker
      Name: Mission Route
      Namespaces:
        end_lanelets: true
        goal_lanelets: true
        lane_start_bound: true
        left_lane_bound: true
        right_lane_bound: true
        route_lanelets: true
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /competition/rule_monitor/checkpoints
      Name: Competition Checkpoints
      Namespaces:
        {}
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /competition/rule_monitor/wheels
      Name: Competition Wheel Contact Debug
      Namespaces:
        {}
      Queue Size: 10
      Value: false
    - Alpha: 0.6499999761581421
      Buffer Length: 1
      Class: rviz/Path
      Color: 240; 240; 245
      Enabled: true
      Head Diameter: 0.30000001192092896
      Head Length: 0.20000000298023224
      Length: 0.30000001192092896
      Line Style: Lines
      Line Width: 0.03999999910593033
      Name: Final Trajectory Path
      Offset:
        X: 0
        Y: 0
        Z: 0.5
      Pose Color: 255; 85; 255
      Pose Style: None
      Queue Size: 10
      Radius: 0.029999999329447746
      Shaft Diameter: 0.10000000149011612
      Shaft Length: 0.10000000149011612
      Topic: /planning/debug/final_trajectory/path
      Unreliable: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /planning/debug/final_trajectory/markers
      Name: Final Trajectory
      Namespaces:
        final_trajectory_ends: true
        final_trajectory_horizon: true
        final_trajectory_line: true
        final_trajectory_points: true
      Queue Size: 10
      Value: true
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
        base_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
      Name: Ego Vehicle (IONIQ 5)
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz/Group
      Displays:
        - Alpha: 0.20000000298023224
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 38.04117202758789
            Min Value: 28.040103912353516
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 255; 255; 255
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: false
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: PointCloud2
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.009999999776482582
          Style: Points
          Topic: /sensor/lidar1
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: false
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /perception/object_recognition/visualization/detections
          Name: Detections (green, raw detector)
          Namespaces:
            {}
          Queue Size: 5
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /perception/object_recognition/visualization/tracks
          Name: Tracks (class and UNKNOWN labels)
          Namespaces:
            {}
          Queue Size: 5
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /perception/object_recognition/visualization/predictions
          Name: Map-CV Predictions (0-3 s)
          Namespaces:
            {}
          Queue Size: 5
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /evaluation/visualization/gt_boxes
          Name: MORAI GT BBoxes (magenta, debug only)
          Namespaces:
            {}
          Queue Size: 5
          Value: true
      Enabled: true
      Name: Perception Pipeline
    - Alpha: 1
      Class: rviz/Axes
      Enabled: true
      Length: 10
      Name: Route A Start (A)
      Radius: 0.6499999761581421
      Reference Frame: route_a_start
      Show Trail: false
      Value: true
    - Class: rviz/TF
      Enabled: true
      Filter (blacklist): ""
      Filter (whitelist): ""
      Frame Timeout: 15
      Frames:
        All Enabled: true
        base_link:
          Value: true
        camera_back:
          Value: true
        camera_front:
          Value: true
        camera_front_left:
          Value: true
        camera_front_right:
          Value: true
        gps:
          Value: true
        imu:
          Value: true
        lidar1:
          Value: true
        map:
          Value: true
        morai_map:
          Value: true
        odom:
          Value: true
        route_a_start:
          Value: true
      Marker Alpha: 0.6000000238418579
      Marker Scale: 0.699999988079071
      Name: Vehicle TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        map:
          morai_map:
            {}
          odom:
            base_link:
              camera_back:
                {}
              camera_front:
                {}
              camera_front_left:
                {}
              camera_front_right:
                {}
              gps:
                {}
              imu:
                {}
              lidar1:
                {}
          route_a_start:
            {}
      Update Interval: 0
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /sensor/camera/front
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Image
      Normalize Range: true
      Queue Size: 2
      Transport Hint: compressed
      Unreliable: false
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /sensor/camera/front_left
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Image
      Normalize Range: true
      Queue Size: 2
      Transport Hint: compressed
      Unreliable: false
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /sensor/camera/front_right
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Image
      Normalize Range: true
      Queue Size: 2
      Transport Hint: compressed
      Unreliable: false
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /sensor/camera/back
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Image
      Normalize Range: true
      Queue Size: 2
      Transport Hint: compressed
      Unreliable: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 18; 20; 24
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetInitialPose
      Theta std deviation: 0.2617993950843811
      Topic: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/ThirdPersonFollower
      Distance: 75.25112915039062
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.7853981852531433
      Focal Point:
        X: -2.1641178131103516
        Y: -0.33179914951324463
        Z: 7.62939453125e-06
      Focal Shape Fixed Size: false
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 1.5697963237762451
      Target Frame: base_link
      Yaw: 3.100398302078247
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1043
  Hide Left Dock: false
  Hide Right Dock: true
  Image:
    collapsed: false
  QMainWindow State: 
  Rosbag Recorder:
    collapsed: false
  Route Status:
    collapsed: false
  Views:
    collapsed: false
  Width: 1280
  X: 1280
  Y: 0
