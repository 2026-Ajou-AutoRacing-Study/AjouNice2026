Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /K-City v611
        - /Mission Route1
        - /Final Trajectory1
        - /Ego Vehicle1
        - /Perception Objects1
        - /Route A Start1
      Splitter Ratio: 0.5
    Tree Height: 690
  - Class: bringup/RosbagRecorder
    Name: Rosbag Recorder
  - Class: bringup/RouteControl
    Name: Route Control
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.2
      Cell Size: 20
      Class: rviz/Grid
      Color: 84; 88; 96
      Enabled: false
      Name: Grid
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
      Value: false
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /map/lanelet_map
      Name: K-City v61
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /planning/mission_planning/route_marker
      Name: Mission Route
      Queue Size: 10
      Value: true
    - Alpha: 0.65
      Buffer Length: 1
      Class: rviz/Path
      Color: 240; 240; 245
      Enabled: true
      Line Style: Lines
      Line Width: 0.04
      Name: Final Trajectory Path
      Offset:
        X: 0
        Y: 0
        Z: 0.5
      Pose Style: None
      Topic: /planning/debug/final_trajectory/path
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /planning/debug/final_trajectory/markers
      Name: Final Trajectory
      Queue Size: 10
      Value: true
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
        base_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
      Name: Ego Vehicle (IONIQ 5)
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: autoware_perception_rviz_plugin/PredictedObjects
      Confidence Interval: 95%
      Display Acceleration: false
      Display Existence Probability: false
      Display Indicator: false
      Display Label: true
      Display Mesh: false
      Display Offset: 0
      Display Pose Covariance: false
      Display Predicted Path Confidence: false
      Display Predicted Paths: true
      Display Twist: false
      Display Twist Covariance: false
      Display UUID: false
      Display Velocity: true
      Display Yaw Covariance: false
      Display Yaw Rate: false
      Display Yaw Rate Covariance: false
      Enabled: true
      Line Width: 0.08
      Name: Perception Objects
      Object Fill Type: skeleton
      Polygon Type: 3d
      Queue Size: 10
      Topic: /perception/object_recognition/objects
      Unreliable: false
      Value: true
      Visualization Type: Normal
    - Class: rviz/Axes
      Enabled: true
      Length: 10
      Name: Route A Start (A)
      Radius: 0.65
      Reference Frame: route_a_start
      Value: true
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Marker Alpha: 0.6
      Marker Scale: 0.7
      Name: Vehicle TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
  Enabled: true
  Global Options:
    Background Color: 18; 20; 24
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Views:
    Current:
      Angle: 0
      Class: rviz/TopDownOrtho
      Name: K-City AW149 Planning
      Scale: 1.1
      Target Frame: base_link
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1500
  X: 20
  Y: 30
