Panels:
- Class: rviz/Displays
  Name: Displays
- Class: bringup/RouteEditor
  Name: Route Editor
- Class: rviz/Views
  Name: Views
Preferences:
  PromptSaveOnExit: false
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz/MarkerArray
    Enabled: true
    Marker Topic: /map/lanelet_map
    Name: K-City v85
    Namespaces:
      features/lane_markings: true
      features/road_borders: true
      features/stop_lines: true
      features/traffic_lights: true
      lanelet/centerlines: true
      lanelet/left_boundaries: true
      lanelet/right_boundaries: true
    Queue Size: 10
    Value: true
  - Class: rviz/MarkerArray
    Enabled: true
    Marker Topic: /planning/route_editor/markers
    Name: Route A B and Edit Preview
    Namespaces: {}
    Queue Size: 1
    Value: true
  - Class: rviz/InteractiveMarkers
    Enabled: true
    Name: Editable Route Waypoints
    Update Topic: /planning_route_editor/update
    Show Descriptions: true
    Show Axes: false
    Show Visual Aids: false
    Value: true
  Enabled: true
  Global Options:
    Background Color: 18; 20; 24
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz/Interact
    Hide Inactive Objects: false
  - Class: rviz/MoveCamera
  - Class: rviz/Select
  - Class: rviz/FocusCamera
  - Class: bringup/RoutePoint
    Map height: 28.4
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      Target Frame: map
      Angle: 0
      Scale: 0.75
      X: 70
      Y: 470
      Near Clip Distance: 0.01
    Saved: null
Window Geometry:
  Width: 1600
  Height: 1000
  X: 20
  Y: 20
  Hide Left Dock: false
  Hide Right Dock: false
