Panels:
- Class: rviz/Displays
  Name: Displays
- Class: bringup/LaneletSpeedEditor
  Name: Lanelet Speed Limit
- Class: rviz/Views
  Name: Views
Preferences:
  PromptSaveOnExit: false
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz/MarkerArray
    Enabled: true
    Marker Topic: /map/lanelet_map
    Name: K-City v85
    Namespaces: {}
    Queue Size: 1
    Value: true
  - Class: rviz/MarkerArray
    Enabled: true
    Marker Topic: /planning/lanelet_speed_editor/markers
    Name: Route B and Selected Speed Limits
    Namespaces: {}
    Queue Size: 1
    Value: true
  Enabled: true
  Global Options:
    Background Color: 18; 20; 24
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz/Interact
    Hide Inactive Objects: false
  - Class: rviz/MoveCamera
  - Class: rviz/Select
  - Class: rviz/FocusCamera
  - Class: bringup/LaneletSpeed
    Map height: 28.4
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      Target Frame: map
      Angle: 0
      Scale: 0.75
      X: 70
      Y: 470
      Near Clip Distance: 0.01
    Saved:
    - Class: rviz/TopDownOrtho
      Name: Highway Merge Detail
      Target Frame: map
      Angle: 0
      Scale: 8
      X: 200
      Y: 370
      Near Clip Distance: 0.01
Window Geometry:
  Width: 1600
  Height: 1000
  X: 20
  Y: 20
  Hide Left Dock: false
  Hide Right Dock: false
