Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /K-City Lanelet Map1
        - /Mission Route1
        - /BPP Path1
        - /BVP Path1
        - /BVP Stop Line Markers1
      Splitter Ratio: 0.5
    Tree Height: 620
  - Class: rviz/Selection
    Name: Selection
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.25
      Cell Size: 20
      Class: rviz/Grid
      Color: 90; 94; 102
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 500
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /map/lanelet_map
      Name: K-City Lanelet Map
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /planning/mission_planning/mission_planner/debug/route_marker
      Name: Mission Route
      Queue Size: 10
      Value: true
    - Class: rviz/Path
      Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 0; 210
      Enabled: true
      Head Diameter: 0.4
      Head Length: 0.3
      Length: 0.3
      Line Style: Lines
      Line Width: 0.12
      Name: BPP Path
      Offset:
        X: 0
        Y: 0
        Z: 0.45
      Pose Color: 255; 255; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic: /planning/debug/bpp/path
      Value: true
    - Class: rviz/Path
      Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 0; 220; 255
      Enabled: true
      Head Diameter: 0.4
      Head Length: 0.3
      Length: 0.3
      Line Style: Lines
      Line Width: 0.08
      Name: BVP Path
      Offset:
        X: 0
        Y: 0
        Z: 0.65
      Pose Color: 255; 255; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic: /planning/scenario_planning/lane_driving/behavior_planning/path
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /planning/debug/behavior_velocity_planner/markers
      Name: BVP Stop Line Markers
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /planning/mission_planning/rviz/input_markers
      Name: Start and Goal
      Queue Size: 10
      Value: true
  Enabled: true
  Global Options:
    Background Color: 20; 22; 26
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz/TopDownOrtho
      Name: K-City Mission BPP BVP
      Scale: 12
      Target Frame: <Fixed Frame>
      X: 2600
      Y: 23900
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1400
  X: 40
  Y: 40
