Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /K-City Lanelet Map1
        - /Mission Route1
        - /ROS2 Reference Speed1
        - /ROS1 Integrated Speed1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz/Selection
    Name: Selection
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.25
      Cell Size: 20
      Class: rviz/Grid
      Color: 90; 94; 102
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 500
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /validation/mission_bpp_bvp/lanelet_map
      Name: K-City Lanelet Map
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /planning/mission_planning/mission_planner/debug/route_marker
      Name: Mission Route
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /validation/mission_bpp_bvp/context
      Name: Scenario and Result
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /validation/mission_bpp_bvp/reference_speed_path
      Name: ROS2 Reference Speed
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /validation/mission_bpp_bvp/live_speed_path
      Name: ROS1 Integrated Speed
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /planning/debug/behavior_velocity_planner/markers
      Name: BVP Decision Markers
      Queue Size: 10
      Value: true
  Enabled: true
  Global Options:
    Background Color: 20; 22; 26
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz/TopDownOrtho
      Name: Mission BPP BVP Integration
      Scale: 18
      Target Frame: <Fixed Frame>
      X: 2305
      Y: 23725
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1400
  X: 40
  Y: 40
