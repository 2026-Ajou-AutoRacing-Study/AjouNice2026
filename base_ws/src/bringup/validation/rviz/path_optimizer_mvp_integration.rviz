Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /K-City Lanelet Map1
        - /Motion Velocity Planner1
      Splitter Ratio: 0.5
    Tree Height: 700
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.25
      Cell Size: 20
      Class: rviz/Grid
      Color: 90; 94; 102
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 500
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /validation/path_optimizer_mvp/lanelet_map
      Name: K-City Lanelet Map
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /planning/mission_planning/mission_planner/debug/route_marker
      Name: Mission Route
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /validation/motion_velocity_planner/markers
      Name: Motion Velocity Planner
      Queue Size: 10
      Value: true
  Enabled: true
  Global Options:
    Background Color: 20; 22; 26
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Views:
    Current:
      Angle: 0
      Class: rviz/TopDownOrtho
      Name: Path Optimizer to MVP Integration
      Scale: 18
      Target Frame: <Fixed Frame>
      X: 2305
      Y: 23725
    Saved: ~
Window Geometry:
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1400
  X: 40
  Y: 40
