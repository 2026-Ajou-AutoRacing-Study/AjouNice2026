<launch>
  <arg name="map_file" default="$(env HOME)/AJOUNICE2026/lanelet2_map_v44.osm" />
  <arg name="reference_json" />
  <arg name="report_json" />
  <arg name="expected_module" />
  <arg name="map_projector_type" default="MGRS" />
  <arg name="max_velocity" default="16.666666" />
  <arg name="forward_path_length" default="5000.0" />
  <arg name="timeout" default="30.0" />
  <arg name="launch_rviz" default="true" />
  <arg name="shutdown_on_result" default="false" />

  <include file="$(find bringup)/launch/mission_bpp_bvp_pipeline.launch">
    <arg name="frame_id" value="map" />
    <arg name="map_file" value="$(arg map_file)" />
    <arg name="map_projector_type" value="$(arg map_projector_type)" />
    <arg name="route_lane_ids" value="[]" />
    <arg name="default_velocity_mps" value="$(arg max_velocity)" />
    <arg name="require_lane_driving_scenario" value="true" />
    <arg name="forward_path_length" value="$(arg forward_path_length)" />
    <arg name="enable_goal_planner" value="false" />
    <arg name="enable_side_shift" value="false" />
  </include>

  <include file="$(find lanelet_map_visualizer)/launch/kcity_lanelet_map.launch">
    <arg name="map_file" value="$(arg map_file)" />
    <arg name="projector_file" value="" />
    <arg name="projector_type" value="$(arg map_projector_type)" />
    <arg name="frame_id" value="map" />
    <arg name="output_topic" value="/validation/mission_bpp_bvp/lanelet_map" />
    <arg name="publish_lanelet_fill" value="false" />
  </include>

  <node pkg="bringup"
        type="planning_pipeline_reference_input.py"
        name="planning_pipeline_reference_input"
        output="screen">
    <param name="reference_json" value="$(arg reference_json)" />
    <param name="max_velocity" value="$(arg max_velocity)" />
    <param name="request_delay" value="1.0" />
  </node>

  <node pkg="bringup"
        type="mission_bpp_bvp_pipeline_validator.py"
        name="mission_bpp_bvp_pipeline_validator"
        required="$(arg shutdown_on_result)"
        output="screen">
    <param name="reference_json" value="$(arg reference_json)" />
    <param name="report_json" value="$(arg report_json)" />
    <param name="expected_module" value="$(arg expected_module)" />
    <param name="timeout" value="$(arg timeout)" />
    <param name="goal_tolerance" value="1.0" />
    <param name="geometry_tolerance" value="0.25" />
    <param name="stop_pose_tolerance" value="1.5" />
    <param name="stop_station_tolerance" value="2.0" />
    <param name="shutdown_on_result" value="$(arg shutdown_on_result)" />
  </node>

  <node pkg="bringup"
        type="mission_bpp_bvp_live_visualizer.py"
        name="mission_bpp_bvp_live_visualizer"
        output="screen">
    <param name="reference_json" value="$(arg reference_json)" />
    <param name="frame_id" value="map" />
    <param name="display_offset" value="1.2" />
  </node>

  <node if="$(arg launch_rviz)"
        pkg="rviz"
        type="rviz"
        name="mission_bpp_bvp_validation_rviz"
        args="-d $(find bringup)/validation/rviz/mission_bpp_bvp_integration.rviz"
        output="screen" />
</launch>
