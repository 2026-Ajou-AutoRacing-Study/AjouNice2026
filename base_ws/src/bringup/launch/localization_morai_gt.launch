<launch>
  <!--
    MORAI ground-truth localization stack.

    TF output:
      map -> morai_map -> base_link

    Planning output:
      /localization/kinematic_state (map -> base_link pose, base_link twist)

    Do not run localization_fast_lio.launch, maptf.launch, or
    maptf_morai_deg_correction.launch at the same time. MORAI bridge and
    sensing are intentionally launched separately.
  -->
  <arg name="use_sim_time" default="false"/>
  <arg name="localization_manager_config"
       default="$(env HOME)/AjouNice2026/configs/localization/localization_manager.yaml"/>

  <arg name="ego_topic" default="/Ego_topic"/>
  <arg name="map_frame" default="map"/>
  <arg name="morai_map_frame" default="morai_map"/>
  <arg name="base_frame" default="base_link"/>
  <arg name="heading_in_degrees" default="true"/>
  <arg name="use_heading_correction" default="false"/>
  <arg name="heading_yaw_offset_deg" default="-1.37"/>
  <arg name="start_lanelet_map" default="true"/>
  <arg name="map_file"
       default="$(find lanelet_map_visualizer)/../../../kcity_map/lanelet_map/lanelet2_map_v60.osm"/>
  <arg name="projector_file"
       default="$(find lanelet_map_visualizer)/../../../kcity_map/lanelet_map/map_projector_info_v1.yaml"/>
  <arg name="map_projector_type" default="LocalCartesianUTM"/>

  <param name="/use_sim_time" value="$(arg use_sim_time)"/>

  <include file="$(find tf_pub)/launch/map_tf.launch">
    <arg name="parent_frame" value="$(arg map_frame)"/>
    <arg name="child_frame" value="$(arg morai_map_frame)"/>
  </include>

  <include file="$(find localization_manager)/launch/morai_gt.launch">
    <arg name="config" value="$(arg localization_manager_config)"/>
    <arg name="ego_topic" value="$(arg ego_topic)"/>
    <arg name="map_frame" value="$(arg map_frame)"/>
    <arg name="morai_map_frame" value="$(arg morai_map_frame)"/>
    <arg name="base_frame" value="$(arg base_frame)"/>
    <arg name="heading_in_degrees" value="$(arg heading_in_degrees)"/>
    <arg name="use_heading_correction" value="$(arg use_heading_correction)"/>
    <arg name="heading_yaw_offset_deg" value="$(arg heading_yaw_offset_deg)"/>
  </include>

  <group if="$(arg start_lanelet_map)">
    <include file="$(find lanelet_map_visualizer)/launch/kcity_lanelet_map.launch">
      <arg name="map_file" value="$(arg map_file)"/>
      <arg name="projector_file" value="$(arg projector_file)"/>
      <arg name="projector_type" value="$(arg map_projector_type)"/>
      <arg name="frame_id" value="$(arg map_frame)"/>
      <arg name="output_topic" value="/map/lanelet_map"/>
      <arg name="publish_lanelet_fill" value="false"/>
    </include>
  </group>
</launch>
