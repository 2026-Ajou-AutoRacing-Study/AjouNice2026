<launch>
  <arg name="map_file" default="$(env HOME)/AJOUNICE2026/lanelet2_map_v44.osm" />
  <arg name="frame_id" default="map" />
  <arg name="default_z" default="28.5" />
  <arg name="max_velocity" default="4.1666665" />
  <arg name="forward_path_length" default="5000.0" />
  <arg name="mvp_extract_ahead_dist" default="200.0" />
  <arg name="mvp_extract_behind_dist" default="0.0" />
  <arg name="publish_static_odometry" default="true" />
  <arg name="launch_rviz" default="true" />

  <include file="$(find bringup)/launch/mission_bpp_bvp_path_smoother_path_optimizer_mvp_pipeline.launch">
    <arg name="frame_id" value="$(arg frame_id)" />
    <arg name="map_file" value="$(arg map_file)" />
    <arg name="projector_file" value="" />
    <arg name="map_projector_type" value="MGRS" />
    <arg name="route_lane_ids" value="[]" />
    <arg name="default_velocity_mps" value="$(arg max_velocity)" />
    <arg name="mvp_velocity_mps" value="$(arg max_velocity)" />
    <arg name="require_lane_driving_scenario" value="true" />
    <arg name="forward_path_length" value="$(arg forward_path_length)" />
    <arg name="enable_goal_planner" value="false" />
    <arg name="enable_side_shift" value="false" />
    <arg name="enable_path_smoother_debug" value="false" />
    <arg name="enable_path_optimizer_debug" value="false" />
    <arg name="mvp_extract_ahead_dist" value="$(arg mvp_extract_ahead_dist)" />
    <arg name="mvp_extract_behind_dist" value="$(arg mvp_extract_behind_dist)" />
  </include>

  <include file="$(find lanelet_map_visualizer)/launch/kcity_lanelet_map.launch">
    <arg name="map_file" value="$(arg map_file)" />
    <arg name="projector_file" value="" />
    <arg name="projector_type" value="MGRS" />
    <arg name="frame_id" value="$(arg frame_id)" />
    <arg name="output_topic" value="/map/lanelet_map" />
    <arg name="publish_lanelet_fill" value="false" />
  </include>

  <node pkg="mission_planner"
        type="mission_planner_rviz_input.py"
        name="mission_planner_rviz_input"
        output="screen">
    <param name="frame_id" value="$(arg frame_id)" />
    <param name="default_z" value="$(arg default_z)" />
    <param name="max_velocity" value="$(arg max_velocity)" />
    <param name="allow_modification" value="false" />
    <param name="publish_static_odometry" value="$(arg publish_static_odometry)" />
  </node>

  <node pkg="bringup"
        type="planning_trajectory_visualizer.py"
        name="planning_trajectory_visualizer"
        output="screen">
    <param name="input_topic" value="/planning/scenario_planning/lane_driving/motion_planning/motion_velocity_planner/trajectory" />
    <param name="path_topic" value="/planning/debug/final_trajectory/path" />
    <param name="marker_topic" value="/planning/debug/final_trajectory/markers" />
    <param name="nominal_velocity_mps" value="$(arg max_velocity)" />
  </node>

  <node if="$(arg launch_rviz)"
        pkg="rviz"
        type="rviz"
        name="kcity_interactive_trajectory_rviz"
        args="-d $(find bringup)/rviz/kcity_interactive_trajectory.rviz"
        output="screen" />
</launch>
