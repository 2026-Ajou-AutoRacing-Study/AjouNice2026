<launch>
  <!--
    GPS-based map TF before the real localization stack is ready.

    Input:
      /sensor/gps latitude/longitude from the MORAI simulator.

    Conversion:
      latitude/longitude -> UTM52
      UTM52 - GPSMessage eastOffset/northOffset -> morai_map pose
      map -> morai_map static TF connects that pose to the Lanelet map frame.

    Output TF:
      map -> morai_map        static Lanelet-to-MORAI map alignment
      morai_map -> base_link  dynamic GPS-derived ego pose

    Do not run this with localization_morai_gt.launch or
    localization_fast_lio.launch. They publish competing map/base_link TF
    branches.
  -->
  <arg name="repo_root" default="$(env AJOUNICE_ROOT)"/>
  <arg name="gps_topic" default="/sensor/gps"/>
  <arg name="map_frame" default="map"/>
  <arg name="morai_map_frame" default="morai_map"/>
  <arg name="base_frame" default="base_link"/>
  <arg name="start_lanelet_map" default="true"/>
  <arg name="map_file"
       default="$(arg repo_root)/kcity_map/lanelet_map/lanelet2_map_v96.osm"/>
  <arg name="projector_file"
       default="$(arg repo_root)/kcity_map/lanelet_map/map_projector_info_v1.yaml"/>
  <arg name="map_projector_type" default="LocalCartesianUTM"/>

  <include file="$(find tf_pub)/launch/map_tf.launch">
    <arg name="parent_frame" value="$(arg map_frame)"/>
    <arg name="child_frame" value="$(arg morai_map_frame)"/>
  </include>

  <include file="$(find tf_pub)/launch/gps_tf.launch">
    <arg name="gps_topic" value="$(arg gps_topic)"/>
    <arg name="parent_frame" value="$(arg morai_map_frame)"/>
    <arg name="child_frame" value="$(arg base_frame)"/>
  </include>

  <group if="$(arg start_lanelet_map)">
    <include file="$(find lanelet_map_visualizer)/launch/kcity_lanelet_map.launch">
      <arg name="map_file" value="$(arg map_file)"/>
      <arg name="projector_file" value="$(arg projector_file)"/>
      <arg name="projector_type" value="$(arg map_projector_type)"/>
      <arg name="frame_id" value="$(arg map_frame)"/>
      <arg name="output_topic" value="/map/lanelet_map"/>
      <arg name="publish_lanelet_fill" value="false"/>
    </include>
  </group>
</launch>
