<launch>
  <!--
    Live MORAI simulator Ego map TF with a yaw-only heading correction.

    This launch keeps map -> morai_map unchanged and publishes the same
    morai_map -> base_link edge as maptf_morai.launch, so do not run both
    launches at the same time.
  -->
  <arg name="ego_topic" default="/Ego_topic"/>
  <arg name="map_frame" default="map"/>
  <arg name="morai_map_frame" default="morai_map"/>
  <arg name="base_frame" default="base_link"/>
  <arg name="heading_yaw_offset_deg" default="-1.37"/>

  <include file="$(find tf_pub)/launch/map_tf.launch">
    <arg name="parent_frame" value="$(arg map_frame)"/>
    <arg name="child_frame" value="$(arg morai_map_frame)"/>
  </include>

  <include file="$(find tf_pub)/launch/ego_tf_deg_correction.launch">
    <arg name="ego_topic" value="$(arg ego_topic)"/>
    <arg name="parent_frame" value="$(arg morai_map_frame)"/>
    <arg name="child_frame" value="$(arg base_frame)"/>
    <arg name="heading_yaw_offset_deg" value="$(arg heading_yaw_offset_deg)"/>
  </include>
</launch>
