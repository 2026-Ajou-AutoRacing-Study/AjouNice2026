<launch>
  <!-- Compatibility entrypoint for MORAI GT localization with yaw correction. -->
  <arg name="use_sim_time" default="false"/>
  <arg name="localization_manager_config"
       default="$(env HOME)/AjouNice2026/configs/localization/localization_manager.yaml"/>
  <arg name="ego_topic" default="/Ego_topic"/>
  <arg name="map_frame" default="map"/>
  <arg name="morai_map_frame" default="morai_map"/>
  <arg name="base_frame" default="base_link"/>
  <arg name="heading_yaw_offset_deg" default="-1.347"/>
  <!-- 지도 버전을 암묵적으로 고정하지 않도록 호출자가 두 파일을 반드시 전달한다. -->
  <arg name="map_file"/>
  <arg name="projector_file"/>

  <include file="$(find bringup)/launch/localization_morai_gt.launch">
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="localization_manager_config" value="$(arg localization_manager_config)"/>
    <arg name="ego_topic" value="$(arg ego_topic)"/>
    <arg name="map_frame" value="$(arg map_frame)"/>
    <arg name="morai_map_frame" value="$(arg morai_map_frame)"/>
    <arg name="base_frame" value="$(arg base_frame)"/>
    <arg name="use_heading_correction" value="true"/>
    <arg name="heading_yaw_offset_deg" value="$(arg heading_yaw_offset_deg)"/>
    <arg name="map_file" value="$(arg map_file)"/>
    <arg name="projector_file" value="$(arg projector_file)"/>
  </include>
</launch>
