<launch>
  <arg name="map_file" default="$(env HOME)/AJOUNICE2026/lanelet2_map_v44.osm" />
  <arg name="frame_id" default="map" />
  <arg name="default_z" default="28.5" />
  <arg name="max_velocity" default="4.1666665" />
  <arg name="forward_path_length" default="5000.0" />
  <arg name="route_preset" default="full" />
  <arg name="launch_rviz" default="true" />

  <!-- Mission Planner and BPP only. Odometry remains fixed at the course start. -->
  <include file="$(find bringup)/launch/kcity_mission_bpp_rviz.launch">
    <arg name="map_file" value="$(arg map_file)" />
    <arg name="frame_id" value="$(arg frame_id)" />
    <arg name="default_z" value="$(arg default_z)" />
    <arg name="max_velocity" value="$(arg max_velocity)" />
    <arg name="forward_path_length" value="$(arg forward_path_length)" />
    <arg name="launch_rviz" value="false" />
  </include>

  <node pkg="bringup"
        type="kcity_competition_route_publisher.py"
        name="kcity_competition_static_route_publisher"
        output="screen">
    <param name="frame_id" value="$(arg frame_id)" />
    <param name="route_preset" value="$(arg route_preset)" />
    <param name="validate_trajectory" value="false" />
    <param name="keep_alive" value="true" />
  </node>

  <node if="$(arg launch_rviz)"
        pkg="rviz"
        type="rviz"
        name="kcity_competition_static_path_rviz"
        args="-d $(find bringup)/rviz/kcity_competition_static_path.rviz"
        output="screen" />
</launch>
