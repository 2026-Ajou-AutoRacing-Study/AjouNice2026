<launch>
  <!-- GT-assisted GNSS+IMU CTRA-like provider for live MORAI or bag replay. -->
  <arg name="use_sim_time" default="false"/>
  <arg name="repo_root" default="$(env AJOUNICE_ROOT)"/>
  <arg name="gt_source" default="ego"/>
  <arg name="initial_position_source" default="ego"/>
  <arg name="official_start_config"
       default="$(arg repo_root)/base_ws/src/competition/competition_rule_monitor/config/kcity_v85_rules.yaml"/>
  <arg name="use_heading_correction" default="true"/>
  <arg name="heading_yaw_offset_deg" default="-1.347"/>
  <arg name="sensor_config"
       default="$(arg repo_root)/configs/sensors/Sensor.json"/>
  <arg name="measurement_noise_config"
       default="$(arg repo_root)/configs/localization/gnss_imu_gt_noise_sensor6_ideal.yaml"/>
  <arg name="localization_manager_config"
       default="$(arg repo_root)/configs/localization/localization_manager.yaml"/>
  <arg name="local_ekf_base_config"
       default="$(arg repo_root)/configs/localization/robot_localization_gnss_imu_local.yaml"/>
  <arg name="global_ekf_base_config"
       default="$(arg repo_root)/configs/localization/robot_localization_gnss_imu_global.yaml"/>
  <arg name="local_ekf_gt_config"
       default="$(arg repo_root)/configs/localization/robot_localization_gnss_imu_gt_ctra_local.yaml"/>
  <arg name="global_ekf_gt_config"
       default="$(arg repo_root)/configs/localization/robot_localization_gnss_imu_gt_ctra_global.yaml"/>
  <arg name="use_lateral_velocity_constraint" default="true"/>
  <arg name="lateral_velocity_stddev_mps" default="0.20"/>
  <arg name="gnss_quantization_input_mode" default="off"/>
  <arg name="gnss_quantization_step_deg" default="0.0000016666666666666667"/>
  <!-- sensing.launch owns the shared sensor static TFs in the competition stack. -->
  <arg name="publish_sensor_tf" default="false"/>
  <!-- Production controller state. Planning and TF continue to use the
       unsmoothed global /localization/kinematic_state. -->
  <arg name="publish_control_state" default="true"/>
  <arg name="use_quantized_gnss_control_state" default="false"/>
  <arg name="control_state_topic"
       default="/localization/control_kinematic_state"/>
  <arg name="control_translation_tau_sec" default="0.5"/>
  <arg name="control_yaw_tau_sec" default="0.5"/>
  <arg name="control_state_use_vehicle_pivot" default="true"/>
  <arg name="control_lateral_tau_sec" default="0.1"/>
  <arg name="control_max_lateral_correction_rate_mps" default="0.3"/>
  <arg name="quantized_control_yaw_tau_sec" default="0.0"/>
  <arg name="control_state_reset_translation_error_m" default="0.5"/>
  <arg name="control_state_reset_yaw_error_deg" default="20.0"/>
  <arg name="enable_relocation_guard" default="false"/>
  <arg name="relocation_guard_monitor_only" default="true"/>
  <arg name="relocation_guard_threshold_m" default="5.0"/>
  <arg name="relocation_guard_consecutive_samples" default="3"/>
  <arg name="relocation_guard_cooldown_sec" default="5.0"/>

  <arg name="map_frame" default="map"/>
  <arg name="morai_map_frame" default="morai_map"/>
  <arg name="base_frame" default="base_link"/>

  <param name="/use_sim_time" value="$(arg use_sim_time)"/>

  <include file="$(find tf_pub)/launch/map_tf.launch">
    <arg name="parent_frame" value="$(arg map_frame)"/>
    <arg name="child_frame" value="$(arg morai_map_frame)"/>
  </include>

  <group if="$(arg publish_sensor_tf)">
    <include file="$(find tf_pub)/launch/sensor_tf.launch">
      <arg name="sensor_config" value="$(arg sensor_config)"/>
      <arg name="parent_frame" value="$(arg base_frame)"/>
      <arg name="publish_lidar" value="false"/>
      <arg name="publish_imu" value="true"/>
      <arg name="publish_camera" value="false"/>
      <arg name="publish_gps" value="true"/>
    </include>
  </group>

  <include file="$(find localization_manager)/launch/gnss_imu_gt_ctra.launch">
    <arg name="gt_source" value="$(arg gt_source)"/>
    <arg name="initial_position_source" value="$(arg initial_position_source)"/>
    <arg name="official_start_config" value="$(arg official_start_config)"/>
    <arg name="use_heading_correction"
         value="$(arg use_heading_correction)"/>
    <arg name="heading_yaw_offset_deg"
         value="$(arg heading_yaw_offset_deg)"/>
    <arg name="sensor_config" value="$(arg sensor_config)"/>
    <arg name="config" value="$(arg localization_manager_config)"/>
    <arg name="measurement_noise_config"
         value="$(arg measurement_noise_config)"/>
    <arg name="local_ekf_base_config" value="$(arg local_ekf_base_config)"/>
    <arg name="global_ekf_base_config" value="$(arg global_ekf_base_config)"/>
    <arg name="local_ekf_gt_config" value="$(arg local_ekf_gt_config)"/>
    <arg name="global_ekf_gt_config" value="$(arg global_ekf_gt_config)"/>
    <arg name="use_lateral_velocity_constraint"
         value="$(arg use_lateral_velocity_constraint)"/>
    <arg name="lateral_velocity_stddev_mps"
         value="$(arg lateral_velocity_stddev_mps)"/>
    <arg name="gnss_quantization_input_mode" value="$(arg gnss_quantization_input_mode)"/>
    <arg name="gnss_quantization_step_deg" value="$(arg gnss_quantization_step_deg)"/>
    <arg name="map_frame" value="$(arg map_frame)"/>
    <arg name="morai_map_frame" value="$(arg morai_map_frame)"/>
    <arg name="base_frame" value="$(arg base_frame)"/>
    <arg name="publish_control_state" value="$(arg publish_control_state)"/>
    <arg name="use_quantized_gnss_control_state"
         value="$(arg use_quantized_gnss_control_state)"/>
    <arg name="control_state_topic" value="$(arg control_state_topic)"/>
    <arg name="control_translation_tau_sec"
         value="$(arg control_translation_tau_sec)"/>
    <arg name="control_yaw_tau_sec" value="$(arg control_yaw_tau_sec)"/>
    <arg name="control_state_use_vehicle_pivot"
         value="$(arg control_state_use_vehicle_pivot)"/>
    <arg name="control_lateral_tau_sec" value="$(arg control_lateral_tau_sec)"/>
    <arg name="control_max_lateral_correction_rate_mps"
         value="$(arg control_max_lateral_correction_rate_mps)"/>
    <arg name="quantized_control_yaw_tau_sec"
         value="$(arg quantized_control_yaw_tau_sec)"/>
    <arg name="control_state_reset_translation_error_m"
         value="$(arg control_state_reset_translation_error_m)"/>
    <arg name="control_state_reset_yaw_error_deg"
         value="$(arg control_state_reset_yaw_error_deg)"/>
    <arg name="enable_relocation_guard" value="$(arg enable_relocation_guard)"/>
    <arg name="relocation_guard_monitor_only" value="$(arg relocation_guard_monitor_only)"/>
    <arg name="relocation_guard_threshold_m" value="$(arg relocation_guard_threshold_m)"/>
    <arg name="relocation_guard_consecutive_samples" value="$(arg relocation_guard_consecutive_samples)"/>
    <arg name="relocation_guard_cooldown_sec" value="$(arg relocation_guard_cooldown_sec)"/>
  </include>
</launch>
