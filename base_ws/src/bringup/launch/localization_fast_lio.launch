<launch>
  <!--
    Legacy/research FAST-LIO localization stack for MORAI.

    This is retained for experiment reproduction and is not the competition
    production provider.

    TF output:
      map -> morai_map -> camera_init -> body -> base_link

    Do not run localization_morai_gt.launch at the same time. Its
    morai_map -> base_link edge would give base_link a second parent.
    MORAI bridge and sensing are intentionally launched separately.
  -->
  <arg name="use_sim_time" default="false"/>
  <arg name="repo_root" default="$(env AJOUNICE_ROOT)"/>
  <arg name="fast_lio_config"
       default="$(arg repo_root)/configs/localization/fast_lio_morai_sensor4_vlp16.yaml"/>
  <arg name="localization_manager_config"
       default="$(arg repo_root)/configs/localization/localization_manager.yaml"/>

  <arg name="map_frame" default="map"/>
  <arg name="morai_map_frame" default="morai_map"/>
  <arg name="start_lanelet_map" default="true"/>
  <arg name="map_file"
       default="$(arg repo_root)/kcity_map/lanelet_map/lanelet2_map_v68.osm"/>
  <arg name="projector_file"
       default="$(arg repo_root)/kcity_map/lanelet_map/map_projector_info_v1.yaml"/>
  <arg name="map_projector_type" default="LocalCartesianUTM"/>

  <include file="$(find tf_pub)/launch/map_tf.launch">
    <arg name="parent_frame" value="$(arg map_frame)"/>
    <arg name="child_frame" value="$(arg morai_map_frame)"/>
  </include>

  <include file="$(find bringup)/launch/fast_lio_morai.launch">
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="config" value="$(arg fast_lio_config)"/>
  </include>

  <include file="$(find localization_manager)/launch/fast_lio.launch">
    <arg name="config" value="$(arg localization_manager_config)"/>
  </include>

  <group if="$(arg start_lanelet_map)">
    <include file="$(find lanelet_map_visualizer)/launch/kcity_lanelet_map.launch">
      <arg name="map_file" value="$(arg map_file)"/>
      <arg name="projector_file" value="$(arg projector_file)"/>
      <arg name="projector_type" value="$(arg map_projector_type)"/>
      <arg name="frame_id" value="$(arg map_frame)"/>
      <arg name="output_topic" value="/map/lanelet_map"/>
      <arg name="publish_lanelet_fill" value="false"/>
    </include>
  </group>
</launch>
