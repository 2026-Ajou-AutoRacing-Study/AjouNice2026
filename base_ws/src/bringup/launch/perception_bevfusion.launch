<launch>
  <!-- Top-level host launch for MORAI four-camera BEVFusion visualization. -->
  <arg name="sensor_config"
       default="$(find bringup)/../../../configs/sensors/Sensor.json"/>
  <arg name="config"
       default="$(find bringup)/../../../configs/perception/bevfusion_sensor4.yaml"/>
  <arg name="projection_only" default="false"/>
  <arg name="start_rviz" default="true"/>

  <group if="$(arg projection_only)">
    <include file="$(find bevfusion_ros)/launch/projection_check.launch">
      <arg name="sensor_config" value="$(arg sensor_config)"/>
      <arg name="config" value="$(arg config)"/>
      <arg name="start_rviz" value="$(arg start_rviz)"/>
    </include>
  </group>
  <group unless="$(arg projection_only)">
    <include file="$(find bevfusion_ros)/launch/zero_shot.launch">
      <arg name="sensor_config" value="$(arg sensor_config)"/>
      <arg name="config" value="$(arg config)"/>
      <arg name="start_rviz" value="$(arg start_rviz)"/>
    </include>
  </group>
</launch>

