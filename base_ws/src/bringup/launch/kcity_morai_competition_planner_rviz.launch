<launch>
  <arg name="map_file"
       default="$(env AJOUNICE_ROOT)/kcity_map/lanelet_map/lanelet2_map_v44.osm" />
  <arg name="projector_file"
       default="$(env AJOUNICE_ROOT)/kcity_map/lanelet_map/map_projector_info_v1.yaml" />
  <arg name="map_projector_type" default="LocalCartesianUTM" />
  <arg name="frame_id" default="map" />
  <arg name="route_preset" default="full" />
  <arg name="planning_hz" default="10.0" />
  <arg name="default_velocity_mps" default="4.1666665" />
  <arg name="forward_path_length" default="300.0" />
  <arg name="mission_publish_rate" default="5.0" />
  <arg name="route_lane_ids" default="[]" />
  <arg name="enable_path_smoother_debug" default="false" />
  <arg name="enable_path_optimizer_debug" default="false" />
  <arg name="mvp_extract_ahead_dist" default="200.0" />
  <arg name="mvp_extract_behind_dist" default="0.0" />
  <arg name="launch_rviz" default="true" />
  <arg name="start_route_publisher" default="true" />
  <arg name="start_map_visualizer" default="true" />
  <arg name="software_rendering" default="1" />

  <include file="$(find mission_planner)/launch/mission_planner.launch">
    <arg name="frame_id" value="$(arg frame_id)" />
    <arg name="publish_rate" value="$(arg mission_publish_rate)" />
    <arg name="map_file" value="$(arg map_file)" />
    <arg name="projector_file" value="$(arg projector_file)" />
    <arg name="map_projector_type" value="$(arg map_projector_type)" />
    <arg name="route_lane_ids" value="$(arg route_lane_ids)" />
  </include>

  <include file="$(find behavior_path_planner)/launch/behavior_path_planner.launch">
    <arg name="frame_id" value="$(arg frame_id)" />
    <arg name="planning_hz" value="$(arg planning_hz)" />
    <arg name="default_velocity_mps" value="$(arg default_velocity_mps)" />
    <arg name="forward_path_length" value="$(arg forward_path_length)" />
    <arg name="map_file" value="$(arg map_file)" />
    <arg name="projector_file" value="$(arg projector_file)" />
    <arg name="map_projector_type" value="$(arg map_projector_type)" />
    <arg name="require_lane_driving_scenario" value="true" />
    <arg name="enable_goal_planner" value="false" />
    <arg name="enable_side_shift" value="false" />
  </include>

  <include file="$(find behavior_velocity_planner)/launch/behavior_velocity_planner.launch">
    <arg name="projector_file" value="$(arg projector_file)" />
    <arg name="map_projector_type" value="$(arg map_projector_type)" />
  </include>

  <include file="$(find autoware_path_smoother)/launch/elastic_band_smoother.launch">
    <arg name="output_path_topic" value="/planning/scenario_planning/lane_driving/motion_planning/path_smoother/path" />
    <arg name="output_trajectory_topic" value="/planning/scenario_planning/lane_driving/motion_planning/path_smoother/trajectory" />
    <arg name="enable_debug_info" value="$(arg enable_path_smoother_debug)" />
  </include>

  <include file="$(find autoware_path_optimizer)/launch/path_optimizer.launch">
    <arg name="enable_debug_info" value="$(arg enable_path_optimizer_debug)" />
  </include>

  <include file="$(find motion_velocity_planner)/launch/motion_velocity_planner.launch">
    <arg name="default_velocity_mps" value="$(arg default_velocity_mps)" />
    <arg name="cruise_speed_mps" value="$(arg default_velocity_mps)" />
    <arg name="extract_ahead_dist" value="$(arg mvp_extract_ahead_dist)" />
    <arg name="extract_behind_dist" value="$(arg mvp_extract_behind_dist)" />
  </include>

  <group if="$(arg start_map_visualizer)">
    <include file="$(find lanelet_map_visualizer)/launch/kcity_lanelet_map.launch">
      <arg name="map_file" value="$(arg map_file)" />
      <arg name="projector_file" value="$(arg projector_file)" />
      <arg name="projector_type" value="$(arg map_projector_type)" />
      <arg name="frame_id" value="$(arg frame_id)" />
      <arg name="output_topic" value="/map/lanelet_map" />
      <arg name="publish_lanelet_fill" value="false" />
    </include>
  </group>

  <node pkg="mission_planner"
        type="mission_planner_rviz_input.py"
        name="mission_planner_rviz_input"
        output="screen">
    <param name="frame_id" value="$(arg frame_id)" />
    <param name="max_velocity" value="$(arg default_velocity_mps)" />
    <param name="allow_modification" value="false" />
    <param name="publish_static_odometry" value="false" />
  </node>

  <group if="$(arg start_route_publisher)">
    <node pkg="bringup"
          type="kcity_competition_live_route_publisher.py"
          name="kcity_competition_live_route_publisher"
          output="screen">
      <param name="map_file" value="$(arg map_file)" />
      <param name="projector_file" value="$(arg projector_file)" />
      <param name="map_projector_type" value="$(arg map_projector_type)" />
      <param name="keep_alive" value="true" />
    </node>
  </group>

  <node pkg="bringup"
        type="planning_trajectory_visualizer.py"
        name="planning_trajectory_visualizer"
        output="screen">
    <param name="input_topic"
           value="/planning/scenario_planning/lane_driving/motion_planning/motion_velocity_planner/trajectory" />
    <param name="path_topic" value="/planning/debug/final_trajectory/path" />
    <param name="marker_topic" value="/planning/debug/final_trajectory/markers" />
    <param name="nominal_velocity_mps" value="$(arg default_velocity_mps)" />
  </node>

  <node pkg="viewer"
        type="current_vehicle_marker.py"
        name="current_vehicle_marker"
        output="screen">
    <param name="input_topic" value="/localization/kinematic_state" />
    <param name="output_topic" value="/viewer/current_vehicle_marker" />
  </node>

  <node if="$(arg launch_rviz)"
        pkg="rviz"
        type="rviz"
        name="kcity_morai_competition_planner_rviz"
        args="-d $(find bringup)/rviz/kcity_morai_competition_planner.yaml"
        output="screen">
    <env name="LIBGL_ALWAYS_SOFTWARE" value="$(arg software_rendering)" />
  </node>
</launch>
