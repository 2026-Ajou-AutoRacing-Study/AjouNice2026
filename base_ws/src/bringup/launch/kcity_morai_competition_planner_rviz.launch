<launch>
  <arg name="frame_id" default="map" />
  <arg name="planning_hz" default="10.0" />
  <arg name="default_velocity_mps" default="4.1666665" />
  <arg name="forward_path_length" default="300.0" />
  <arg name="mvp_extract_ahead_dist" default="200.0" />
  <arg name="mvp_extract_behind_dist" default="0.0" />
  <arg name="launch_rviz" default="true" />
  <arg name="software_rendering" default="1" />

  <include file="$(find bringup)/launch/mission_bpp_bvp_path_smoother_path_optimizer_mvp_pipeline.launch">
    <arg name="frame_id" value="$(arg frame_id)" />
    <arg name="planning_hz" value="$(arg planning_hz)" />
    <arg name="default_velocity_mps" value="$(arg default_velocity_mps)" />
    <arg name="forward_path_length" value="$(arg forward_path_length)" />
    <arg name="projector_file" value="$(find lanelet_map_visualizer)/../../../kcity_map/lanelet_map/map_projector_info_v1.yaml" />
    <arg name="map_projector_type" value="LocalCartesianUTM" />
    <arg name="route_lane_ids" value="[]" />
    <arg name="require_lane_driving_scenario" value="true" />
    <arg name="enable_goal_planner" value="false" />
    <arg name="enable_side_shift" value="false" />
    <arg name="mvp_velocity_mps" value="$(arg default_velocity_mps)" />
    <arg name="mvp_extract_ahead_dist" value="$(arg mvp_extract_ahead_dist)" />
    <arg name="mvp_extract_behind_dist" value="$(arg mvp_extract_behind_dist)" />
  </include>

  <node pkg="mission_planner"
        type="mission_planner_rviz_input.py"
        name="mission_planner_rviz_input"
        output="screen">
    <param name="frame_id" value="$(arg frame_id)" />
    <param name="max_velocity" value="$(arg default_velocity_mps)" />
    <param name="allow_modification" value="false" />
    <param name="publish_static_odometry" value="false" />
  </node>

  <node pkg="bringup"
        type="planning_trajectory_visualizer.py"
        name="planning_trajectory_visualizer"
        output="screen">
    <param name="input_topic"
           value="/planning/scenario_planning/lane_driving/motion_planning/motion_velocity_planner/trajectory" />
    <param name="path_topic" value="/planning/debug/final_trajectory/path" />
    <param name="marker_topic" value="/planning/debug/final_trajectory/markers" />
    <param name="nominal_velocity_mps" value="$(arg default_velocity_mps)" />
  </node>

  <node pkg="viewer"
        type="current_vehicle_marker.py"
        name="current_vehicle_marker"
        output="screen">
    <param name="input_topic" value="/localization/kinematic_state" />
    <param name="output_topic" value="/viewer/current_vehicle_marker" />
  </node>

  <node if="$(arg launch_rviz)"
        pkg="rviz"
        type="rviz"
        name="kcity_morai_competition_planner_rviz"
        args="-d $(find bringup)/rviz/kcity_morai_competition_planner.yaml"
        output="screen">
    <env name="LIBGL_ALWAYS_SOFTWARE" value="$(arg software_rendering)" />
  </node>
</launch>
