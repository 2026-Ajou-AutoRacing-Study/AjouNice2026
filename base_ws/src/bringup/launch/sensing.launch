<launch>
  <!-- Sensor static TFs and vehicle visualization. UDP runs separately. -->
  <arg name="enable_sensor_tf" default="true"/>
  <arg name="enable_ego_tf" default="false"/>
  <arg name="enable_vehicle_model" default="true"/>
  <arg name="start_rviz" default="false"/>

  <arg name="sensor_config"
       default="$(find ioniq5)/../../../configs/sensors/Sensor_4.json"/>
  <arg name="sensor_parent_frame" default="base_link"/>
  <arg name="publish_lidar_tf" default="true"/>
  <arg name="publish_imu_tf" default="true"/>
  <arg name="publish_camera_tf" default="true"/>
  <arg name="publish_gps_tf" default="true"/>

  <group if="$(arg enable_sensor_tf)">
    <include file="$(find tf_pub)/launch/sensor_tf.launch">
      <arg name="sensor_config" value="$(arg sensor_config)"/>
      <arg name="parent_frame" value="$(arg sensor_parent_frame)"/>
      <arg name="publish_lidar" value="$(arg publish_lidar_tf)"/>
      <arg name="publish_imu" value="$(arg publish_imu_tf)"/>
      <arg name="publish_camera" value="$(arg publish_camera_tf)"/>
      <arg name="publish_gps" value="$(arg publish_gps_tf)"/>
    </include>
  </group>

  <group if="$(arg enable_ego_tf)">
    <include file="$(find tf_pub)/launch/ego_tf.launch"/>
  </group>

  <group if="$(arg enable_vehicle_model)">
    <include file="$(find ioniq5)/launch/display_ioniq5.launch">
      <arg name="start_rviz" value="$(arg start_rviz)"/>
    </include>
  </group>
</launch>
