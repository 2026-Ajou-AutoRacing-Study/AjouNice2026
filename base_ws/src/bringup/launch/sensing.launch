<launch>
  <!-- Sensing stack: LiDAR, sensor static TFs, and vehicle model. -->
  <arg name="enable_lidar" default="true"/>
  <arg name="enable_lidar_udp" default="true"/>
  <arg name="enable_lidar_preprocess" default="true"/>
  <arg name="enable_camera_udp" default="true"/>
  <arg name="enable_sensor_static_tf" default="true"/>
  <arg name="enable_vehicle_model" default="true"/>
  <arg name="start_rviz" default="true"/>

  <arg name="calibration" default="$(find velodyne_pointcloud)/params/32db.yaml"/>
  <arg name="lidar_preprocess_config" default="$(find sensor_interface)/config/lidar_preprocess.yaml"/>
  <arg name="camera_udp_config" default="$(find sensor_interface)/config/camera_udp.yaml"/>
  <arg name="camera_udp_name" default="front"/>
  <arg name="sensor_config" default="$(find ioniq5)/../../../configs/sensors/Sensor_1.json"/>
  <arg name="sensor_parent_frame" default="base_link"/>
  <arg name="publish_lidar_tf" default="true"/>
  <arg name="publish_imu_tf" default="true"/>
  <arg name="publish_camera_tf" default="true"/>
  <arg name="publish_gps_tf" default="true"/>

  <group if="$(arg enable_lidar)">
    <include file="$(find sensor_interface)/launch/lidar.launch">
      <arg name="calibration" value="$(arg calibration)"/>
      <arg name="enable_lidar_udp" value="$(arg enable_lidar_udp)"/>
    </include>
  </group>

  <group if="$(arg enable_camera_udp)">
    <include file="$(find sensor_interface)/launch/camera_udp.launch">
      <arg name="camera_config" value="$(arg camera_udp_config)"/>
      <arg name="camera_name" value="$(arg camera_udp_name)"/>
    </include>
  </group>

  <group if="$(arg enable_sensor_static_tf)">
    <include file="$(find tf_pub)/launch/sensor_tf.launch">
      <arg name="sensor_config" value="$(arg sensor_config)"/>
      <arg name="parent_frame" value="$(arg sensor_parent_frame)"/>
      <arg name="publish_lidar" value="$(arg publish_lidar_tf)"/>
      <arg name="publish_imu" value="$(arg publish_imu_tf)"/>
      <arg name="publish_camera" value="$(arg publish_camera_tf)"/>
      <arg name="publish_gps" value="$(arg publish_gps_tf)"/>
    </include>
  </group>

  <group if="$(arg enable_lidar_preprocess)">
    <include file="$(find sensor_interface)/launch/lidar_preprocess.launch">
      <arg name="config" value="$(arg lidar_preprocess_config)"/>
    </include>
  </group>

