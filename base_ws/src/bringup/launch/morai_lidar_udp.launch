<launch>
  <!--
    Receive MORAI HDL32 LiDAR UDP packets directly and publish PointCloud2.
    MORAI Sensor_1.json should keep the LiDAR commType at 1 (UDP).
  -->

  <arg name="calibration" default="$(find velodyne_pointcloud)/params/32db.yaml"/>
  <arg name="publish_static_tf" default="true"/>
  <arg name="publish_morai_map_tf" default="true"/>
  <arg name="enable_lidar_concat" default="true"/>
  <arg name="lidar_concat_config" default="$(find sensor_interface)/config/lidar_concat.yaml"/>

  <group if="$(arg publish_morai_map_tf)">
    <include file="$(find bringup)/launch/morai_map_static_tf.launch"/>
  </group>

  <group if="$(arg publish_static_tf)">
    <include file="$(find ioniq5)/launch/sensor_static_tf.launch">
      <arg name="publish_lidar" value="true"/>
      <arg name="publish_imu" value="true"/>
      <arg name="publish_gps" value="true"/>
    </include>
  </group>

  <group ns="lidar1">
    <node pkg="nodelet"
          type="nodelet"
          name="lidar1_nodelet_manager"
          args="manager"
          output="screen"/>

    <node pkg="nodelet"
          type="nodelet"
          name="lidar1_driver"
          args="load velodyne_driver/DriverNodelet lidar1_nodelet_manager">
      <param name="device_ip" value=""/>
      <param name="frame_id" value="lidar1"/>
      <param name="model" value="32E"/>
      <param name="pcap" value=""/>
      <param name="port" value="2368"/>
      <param name="read_fast" value="false"/>
      <param name="read_once" value="false"/>
      <param name="repeat_delay" value="0.0"/>
      <param name="rpm" value="1200.0"/>
      <param name="gps_time" value="false"/>
      <param name="pcap_time" value="false"/>
      <param name="cut_angle" value="-0.01"/>
      <param name="timestamp_first_packet" value="false"/>
      <remap from="velodyne_packets" to="/sensor/lidar1/packets"/>
    </node>

    <node pkg="nodelet"
          type="nodelet"
          name="lidar1_transform"
          args="load velodyne_pointcloud/TransformNodelet lidar1_nodelet_manager">
      <param name="model" value="32E"/>
      <param name="calibration" value="$(arg calibration)"/>
      <param name="fixed_frame" value=""/>
      <param name="target_frame" value=""/>
      <param name="max_range" value="130.0"/>
      <param name="min_range" value="0.4"/>
      <param name="organize_cloud" value="false"/>
      <remap from="velodyne_packets" to="/sensor/lidar1/packets"/>
      <remap from="velodyne_points" to="/sensor/lidar1"/>
    </node>
  </group>

  <group ns="lidar2">
    <node pkg="nodelet"
          type="nodelet"
          name="lidar2_nodelet_manager"
          args="manager"
          output="screen"/>

    <node pkg="nodelet"
          type="nodelet"
          name="lidar2_driver"
          args="load velodyne_driver/DriverNodelet lidar2_nodelet_manager">
      <param name="device_ip" value=""/>
      <param name="frame_id" value="lidar2"/>
      <param name="model" value="32E"/>
      <param name="pcap" value=""/>
      <param name="port" value="2370"/>
      <param name="read_fast" value="false"/>
      <param name="read_once" value="false"/>
      <param name="repeat_delay" value="0.0"/>
      <param name="rpm" value="1200.0"/>
      <param name="gps_time" value="false"/>
      <param name="pcap_time" value="false"/>
      <param name="cut_angle" value="-0.01"/>
      <param name="timestamp_first_packet" value="false"/>
      <remap from="velodyne_packets" to="/sensor/lidar2/packets"/>
    </node>

    <node pkg="nodelet"
          type="nodelet"
          name="lidar2_transform"
          args="load velodyne_pointcloud/TransformNodelet lidar2_nodelet_manager">
      <param name="model" value="32E"/>
      <param name="calibration" value="$(arg calibration)"/>
      <param name="fixed_frame" value=""/>
      <param name="target_frame" value=""/>
      <param name="max_range" value="130.0"/>
      <param name="min_range" value="0.4"/>
      <param name="organize_cloud" value="false"/>
      <remap from="velodyne_packets" to="/sensor/lidar2/packets"/>
      <remap from="velodyne_points" to="/sensor/lidar2"/>
    </node>
  </group>

  <group if="$(arg enable_lidar_concat)">
    <node pkg="sensor_interface"
          type="lidar_concat_filter"
          name="lidar_concat_filter"
          output="screen">
      <rosparam command="load" file="$(arg lidar_concat_config)"/>
    </node>
  </group>
</launch>
