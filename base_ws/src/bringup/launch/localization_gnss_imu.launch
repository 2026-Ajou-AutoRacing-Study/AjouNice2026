<launch>
  <!-- Standalone GNSS+IMU localization provider for live MORAI or rosbag replay. -->
  <arg name="use_sim_time" default="false"/>
  <arg name="repo_root" default="$(env AJOUNICE_ROOT)"/>
  <arg name="sensor_config"
       default="$(arg repo_root)/configs/sensors/Sensor.json"/>
  <arg name="measurement_noise_config"
       default="$(arg repo_root)/configs/localization/gnss_imu_noise_sensor6_ideal.yaml"/>
  <arg name="localization_manager_config"
       default="$(arg repo_root)/configs/localization/localization_manager.yaml"/>
  <arg name="local_ekf_config"
       default="$(arg repo_root)/configs/localization/robot_localization_gnss_imu_local.yaml"/>
  <arg name="global_ekf_config"
       default="$(arg repo_root)/configs/localization/robot_localization_gnss_imu_global.yaml"/>
  <arg name="publish_sensor_tf" default="true"/>

  <arg name="map_frame" default="map"/>
  <arg name="morai_map_frame" default="morai_map"/>
  <arg name="base_frame" default="base_link"/>

  <param name="/use_sim_time" value="$(arg use_sim_time)"/>

  <include file="$(find tf_pub)/launch/map_tf.launch">
    <arg name="parent_frame" value="$(arg map_frame)"/>
    <arg name="child_frame" value="$(arg morai_map_frame)"/>
  </include>

  <group if="$(arg publish_sensor_tf)">
    <include file="$(find tf_pub)/launch/sensor_tf.launch">
      <arg name="sensor_config" value="$(arg sensor_config)"/>
      <arg name="parent_frame" value="$(arg base_frame)"/>
      <arg name="publish_lidar" value="false"/>
      <arg name="publish_imu" value="true"/>
      <arg name="publish_camera" value="false"/>
      <arg name="publish_gps" value="true"/>
    </include>
  </group>

  <include file="$(find localization_manager)/launch/gnss_imu.launch">
    <arg name="sensor_config" value="$(arg sensor_config)"/>
    <arg name="config" value="$(arg localization_manager_config)"/>
    <arg name="measurement_noise_config"
         value="$(arg measurement_noise_config)"/>
    <arg name="local_ekf_config" value="$(arg local_ekf_config)"/>
    <arg name="global_ekf_config" value="$(arg global_ekf_config)"/>
    <arg name="map_frame" value="$(arg map_frame)"/>
    <arg name="morai_map_frame" value="$(arg morai_map_frame)"/>
    <arg name="base_frame" value="$(arg base_frame)"/>
  </include>
</launch>
