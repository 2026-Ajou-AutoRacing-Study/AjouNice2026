<launch>
  <!--
    Deprecated compatibility alias.
    Use: roslaunch bringup localization_morai_gt.launch
  -->
  <arg name="use_sim_time" default="false"/>
  <arg name="repo_root" default="$(env AJOUNICE_ROOT)"/>
  <arg name="ego_topic" default="/Ego_topic"/>
  <arg name="map_frame" default="map"/>
  <arg name="morai_map_frame" default="morai_map"/>
  <arg name="base_frame" default="base_link"/>
  <arg name="heading_in_degrees" default="true"/>
  <arg name="start_lanelet_map" default="false"/>
  <arg name="map_file"
       default="$(arg repo_root)/kcity_map/lanelet_map/lanelet2_map_v81.osm"/>
  <arg name="projector_file"
       default="$(arg repo_root)/kcity_map/lanelet_map/map_projector_info_v1.yaml"/>
  <arg name="map_projector_type" default="LocalCartesianUTM"/>

  <include file="$(find bringup)/launch/localization_morai_gt.launch">
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="ego_topic" value="$(arg ego_topic)"/>
    <arg name="map_frame" value="$(arg map_frame)"/>
    <arg name="morai_map_frame" value="$(arg morai_map_frame)"/>
    <arg name="base_frame" value="$(arg base_frame)"/>
    <arg name="heading_in_degrees" value="$(arg heading_in_degrees)"/>
    <arg name="start_lanelet_map" value="$(arg start_lanelet_map)"/>
    <arg name="map_file" value="$(arg map_file)"/>
    <arg name="projector_file" value="$(arg projector_file)"/>
    <arg name="map_projector_type" value="$(arg map_projector_type)"/>
  </include>
</launch>
