<launch>
  <!--
    Live MORAI simulator Ego map TF before the real localization stack is ready.

    Input:
      /Ego_topic.position and /Ego_topic.heading received live from MORAI.
      EgoVehicleStatus has no latitude/longitude; GPS-based conversion belongs
      in maptf.launch.

    Output TF:
      map -> morai_map        static Lanelet-to-MORAI map alignment
      morai_map -> base_link  dynamic live ego pose

    Run only one of maptf.launch, maptf_morai.launch, maptf_morai_bag.launch,
    or map_tf.launch at a time. They publish the same ego/map TF edge.
  -->
  <arg name="ego_topic" default="/Ego_topic"/>
  <arg name="odom_topic" default="/localization/odom"/>
  <arg name="map_frame" default="map"/>
  <arg name="morai_map_frame" default="morai_map"/>
  <arg name="base_frame" default="base_link"/>

  <include file="$(find sensor_interface)/launch/map_static_tf.launch">
    <arg name="parent_frame" value="$(arg map_frame)"/>
    <arg name="child_frame" value="$(arg morai_map_frame)"/>
  </include>

  <include file="$(find morai_ros_bridge)/launch/ego_to_odom.launch">
    <arg name="ego_topic" value="$(arg ego_topic)"/>
    <arg name="odom_topic" value="$(arg odom_topic)"/>
    <arg name="frame_id" value="$(arg morai_map_frame)"/>
    <arg name="child_frame_id" value="$(arg base_frame)"/>
    <arg name="publish_tf" value="true"/>
  </include>
</launch>
