<launch>
  <!-- configs/sensors/Sensor_*.json 기준 확인된 실제 토픽 (CompressedImage) -->
  <arg name="image_topic" default="/sensor/camera/front/compressed" />
  <arg name="models_root" default="$(env HOME)/.local/share/ajounice/traffic_light_models/v5_3d29ee7f" />
  <arg name="weights_path" default="$(arg models_root)/yolo_final/selected.pt" />
  <!-- Keep the threshold validated by the traffic-light team. -->
  <arg name="conf" default="0.25" />
  <!-- Only the inference node uses this Python. Lanelet map matching remains
       on ROS Noetic's /usr/bin/python3 in a sibling process. -->
  <arg name="inference_python" default="$(env HOME)/.local/share/ajounice/traffic_light_gpu/bin/python" />
  <!-- User-selected v5 default. Legacy rollback has its own explicit wrapper. -->
  <arg name="isolate_python" default="true" />
  <arg name="device" default="0" />
  <arg name="detector_imgsz" default="960" />
  <!-- One full-frame 640 retry only after a near/large current map-head miss. -->
  <arg name="near_rescue_enabled" default="true" />
  <arg name="planner_compliance_observations" default="true" />
  <!-- Production direct-observation companion to the planner's bounded grace.
       Known colors remain UNKNOWN shape/status; never invent a direction grant. -->
  <arg name="preserve_unreadable_color_evidence" default="$(arg planner_compliance_observations)" />
  <!-- Experiment only: 0 leaves production unchanged; 3/7 use 2/4 raw,
       distinct, current-qualified same-group observations. Age caps: .5/.9s. -->
  <arg name="stamped_vote_window_size" default="0" />
  <arg name="stamped_vote_max_age_sec" default="0.5" />
  <!-- Explicit legacy-style warmup only; does not enable profile corrections. -->
  <arg name="stamped_vote_startup_passthrough" default="false" />
  <!-- Detector-only same-housing dropout budget, measured from ORIGINAL image. -->
  <arg name="detection_miss_hold_sec" default="0.2" />
  <!-- Matched moving head's soft CNN abstention only; 0 disables. -->
  <arg name="low_confidence_hold_sec" default="0.3" />
  <arg name="no_lamps_hold_sec" default="0.2" />
  <arg name="visual_continuation_sec" default="0.3" />
  <!-- Preserve the traffic-light team's validated decision cadence. GPU
       execution reduces compute load; it must not silently retune semantics. -->
  <arg name="max_rate_hz" default="10.0" />
  <!-- Default promotion is not a full-route qualification claim. -->
  <arg name="selection_mode" default="map_association" />
  <arg name="classifier_mode" default="cnn" />
  <!-- Camera-to-housing forward depth, NOT distance to a stop line.
       User-selected ABC40/D30; legacy/unguarded modes keep their old behavior. -->
  <arg name="observation_start_depth_m" default="$(eval 40.0 if arg('selection_mode') == 'map_association' and str(arg('planner_compliance_observations')).lower() == 'true' else 0.0)" />
  <arg name="observation_start_depth_d_m" default="$(eval 30.0 if float(arg('observation_start_depth_m')) > 0 else 0.0)" />
  <arg name="cnn_checkpoint_path" default="$(arg models_root)/cnn_v5/best.pt" />
  <arg name="cnn_device" default="$(eval 'cpu' if str(arg('device')) == 'cpu' else 'cuda:' + str(arg('device')))" />
  <arg name="cnn_min_bit_confidence" default="0.6" />
  <arg name="cnn_crop_margin_px" default="12" />
  <arg name="output_topic" default="/perception/traffic_light_recognition/traffic_signals" />
  <arg name="map_roi_topic" default="/perception/traffic_light_recognition/map_rois" />
  <arg name="map_geometry_path" default="$(find traffic_light_detection)/config/traffic_light_map_geometry.json" />
  <arg name="sensor_config" default="$(env AJOUNICE_ROOT)/configs/sensors/Sensor_competition_local.json" />
  <arg name="map_base_margin_px" default="12.0" />
  <arg name="map_pitch_tolerance_degrees" default="1.0" />
  <arg name="map_max_padding_px" default="120.0" />
  <arg name="map_max_vertical_padding_px" default="200.0" />
  <arg name="map_min_aspect_ratio_factor" default="0.4" />
  <arg name="map_max_aspect_ratio_factor" default="2.5" />
  <arg name="map_max_position_sigma_m" default="1.5" />
  <arg name="map_max_vertical_sigma_m" default="1.5" />
  <arg name="map_max_yaw_sigma_degrees" default="4.0" />
  <arg name="map_max_view_angle_degrees" default="45.0" />
  <arg name="map_min_height_px" default="3.0" />
  <arg name="map_packet_max_image_delta_sec" default="0.0" />
  <arg name="map_packet_wait_sec" default="0.03" />

  <arg name="publish_debug_image" default="false" />
  <arg name="debug_jpeg_quality" default="60" />

  <!-- ===== 화살표 템플릿 수집용 (임시 디버그 기능, 비어있으면 비활성) ===== -->
  <arg name="debug_save_crop_dir" default="" />

  <!-- ===== 단발성 오검출/미검출 스무딩 (큐 기반 과반수 투표) ===== -->
  <arg name="smoothing_window_size" default="7" />
  <arg name="smoothing_majority_count" default="4" />

  <!-- ===== group_id 매칭: route 기반(1순위, v3, 정석 Autoware 방식) ===== -->
  <arg name="enable_route_matching" default="true" />
  <arg name="route_progress_guard" default="true" />
  <arg name="repo_root" default="$(env AJOUNICE_ROOT)" />
  <arg name="group_id_table_path"
       default="$(find traffic_light_detection)/traffic_light_group_id_table.json" />
  <arg name="signal_profile_path"
       default="$(env AJOUNICE_ROOT)/base_ws/src/perception/traffic_light_detection/config/traffic_signal_profiles.yaml" />
  <arg name="fallback_group_id" default="0" />
  <arg name="map_version" default="101" />
  <!-- Released runtime accepts only v101; reject old explicit overrides at parse time. -->
  <arg name="_require_v101_map_version" value="$(eval {'101': 'v101-only'}[str(arg('map_version'))])"/>
  <arg name="lanelet2_map_file"
       default="$(arg repo_root)/kcity_map/lanelet_map/lanelet2_map_v$(arg map_version).osm" />
  <arg name="_require_v101_map_file" value="$(eval {True: 'v101-only'}[arg('lanelet2_map_file') == arg('repo_root') + '/kcity_map/lanelet_map/lanelet2_map_v101.osm'])"/>
  <arg name="lanelet2_projector_file"
       default="$(arg repo_root)/kcity_map/lanelet_map/map_projector_info_v1.yaml" />
  <arg name="lanelet2_projector_type" default="LocalCartesianUTM" />
  <arg name="route_topic" default="/planning/mission_planning/route" />
  <arg name="route_state_topic" default="/planning/route_state" />
  <arg name="odometry_topic" default="/localization/kinematic_state" />
  <arg name="route_group_id_topic"
       default="/perception/traffic_light_recognition/route_group_id" />
  <arg name="route_group_id_stale_sec" default="2.0" />

  <!-- lanelet2 is a ROS Noetic/Python 3.8 binding. Keep it outside the GPU
       Python 3.11 process and publish only the selected group ID. -->
  <group if="$(arg enable_route_matching)">
    <node pkg="traffic_light_detection"
          type="traffic_light_route_group_id_node.py"
          name="traffic_light_route_group_id"
          launch-prefix="/usr/bin/python3"
          output="screen">
      <param name="lanelet2_map_file" value="$(arg lanelet2_map_file)" />
      <param name="lanelet2_projector_file" value="$(arg lanelet2_projector_file)" />
      <param name="lanelet2_projector_type" value="$(arg lanelet2_projector_type)" />
      <param name="group_id_table_path" value="$(arg group_id_table_path)" />
      <param name="route_topic" value="$(arg route_topic)" />
      <param name="route_state_topic" value="$(arg route_state_topic)" />
      <param name="odometry_topic" value="$(arg odometry_topic)" />
      <param name="route_progress_guard" value="$(arg route_progress_guard)" />
      <rosparam if="$(arg route_progress_guard)" command="load"
                file="$(find traffic_light_detection)/config/traffic_signal_judging_lines.yaml"/>
      <param name="output_topic" value="$(arg route_group_id_topic)" />
      <!-- Map candidate skips old D-1 and all other non-mission rules while
           finding the NEXT light; legacy route-provider output is unchanged. -->
      <rosparam if="$(eval arg('selection_mode') == 'map_association')" param="allowed_group_ids">[201351, 201365, 201290, 201326]</rosparam>
      <rosparam unless="$(eval arg('selection_mode') == 'map_association')" param="allowed_group_ids">[]</rosparam>
    </node>
  </group>

  <!-- TF bindings remain in system Python; GPU Python consumes JSON projections.
       Only the actual existing TF is read, at camera image time. No broadcaster. -->
  <group if="$(eval arg('selection_mode') == 'map_association')">
    <node pkg="traffic_light_detection" type="traffic_light_map_roi_node.py"
          name="traffic_light_map_roi" launch-prefix="/usr/bin/python3" output="screen">
      <param name="geometry_path" value="$(arg map_geometry_path)" />
      <param name="sensor_config" value="$(arg sensor_config)" />
      <param name="image_topic" value="$(arg image_topic)" />
      <param name="odometry_topic" value="$(arg odometry_topic)" />
      <param name="route_group_id_topic" value="$(arg route_group_id_topic)" />
      <param name="route_group_id_stale_sec" value="$(arg route_group_id_stale_sec)" />
      <param name="visual_continuation_sec" value="$(arg visual_continuation_sec)" />
      <param name="output_topic" value="$(arg map_roi_topic)" />
      <param name="base_margin_px" value="$(arg map_base_margin_px)" />
      <param name="pitch_tolerance_degrees" value="$(arg map_pitch_tolerance_degrees)" />
      <param name="max_padding_px" value="$(arg map_max_padding_px)" />
      <param name="max_vertical_padding_px" value="$(arg map_max_vertical_padding_px)" />
      <param name="min_aspect_ratio_factor" value="$(arg map_min_aspect_ratio_factor)" />
      <param name="max_aspect_ratio_factor" value="$(arg map_max_aspect_ratio_factor)" />
      <param name="max_position_sigma_m" value="$(arg map_max_position_sigma_m)" />
      <param name="max_vertical_sigma_m" value="$(arg map_max_vertical_sigma_m)" />
      <param name="max_yaw_sigma_degrees" value="$(arg map_max_yaw_sigma_degrees)" />
      <param name="max_view_angle_degrees" value="$(arg map_max_view_angle_degrees)" />
      <param name="min_height_px" value="$(arg map_min_height_px)" />
    </node>
  </group>

  <node pkg="traffic_light_detection"
        type="traffic_light_node.py"
        name="traffic_light_node"
        launch-prefix="$(arg inference_python)"
        output="screen">
    <!-- Runtime uses a provisioned local checkpoint; never block startup on
         Ultralytics' Cloudflare/Google DNS connectivity probe. -->
    <env name="YOLO_OFFLINE" value="true" />
    <env name="TRAFFIC_LIGHT_ISOLATE_PYTHON" value="$(arg isolate_python)" />
    <env name="PYTHONNOUSERSITE" value="$(eval '1' if arg('isolate_python') else '')" />
    <env name="MPLCONFIGDIR" value="/tmp/matplotlib-traffic-light-gpu" />
    <env name="YOLO_CONFIG_DIR" value="/tmp" />
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="weights_path" value="$(arg weights_path)" />
    <param name="conf" value="$(arg conf)" />
    <param name="device" value="$(arg device)" />
    <param name="detector_imgsz" value="$(arg detector_imgsz)" />
    <param name="near_rescue_enabled" value="$(arg near_rescue_enabled)" />
    <param name="planner_compliance_observations" value="$(arg planner_compliance_observations)" />
    <param name="observation_start_depth_m" value="$(arg observation_start_depth_m)" type="double" />
    <param name="observation_start_depth_d_m" value="$(arg observation_start_depth_d_m)" type="double" />
    <param name="preserve_unreadable_color_evidence" value="$(arg preserve_unreadable_color_evidence)" type="bool" />
    <param name="stamped_vote_window_size" value="$(arg stamped_vote_window_size)" type="int" />
    <param name="stamped_vote_max_age_sec" value="$(arg stamped_vote_max_age_sec)" type="double" />
    <param name="stamped_vote_startup_passthrough" value="$(arg stamped_vote_startup_passthrough)" type="bool" />
    <param name="detection_miss_hold_sec" value="$(arg detection_miss_hold_sec)" />
    <param name="low_confidence_hold_sec" value="$(arg low_confidence_hold_sec)" />
    <param name="no_lamps_hold_sec" value="$(arg no_lamps_hold_sec)" />
    <param name="visual_continuation_sec" value="$(arg visual_continuation_sec)" />
    <param name="max_rate_hz" value="$(arg max_rate_hz)" />
    <param name="selection_mode" value="$(arg selection_mode)" />
    <param name="classifier_mode" value="$(arg classifier_mode)" />
    <param name="cnn_checkpoint_path" value="$(arg cnn_checkpoint_path)" />
    <param name="cnn_device" value="$(arg cnn_device)" />
    <param name="cnn_min_bit_confidence" value="$(arg cnn_min_bit_confidence)" />
    <param name="cnn_crop_margin_px" value="$(arg cnn_crop_margin_px)" />
    <param name="output_topic" value="$(arg output_topic)" />
    <param name="map_roi_topic" value="$(arg map_roi_topic)" />
    <param name="map_packet_max_image_delta_sec" value="$(arg map_packet_max_image_delta_sec)" />
    <param name="map_packet_wait_sec" value="$(arg map_packet_wait_sec)" />
    <param name="publish_debug_image" value="$(arg publish_debug_image)" />
    <param name="debug_jpeg_quality" value="$(arg debug_jpeg_quality)" />

    <param name="debug_save_crop_dir" value="$(arg debug_save_crop_dir)" />

    <param name="smoothing_window_size" value="$(arg smoothing_window_size)" />
    <param name="smoothing_majority_count" value="$(arg smoothing_majority_count)" />

    <!-- Route matching is supplied by the system-Python sibling above. -->
    <param name="enable_route_matching" value="false" />
    <param name="fallback_group_id" value="$(arg fallback_group_id)" />
    <param name="lanelet2_map_file" value="$(arg lanelet2_map_file)" />
    <param name="lanelet2_projector_file" value="$(arg lanelet2_projector_file)" />
    <param name="lanelet2_projector_type" value="$(arg lanelet2_projector_type)" />
    <param name="route_topic" value="$(arg route_topic)" />
    <param name="route_state_topic" value="$(arg route_state_topic)" />
    <param name="odometry_topic" value="$(arg odometry_topic)" />
    <param name="route_group_id_topic" value="$(arg route_group_id_topic)" />
    <param name="route_group_id_stale_sec" value="$(arg route_group_id_stale_sec)" />
    <param name="signal_profile_path" value="$(arg signal_profile_path)" />
  </node>
</launch>
