<launch>
  <!-- Compatibility alias. New deployments should use base3_online.launch. -->
  <arg name="sensor_config"
       default="$(find bevfusion_ros)/../../../../configs/sensors/Sensor.json"/>
  <arg name="config"
       default="$(find bevfusion_ros)/../../../../configs/perception/bevfusion_sensor4.yaml"/>
  <arg name="start_rviz" default="true"/>
  <arg name="score_threshold" default="0.10"/>
  <arg name="vehicle_score_threshold" default="0.40"/>
  <arg name="pedestrian_score_threshold" default="0.15"/>
  <arg name="obstacle_score_threshold" default="0.10"/>
  <include file="$(find bevfusion_ros)/launch/base3_online.launch">
    <arg name="sensor_config" value="$(arg sensor_config)"/>
    <arg name="config" value="$(arg config)"/>
    <arg name="start_rviz" value="$(arg start_rviz)"/>
    <arg name="score_threshold" value="$(arg score_threshold)"/>
    <arg name="vehicle_score_threshold" value="$(arg vehicle_score_threshold)"/>
    <arg name="pedestrian_score_threshold" value="$(arg pedestrian_score_threshold)"/>
    <arg name="obstacle_score_threshold" value="$(arg obstacle_score_threshold)"/>
  </include>
</launch>
