<launch>
  <!-- 2026-10-12 E24 development operating point, not an E25/production replacement.
       E24 SHA256: 84c7a849406a37f05250f872d4d0dfa3ebcffdb66b48e47bdfcb3209efecc746.
       Evidence: BASE5_INPUT_POOL_OPTIMIZATION_EVIDENCE section 40.
       Inference qualification uses AMP + parallel camera, compile OFF.
       Recalibrate after retraining; this is not a universal score policy. -->
  <arg name="sensor_config" default="$(find bevfusion_ros)/../../../../configs/sensors/legacy/Sensor_4.json"/>
  <arg name="config" default="$(find bevfusion_ros)/../../../../configs/perception/bevfusion_base5_trial.yaml"/>
  <arg name="output_objects" default="/perception/base5_trial/detection/objects"/>
  <arg name="vehicle_score_threshold" default="0.40"/>
  <arg name="pedestrian_score_threshold" default="0.10"/>
  <arg name="obstacle_score_threshold" default="0.10"/>
  <arg name="publish_frame_timing" default="false"/>
  <arg name="diagnostics_auto_on_subscribe" default="true"/>
  <arg name="box_center_output_origin" default="legacy_passthrough"/>
  <include file="$(find bevfusion_ros)/launch/base5_trial.launch">
    <arg name="sensor_config" value="$(arg sensor_config)"/>
    <arg name="config" value="$(arg config)"/>
    <arg name="output_objects" value="$(arg output_objects)"/>
    <arg name="vehicle_score_threshold" value="$(arg vehicle_score_threshold)"/>
    <arg name="pedestrian_score_threshold" value="$(arg pedestrian_score_threshold)"/>
    <arg name="obstacle_score_threshold" value="$(arg obstacle_score_threshold)"/>
    <arg name="publish_frame_timing" value="$(arg publish_frame_timing)"/>
    <arg name="diagnostics_auto_on_subscribe" value="$(arg diagnostics_auto_on_subscribe)"/>
    <arg name="box_center_output_origin" value="$(arg box_center_output_origin)"/>
  </include>
</launch>
