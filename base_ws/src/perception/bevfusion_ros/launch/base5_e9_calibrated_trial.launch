<launch>
  <!-- 2026-10-13 E9 개발 비교용 선정값. 최종 Base5 시험 선택은 E24다.
       E9 SHA256: 067205c3f5f5b0abc1bb775116c2b8bca2c9a7f31a0727b959db0ab1ce70b271.
       근거: BASE5_INPUT_POOL_OPTIMIZATION_EVIDENCE 43절.
       동일 E9 서버를 AMP·camera 병렬화 ON, compile OFF로 별도 준비해야 한다.
       이 launch는 서버 시작·가중치 선택·hash 검증을 수행하지 않는다. -->
  <arg name="sensor_config" default="$(find bevfusion_ros)/../../../../configs/sensors/Sensor_4.json"/>
  <arg name="config" default="$(find bevfusion_ros)/../../../../configs/perception/bevfusion_base5_trial.yaml"/>
  <arg name="output_objects" default="/perception/base5_trial/detection/objects"/>
  <arg name="vehicle_score_threshold" default="0.30"/>
  <arg name="pedestrian_score_threshold" default="0.20"/>
  <arg name="obstacle_score_threshold" default="0.12"/>
  <include file="$(find bevfusion_ros)/launch/base5_trial.launch">
    <arg name="sensor_config" value="$(arg sensor_config)"/>
    <arg name="config" value="$(arg config)"/>
    <arg name="output_objects" value="$(arg output_objects)"/>
    <arg name="vehicle_score_threshold" value="$(arg vehicle_score_threshold)"/>
    <arg name="pedestrian_score_threshold" value="$(arg pedestrian_score_threshold)"/>
    <arg name="obstacle_score_threshold" value="$(arg obstacle_score_threshold)"/>
  </include>
</launch>
