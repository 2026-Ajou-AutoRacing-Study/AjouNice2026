<launch>
  <!--
    목적:
      config 파일명과 batch manifest CSV 파일명만 지정해 실제 batch runner를 실행한다.

    사용 예:
      roslaunch trajectory_batch_runner trajectory_batch_runner.launch \
        config_file:=lane_change.yaml \
        manifest_file:=highway_lc_manifest.csv

    동작:
      runner가 scenario 검증, MORAI ScenarioLoad UDP, udp/localization launch,
      trajectory publisher, validator, follower와 완료 확인을 순서대로 담당한다.
  -->

  <!-- config/ 폴더 안의 파일명이다. -->
  <arg name="config_file" default="lane_change.yaml"/>

  <!-- manifests/ 폴더 안의 실행할 CSV 파일명이다. -->
  <arg name="manifest_file" default="highway_lc_manifest.csv"/>

  <node pkg="trajectory_batch_runner"
        type="batch_runner.py"
        name="trajectory_batch_runner"
        output="screen"
        required="true"
        args="--config $(find trajectory_batch_runner)/config/$(arg config_file) --manifest $(find trajectory_batch_runner)/manifests/$(arg manifest_file)"/>
</launch>
