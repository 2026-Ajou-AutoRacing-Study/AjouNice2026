<launch>
  <arg name="start_rqt" default="false"/>
  <arg name="start_control_rviz" default="false"/>
  <node pkg="trajectory_validator" type="trajectory_validator_node.py" name="trajectory_validator" output="screen">
    <rosparam command="load" file="$(find trajectory_validator)/config/trajectory_validator.yaml"/>
  </node>
  <node if="$(arg start_rqt)" pkg="rqt_gui" type="rqt_gui" name="trajectory_validator_history_rqt"
        args="--standalone trajectory_validator/TuningPanel" output="screen"/>
  <node if="$(arg start_control_rviz)" pkg="rviz" type="rviz" name="trajectory_validator_rviz"
        args="-d $(find trajectory_validator)/config/trajectory_validator.rviz" output="screen"/>
</launch>
