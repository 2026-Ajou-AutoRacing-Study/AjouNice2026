<launch>
  <node pkg="trajectory_validator"
        type="trajectory_validator_node.py"
        name="trajectory_validator_recorder"
        output="screen">
    <rosparam command="load"
              file="$(find trajectory_validator)/config/trajectory_validator.yaml"/>
  </node>

  <node pkg="trajectory_validator"
        type="publish_recent_ego_paths.py"
        name="trajectory_recent_ego_overlay"
        output="screen">
    <rosparam command="load"
              file="$(find trajectory_validator)/config/trajectory_validator.yaml"/>
  </node>

</launch>
