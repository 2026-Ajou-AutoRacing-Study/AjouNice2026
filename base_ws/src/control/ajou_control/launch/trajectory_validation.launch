<launch>
  <arg name="mode" default="s_curve" />
  <arg name="target_speed_mps" default="5.0" />
  <arg name="num_points" default="200" />
  <arg name="ds" default="0.5" />
  <arg name="amplitude" default="5.0" />
  <arg name="wavelength" default="40.0" />
  <arg name="radius" default="20.0" />
  <arg name="enable_rviz" default="false" />

  <node pkg="ajou_control" type="virtual_trajectory_generator.py" name="virtual_trajectory_generator" output="screen">
    <param name="mode" value="$(arg mode)" />
    <param name="target_speed_mps" value="$(arg target_speed_mps)" />
    <param name="num_points" value="$(arg num_points)" />
    <param name="ds" value="$(arg ds)" />
    <param name="amplitude" value="$(arg amplitude)" />
    <param name="wavelength" value="$(arg wavelength)" />
    <param name="radius" value="$(arg radius)" />
  </node>

  <group if="$(arg enable_rviz)">
    <node pkg="rviz" type="rviz" name="rviz" output="screen" />
  </group>
</launch>

