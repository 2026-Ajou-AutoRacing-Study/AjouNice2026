<launch>
  <arg name="map_spec_service" default="/Service_MoraiMapSpec" />
  <arg name="ego_topic" default="/Ego_topic" />
  <arg name="gps_topic" default="/sensor/gps" />
  <arg name="marker_topic" default="/morai_map_alignment/markers" />
  <arg name="frame_id" default="map" />
  <arg name="publish_rate" default="5.0" />
  <arg name="use_gps" default="true" />
  <arg name="axis_length" default="30.0" />
  <arg name="enable_rviz" default="false" />

  <node pkg="ajou_control"
        type="morai_map_alignment_checker.py"
        name="morai_map_alignment_checker"
        output="screen">
    <param name="map_spec_service" value="$(arg map_spec_service)" />
    <param name="ego_topic" value="$(arg ego_topic)" />
    <param name="gps_topic" value="$(arg gps_topic)" />
    <param name="marker_topic" value="$(arg marker_topic)" />
    <param name="frame_id" value="$(arg frame_id)" />
    <param name="publish_rate" value="$(arg publish_rate)" />
    <param name="use_gps" value="$(arg use_gps)" />
    <param name="axis_length" value="$(arg axis_length)" />
  </node>

  <group if="$(arg enable_rviz)">
    <node pkg="rviz" type="rviz" name="rviz" output="screen" />
  </group>
</launch>
