<launch>
  <arg name="link_set_path" default="/mnt/c/Users/lenovo/Downloads/link_set.json" />
  <arg name="ego_topic" default="/Ego_topic" />
  <arg name="marker_topic" default="/mgeo_alignment/markers" />
  <arg name="full_centerline_topic" default="/mgeo_alignment/full_centerlines" />
  <arg name="full_lane_edge_topic" default="/mgeo_alignment/full_lane_edges" />
  <arg name="frame_id" default="map" />
  <arg name="publish_rate" default="5.0" />
  <arg name="local_radius" default="80.0" />
  <arg name="point_decimation" default="5" />
  <arg name="static_map_decimation" default="1" />
  <arg name="preview_link_count" default="30" />
  <arg name="show_all_links" default="true" />
  <arg name="show_estimated_lane_edges" default="true" />
  <arg name="publish_map_in_dynamic_markers" default="false" />
  <arg name="default_lane_width" default="3.5" />

  <arg name="offset_x" default="0.0" />
  <arg name="offset_y" default="560.0" />
  <arg name="offset_z" default="-28.5" />
  <arg name="offset_yaw_deg" default="0.0" />

  <arg name="ego_offset_x" default="-134.24" />
  <arg name="ego_offset_y" default="-947.36" />
  <arg name="ego_offset_z" default="-2.38" />

  <arg name="ego_coordinate_mode" default="local" />
  <arg name="ego_plane" default="xy" />
  <arg name="ego_origin_x" default="302595.0" />
  <arg name="ego_origin_y" default="4124145.0" />
  <arg name="ego_origin_z" default="0.0" />

  <arg name="enable_rviz" default="false" />
  <arg name="rviz_config" default="$(find ajou_control)/rviz/mgeo_alignment.rviz" />

  <node pkg="ajou_control"
        type="mgeo_alignment_checker.py"
        name="mgeo_alignment_checker"
        output="screen">
    <param name="link_set_path" value="$(arg link_set_path)" />
    <param name="ego_topic" value="$(arg ego_topic)" />
    <param name="marker_topic" value="$(arg marker_topic)" />
    <param name="full_centerline_topic" value="$(arg full_centerline_topic)" />
    <param name="full_lane_edge_topic" value="$(arg full_lane_edge_topic)" />
    <param name="frame_id" value="$(arg frame_id)" />
    <param name="publish_rate" value="$(arg publish_rate)" />
    <param name="local_radius" value="$(arg local_radius)" />
    <param name="point_decimation" value="$(arg point_decimation)" />
    <param name="static_map_decimation" value="$(arg static_map_decimation)" />
    <param name="preview_link_count" value="$(arg preview_link_count)" />
    <param name="show_all_links" value="$(arg show_all_links)" />
    <param name="show_estimated_lane_edges" value="$(arg show_estimated_lane_edges)" />
    <param name="publish_map_in_dynamic_markers" value="$(arg publish_map_in_dynamic_markers)" />
    <param name="default_lane_width" value="$(arg default_lane_width)" />
    <param name="offset_x" value="$(arg offset_x)" />
    <param name="offset_y" value="$(arg offset_y)" />
    <param name="offset_z" value="$(arg offset_z)" />
    <param name="offset_yaw_deg" value="$(arg offset_yaw_deg)" />
    <param name="ego_offset_x" value="$(arg ego_offset_x)" />
    <param name="ego_offset_y" value="$(arg ego_offset_y)" />
    <param name="ego_offset_z" value="$(arg ego_offset_z)" />
    <param name="ego_coordinate_mode" value="$(arg ego_coordinate_mode)" />
    <param name="ego_plane" value="$(arg ego_plane)" />
    <param name="ego_origin_x" value="$(arg ego_origin_x)" />
    <param name="ego_origin_y" value="$(arg ego_origin_y)" />
    <param name="ego_origin_z" value="$(arg ego_origin_z)" />
  </node>

  <group if="$(arg enable_rviz)">
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(arg rviz_config)" output="screen" />
  </group>
</launch>
