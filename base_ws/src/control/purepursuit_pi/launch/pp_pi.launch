<launch>
  <arg name="config" default="$(find purepursuit_pi)/config/pp_pi.yaml"/>
  <node pkg="purepursuit_pi" type="pp_pi_controller" name="purepursuit_pi" output="screen">
    <param name="config_path" value="$(arg config)"/>
    <rosparam command="load" file="$(arg config)"/>
    <rosparam command="load" file="$(find ioniq5)/config/vehicle.yaml"/>
  </node>
</launch>
