<?xml version="1.0"?>
<package format="2">
  <name>trajectory_generator</name>
  <version>0.1.0</version>
  <description>Generate, store, and publish controller trajectories.</description>

  <maintainer email="ajounice@example.com">AjouNice2026</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>autoware_planning_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>roscpp</depend>
  <depend>roslib</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>python3-pyproj</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export/>
</package>
