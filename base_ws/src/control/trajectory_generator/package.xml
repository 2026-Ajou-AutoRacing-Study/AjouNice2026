<?xml version="1.0"?>
<package format="2">
  <name>trajectory_generator</name>
  <version>0.1.0</version>
  <description>Finite Lanelet CSV reference trajectory generator for the PP pipeline.</description>
  <maintainer email="ajounice@example.com">Ajounice</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>rospy</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>visualization_msgs</build_depend>
  <build_depend>autoware_planning_msgs</build_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>autoware_planning_msgs</exec_depend>
  <exec_depend>ioniq5</exec_depend>
</package>
