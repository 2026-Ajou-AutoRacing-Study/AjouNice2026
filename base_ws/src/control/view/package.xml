<?xml version="1.0"?>
<package format="2">
  <name>viewer</name>
  <version>0.1.0</version>
  <description>Persistent RViz and rqt dashboards for the AjouNice control pipeline.</description>

  <maintainer email="ajounice@example.com">AjouNice2026</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>rqt_plot</exec_depend>
  <exec_depend>plotjuggler</exec_depend>
  <exec_depend>plotjuggler_ros</exec_depend>
  <exec_depend>trajectory_validator</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>lanelet_map_visualizer</exec_depend>
  <exec_depend>ioniq5</exec_depend>

  <export/>
</package>
