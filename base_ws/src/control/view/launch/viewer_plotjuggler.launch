<launch>
  <arg name="config_file"
       default="$(find trajectory_validator)/config/compare_run.yaml"/>
  <node pkg="viewer"
        type="launch_history_plotjuggler.py"
        name="viewer_plotjuggler"
        output="screen"
        required="true">
    <param name="config_file" value="$(arg config_file)"/>
  </node>
</launch>
