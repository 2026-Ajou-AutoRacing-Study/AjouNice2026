<launch>
  <arg name="rviz_config"
       default="$(find trajectory_validator)/config/traj_val_autoware.rviz"/>
  <arg name="software_rendering" default="1"/>
  <arg name="start_map" default="true"/>
  <arg name="map_file"
       default="$(find lanelet_map_visualizer)/../../../kcity_map/lanelet_map/lanelet2_map_v44.osm"/>
  <arg name="projector_file"
       default="$(find lanelet_map_visualizer)/../../../kcity_map/lanelet_map/map_projector_info_v1.yaml"/>

  <group if="$(arg start_map)">
    <include file="$(find lanelet_map_visualizer)/launch/kcity_lanelet_map.launch">
      <arg name="map_file" value="$(arg map_file)"/>
      <arg name="projector_file" value="$(arg projector_file)"/>
      <arg name="frame_id" value="map"/>
      <arg name="output_topic" value="/map/lanelet_map"/>
      <arg name="publish_lanelet_fill" value="false"/>
    </include>
  </group>

  <node pkg="viewer"
        type="current_vehicle_marker.py"
        name="current_vehicle_marker"
        output="screen"/>

  <node pkg="rviz"
        type="rviz"
        name="viewer_rviz"
        args="-d $(arg rviz_config)"
        output="screen">
    <env name="LIBGL_ALWAYS_SOFTWARE" value="$(arg software_rendering)"/>
  </node>
</launch>
