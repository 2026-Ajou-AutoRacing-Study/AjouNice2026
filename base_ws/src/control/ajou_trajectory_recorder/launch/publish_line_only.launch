<launch>
  <rosparam command="load" file="$(find ajou_trajectory_recorder)/config/recorder_params.yaml" />

  <node pkg="ajou_trajectory_recorder"
        type="publish_csv_line_marker.py"
        name="publish_csv_line_marker"
        output="screen">
    <param name="line_width" value="0.8" />
    <param name="z_offset" value="1.0" />
    <param name="local_scale" value="1.0" />
    <param name="publish_rate" value="1.0" />
  </node>
</launch>
