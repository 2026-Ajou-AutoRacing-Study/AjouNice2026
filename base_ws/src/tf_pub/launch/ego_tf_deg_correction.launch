<launch>
  <!--
    Broadcast MORAI /Ego_topic as morai_map -> base_link with a yaw-only
    heading correction. The raw /Ego_topic message is not modified.
  -->
  <arg name="ego_topic" default="/Ego_topic"/>
  <arg name="parent_frame" default="morai_map"/>
  <arg name="child_frame" default="base_link"/>
  <arg name="heading_in_degrees" default="true"/>
  <arg name="heading_yaw_offset_deg" default="-1.347"/>

  <node pkg="tf_pub"
        type="ego_tf_broadcaster_deg_correction"
        name="ego_tf_broadcaster_deg_correction"
        output="screen">
    <param name="ego_topic" value="$(arg ego_topic)"/>
    <param name="parent_frame" value="$(arg parent_frame)"/>
    <param name="child_frame" value="$(arg child_frame)"/>
    <param name="heading_in_degrees" value="$(arg heading_in_degrees)"/>
    <param name="heading_yaw_offset_deg" value="$(arg heading_yaw_offset_deg)"/>
  </node>
</launch>
