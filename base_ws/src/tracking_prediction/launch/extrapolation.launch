<launch>
  <arg name="input_topic" default="/tracking/objects" />
  <arg name="output_topic" default="/tracking/objects_highrate" />
  <!-- 2026-07-31 결정: 판단/제어 요구범위(최소 20, 권장 30~40, 최대 50Hz) 중 권장값.
       docs/tp_final_report.md 4-1절: OD 10Hz 이상이면 이 범위 전체에서 최악gap p95
       오차가 로터리 0.57~0.88m, 하이웨이 0.96~1.62m로 확인됨. -->
  <arg name="target_hz" default="30.0" />
  <!-- 마지막 실측 이후 이 이상 끊기면 그 track은 발행 중단(위험한 무한 외삽 방지) -->
  <arg name="max_extrapolation_gap" default="0.3" />

  <node pkg="tracking_prediction" type="extrapolation_node.py" name="extrapolation_node" output="screen">
    <param name="input_topic" value="$(arg input_topic)" />
    <param name="output_topic" value="$(arg output_topic)" />
    <param name="target_hz" value="$(arg target_hz)" />
    <param name="max_extrapolation_gap" value="$(arg max_extrapolation_gap)" />
  </node>
</launch>
