<launch>
  <!--
    PointPainting 실제 검출 결과 기반 tracking.
    tracking.launch(GT용) 대신 이걸 띄우면, 같은 /tracking/objects 토픽으로
    나가므로 prediction.launch/prediction_node.py는 전혀 안 바꿔도 됨.
  -->
  <arg name="input_topic" default="/pointpainting/detections" />
  <arg name="output_topic" default="/tracking/objects" />

  <node pkg="tracking_prediction" type="pointpainting_tracking_node.py" name="tracking_node" output="screen">
    <param name="input_topic" value="$(arg input_topic)" />
    <param name="output_topic" value="$(arg output_topic)" />
  </node>
</launch>
