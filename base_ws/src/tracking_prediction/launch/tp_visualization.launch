<launch>
  <arg name="tracking_topic" default="/tracking/objects" />
  <arg name="prediction_topic" default="/prediction/objects" />
  <!-- 비어두면 각 메시지의 header.frame_id를 그대로 사용. 필요하면 "lidar1" 등으로 강제 지정 -->
  <arg name="frame_id" default="" />
  <!-- 2026-08-01 최종 결정: 실사용 horizon = 1.5s(entry_zone/highway_ctrv_ctra_summary.md, 미션 무관 단일 고정).
       0이면 prediction_node가 발행하는 horizons 배열 전체 선+구슬을 다 그림(기본값이 [1.5] 하나뿐이라
       지금은 사실상 차이 없음). 특정 값(예: 1.5)을 주면 그 시점 하나만 큰 구슬+라벨로 강조해서 그림 -
       "우리가 쓰기로 한 값"만 깔끔하게 확인용. -->
  <arg name="only_horizon" default="0.0" />

  <node pkg="tracking_prediction" type="visualization_node.py" name="tp_visualization_node" output="screen">
    <param name="tracking_topic" value="$(arg tracking_topic)" />
    <param name="prediction_topic" value="$(arg prediction_topic)" />
    <param name="frame_id" value="$(arg frame_id)" />
    <param name="only_horizon" value="$(arg only_horizon)" />
  </node>
</launch>
