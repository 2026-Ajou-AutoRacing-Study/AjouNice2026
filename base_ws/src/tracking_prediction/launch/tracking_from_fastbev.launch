<launch>
  <!-- Fast-BEV publishes the same detector-neutral box fields through the
       existing PointPaintingDetectionArray wire contract.  Reuse the proven
       nearest-neighbour adapter while keeping a Fast-BEV-specific entrypoint. -->
  <arg name="input_topic" default="/fastbev/detections"/>
  <arg name="output_topic" default="/tracking/objects"/>

  <node pkg="tracking_prediction"
        type="pointpainting_tracking_node.py"
        name="fastbev_tracking_node"
        output="screen">
    <param name="input_topic" value="$(arg input_topic)"/>
    <param name="output_topic" value="$(arg output_topic)"/>
  </node>
</launch>
