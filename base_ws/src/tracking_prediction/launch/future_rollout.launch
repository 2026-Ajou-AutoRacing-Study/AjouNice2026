<launch>
  <arg name="input_topic" default="/app/perc/vis_all_track" />
  <arg name="output_topic" default="/app/perc/predicted_path" />
  <arg name="dt" default="0.1" />
  <arg name="num_steps" default="30" />

  <node pkg="tracking_prediction" type="future_rollout_node.py" name="future_rollout_node" output="screen">
    <param name="input_topic" value="$(arg input_topic)" />
    <param name="output_topic" value="$(arg output_topic)" />
    <param name="dt" value="$(arg dt)" />
    <param name="num_steps" value="$(arg num_steps)" />
  </node>
</launch>
