digraph AjouNicePipelineVertical {
  graph [
    rankdir=TB,
    bgcolor="white",
    pad="0.35",
    nodesep="0.35",
    ranksep="0.62",
    splines=ortho,
    fontname="Noto Sans CJK KR",
    fontsize=32,
    labelloc=t,
    label="AjouNice 환경 인지·측위 파이프라인"
  ];

  node [
    shape=box,
    style="rounded,filled",
    penwidth=2.5,
    margin="0.28,0.18",
    fontname="Noto Sans CJK KR",
    fontsize=27,
    color="#334155",
    fontcolor="#0F172A"
  ];

  edge [
    color="#475569",
    penwidth=3.0,
    arrowsize=1.10
  ];

  A [label="시나리오 자동 생성", fillcolor="#E0F2FE"];
  B [label="다중 카메라·LiDAR 데이터 수집", fillcolor="#E0F2FE"];
  C [label="GT 정합 및 품질 검증", fillcolor="#E0F2FE"];
  D [label="BEVFusion\n3D 객체 탐지", fillcolor="#DBEAFE", color="#2563EB"];
  E [label="EKF\n다중 객체 추적", fillcolor="#EDE9FE", color="#7C3AED"];
  F [label="지도 기반\n미래 궤적 예측", fillcolor="#F3E8FF", color="#9333EA"];
  K [label="판단·제어", fillcolor="#DCFCE7", color="#16A34A", penwidth=3.2];

  S [label="GNSS · IMU\nHeading · Velocity", fillcolor="#FEF3C7", color="#D97706"];
  J [label="Local·Global EKF\n자차 측위", fillcolor="#FFEDD5", color="#EA580C", penwidth=3.2];

  A -> B -> C -> D -> E -> F -> K;
  S -> J [color="#D97706"];
  J -> D [color="#EA580C", style=dashed];
  J -> E [color="#EA580C", style=dashed, constraint=false];
  J -> F [color="#EA580C", style=dashed, constraint=false];
  J -> K [color="#EA580C", constraint=false];
  C -> S [style=invis, weight=10];
}
