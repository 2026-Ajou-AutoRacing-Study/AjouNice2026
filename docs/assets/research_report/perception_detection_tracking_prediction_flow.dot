digraph PerceptionDetectionTrackingPrediction {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.40",
    ranksep="0.72",
    splines=ortho,
    fontname="Noto Sans CJK KR",
    fontsize=31,
    labelloc=t,
    label="객체 탐지·추적·미래 궤적 예측 통합 파이프라인"
  ];

  node [
    shape=box,
    style="rounded,filled",
    penwidth=2.5,
    margin="0.25,0.20",
    fontname="Noto Sans CJK KR",
    fontsize=23,
    color="#334155",
    fontcolor="#0F172A"
  ];

  edge [
    color="#475569",
    penwidth=3.0,
    arrowsize=1.05,
    fontname="Noto Sans CJK KR",
    fontsize=18,
    fontcolor="#334155"
  ];

  camera [
    label="4대 카메라\nRGB 영상",
    fillcolor="#E0F2FE",
    color="#0284C7"
  ];

  lidar [
    label="3D LiDAR\nPoint Cloud",
    fillcolor="#E0F2FE",
    color="#0284C7"
  ];

  calibration [
    label="센서 Calibration\nIntrinsic · Extrinsic",
    fillcolor="#F0F9FF",
    color="#0284C7"
  ];

  detection [
    label="BEVFusion 3D 객체 탐지\n\n출력\nClass · Confidence\n3D 중심 · 크기 · Yaw",
    fillcolor="#DBEAFE",
    color="#2563EB",
    penwidth=3.2
  ];

  classes [
    label="탐지 Class\nVehicle · Pedestrian · Obstacle",
    fillcolor="#EFF6FF",
    color="#2563EB"
  ];

  tracking [
    label="CTRV-EKF 다중 객체 추적\n\n출력\nTrack ID · 위치 · 속도\n이동 방향 · 정지/이동 상태",
    fillcolor="#EDE9FE",
    color="#7C3AED",
    penwidth=3.2
  ];

  prediction [
    label="지도 기반 미래 궤적 예측\n\n출력\n향후 3초 Pose Sequence\n경로 후보 · Confidence",
    fillcolor="#F3E8FF",
    color="#9333EA",
    penwidth=3.2
  ];

  decision [
    label="판단·계획\n차량 추종 · 합류 · 추월\n보행자 충돌 및 장애물 회피",
    fillcolor="#DCFCE7",
    color="#16A34A",
    penwidth=3.2
  ];

  camera -> detection;
  lidar -> detection;
  calibration -> detection;

  classes -> detection [dir=none, color="#2563EB", penwidth=2.3];

  detection -> tracking;
  tracking -> prediction;
  prediction -> decision;

  {rank=same; camera; lidar; calibration;}
  {rank=same; detection; classes;}
}
