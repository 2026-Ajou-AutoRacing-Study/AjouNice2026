digraph BEVFusionFourStage {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.55",
    ranksep="0.75",
    splines=ortho,
    fontname="Noto Sans CJK KR",
    fontsize=31,
    labelloc=t,
    label="BEVFusion 객체 탐지 내부 처리 흐름"
  ];

  node [
    shape=box,
    style="rounded,filled",
    penwidth=2.7,
    margin="0.27,0.21",
    fontname="Noto Sans CJK KR",
    fontsize=23,
    color="#334155",
    fontcolor="#0F172A"
  ];

  edge [
    color="#475569",
    penwidth=3.0,
    arrowsize=1.05,
    fontname="Noto Sans CJK KR",
    fontsize=18,
    fontcolor="#334155"
  ];

  camera [
    label="1. Camera Feature 추출\n\n4-camera RGB\n→ Image Backbone · FPN\n→ View Transformation\n→ Camera BEV Feature",
    fillcolor="#E0F2FE",
    color="#0284C7"
  ];

  lidar [
    label="2. LiDAR Feature 추출\n\nXYZI Point Cloud\n→ Range Filtering · Voxelization\n→ Sparse Encoder\n→ LiDAR BEV Feature",
    fillcolor="#E0F2FE",
    color="#0284C7"
  ];

  fusion [
    label="3. BEV Feature Fusion 및 Detection\n\nCamera BEV + LiDAR BEV\n→ ConvFuser · Shared BEV Encoder\n→ Detection Head\n→ Raw 3D BBox",
    fillcolor="#EDE9FE",
    color="#7C3AED",
    penwidth=3.2
  ];

  post [
    label="4. Detection Post-processing 및 출력\n\nClass별 Confidence Threshold\n→ Range · Class Filtering\n→ Valid 3D Detection\n\n최종 BBox\nClass · Confidence · Center · Size · Yaw",
    fillcolor="#DCFCE7",
    color="#16A34A",
    penwidth=3.2
  ];

  camera -> fusion;
  lidar -> fusion;
  fusion -> post;

  {rank=same; camera; lidar;}
}
