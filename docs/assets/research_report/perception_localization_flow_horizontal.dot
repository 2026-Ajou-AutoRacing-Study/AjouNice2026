digraph AjouNicePipelineHorizontal {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.55",
    ranksep="0.80",
    splines=ortho,
    fontname="Noto Sans CJK KR",
    fontsize=30,
    labelloc=t,
    label="AjouNice 환경 인지·측위 파이프라인"
  ];

  node [
    shape=box,
    style="rounded,filled",
    penwidth=2.4,
    margin="0.24,0.18",
    fontname="Noto Sans CJK KR",
    fontsize=25,
    color="#334155",
    fontcolor="#0F172A"
  ];

  edge [
    color="#475569",
    penwidth=2.8,
    arrowsize=1.05
  ];

  A [label="시나리오\n자동 생성", fillcolor="#E0F2FE"];
  B [label="다중 카메라·LiDAR\n데이터 수집", fillcolor="#E0F2FE"];
  C [label="GT 정합 및\n품질 검증", fillcolor="#E0F2FE"];
  D [label="BEVFusion\n3D 객체 탐지", fillcolor="#DBEAFE", color="#2563EB"];
  E [label="EKF\n다중 객체 추적", fillcolor="#EDE9FE", color="#7C3AED"];
  F [label="지도 기반\n미래 궤적 예측", fillcolor="#F3E8FF", color="#9333EA"];
  K [label="판단·제어", fillcolor="#DCFCE7", color="#16A34A", penwidth=3.0];

  G [label="GNSS", fillcolor="#FEF3C7", color="#D97706"];
  H [label="IMU", fillcolor="#FEF3C7", color="#D97706"];
  I [label="Heading · Velocity", fillcolor="#FEF3C7", color="#D97706"];
  J [label="Local·Global EKF\n자차 측위", fillcolor="#FFEDD5", color="#EA580C", penwidth=3.0];

  A -> B -> C -> D -> E -> F -> K;
  G -> J [color="#D97706"];
  H -> J [color="#D97706"];
  I -> J [color="#D97706"];
  J -> D [color="#EA580C", style=dashed];
  J -> E [color="#EA580C", style=dashed];
  J -> F [color="#EA580C", style=dashed];
  J -> K [color="#EA580C", constraint=false];

  {rank=same; G; H; I;}
}
