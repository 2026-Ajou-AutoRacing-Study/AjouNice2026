# Python cache and local environments
__pycache__/
*.py[cod]
.venv/
.venv-*/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Temporary work and local reports
.cache/
tmp/
temp/
work/
reports/
*.log
*.tmp

# Map/GIS editor backups
*.osm.bak
*.osm~
*.autosave
*.qgs~
*.qgz~

# Experimental route outputs
competition_route/**/attempt*/
competition_route/**/tmp/

# Large map assets are shared through Google Drive.
# Keep their local paths unchanged so ROS launch files and tools work after
# running scripts/map/download_kcity_map_assets.sh.
/drive_assets.sha256
/lanelet_map/*.osm
# v87 is explicitly published to Git for branch-complete deployment.
# The team Drive rejected this release with storageQuotaExceeded.
!/lanelet_map/lanelet2_map_v87.osm
# Current versioned map release.
!/lanelet_map/lanelet2_map_v88.osm
/lanelet_map/*.pcd
/competition_route/v*/
/example_map/
/gis_map/
/mgeo_map/

# MORAI Scenario Runner v1.7.0에 포함된 K-City 2025 참조 MGeo.
# 공식 대회 배포본과 섞지 않고 로컬 제약 생성용으로만 사용한다.
/mgeo_map_scenario_runner_2025/
