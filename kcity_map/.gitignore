# Large map assets are shared through Google Drive.
# Keep their local paths unchanged so ROS launch files and tools work after
# running scripts/map/download_kcity_map_assets.sh.
/drive_assets.sha256
/lanelet_map/*.osm
/lanelet_map/*.pcd
/competition_route/v*/
/example_map/
/gis_map/
/mgeo_map/
