# Local defaults used by docker/bevfusion/compose.yaml. Docker Compose expands
# HOME; change only these two paths when the repository or checkpoint lives
# elsewhere. Do not point production at the nuScenes initialization checkpoint.
AJOUNICE_ROOT=${HOME}/AjouNice2026
BEVFUSION_CHECKPOINT=${HOME}/bevfusion_artifacts/checkpoints/base3_bf0_e10_inference.pth
BEVFUSION_IMAGE=ajounice/bevfusion:dev-cu128
BEVFUSION_PORT=29500
PROJECTION_ONLY=false
INTRINSIC_SOURCE=horizontal_fov
BEVFUSION_USE_AMP=true
BEVFUSION_PREPROCESS_WORKERS=4
BEVFUSION_WARMUP_ITERATIONS=2
