#!/usr/bin/env bash
set -euo pipefail
AJOUNICE_VALIDATOR_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export AJOUNICE_ROOT="$AJOUNICE_VALIDATOR_ROOT"
# Bash `source` inherits this wrapper's positional arguments. Shield catkin setup
# from `--help`/YAML arguments while still exporting the overlay into this shell.
source_validator_workspace() {
  source "$AJOUNICE_VALIDATOR_ROOT/scripts/workspace/source_aw149.sh"
}
source_validator_workspace
exec /usr/bin/python3 "$AJOUNICE_VALIDATOR_ROOT/base_ws/src/planning_addons/planning_scenario_validator/scripts/planning_validator.py" "$@"
